<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <HarborlineReleasedMicrosoftPackageVersion>10.0.10</HarborlineReleasedMicrosoftPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.8.2" Justification="R-0039" />
    <PackageVersion Include="BlazingStory" Version="1.0.0-preview.91" Justification="R-0058" />
    <PackageVersion Include="bunit" Version="2.11.3" Justification="R-0038" />
    <PackageVersion Include="Harborline.UIAdapters.Blazor" Version="$(HarborlinePackedVersion)" Justification="platform" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" Justification="R-0068" />
    <PackageVersion Include="MD2RazorGenerator" Version="1.2.4" Justification="R-0059" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-preview.3.26207.106" Justification="R-0054" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-preview.3.26207.106" Justification="R-0055" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-preview.3.26207.106" Justification="R-0056" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.7.26381.103" Justification="R-0046" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.7.26381.103" Justification="R-0047" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(HarborlineReleasedMicrosoftPackageVersion)" Justification="R-0051" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" Justification="R-0034" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" Justification="R-0036" />
    <PackageVersion Include="xunit" Version="2.9.3" Justification="R-0032" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" Justification="R-0033" />
  </ItemGroup>
</Project>
