.DS_Store

# Agent tooling state. tooling/validate-repository.mjs treats these as prohibited
# source paths, so they must never be committed to this repository.
.claude/
.codex/
.wolf/
harborline-phase4-gate-report.json

# Stryker.NET output (T-720); CI uploads the json report as an artifact.
StrykerOutput/
# StrykerJS (tooling/strykerjs.mjs): sandbox, in-place backups, setup files left by an aborted run, reports.
.stryker-tmp/
stryker-setup-*.js
**/reports/mutation/

# From GitHub's VisualStudio.gitignore (github/gitignore), the file `dotnet new gitignore` writes.
# Only the rules this repository needs: the whole template also matches tracked sources here.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# Visual Studio cache and options
.vs/

# Test results
[Tt]est[Rr]esult*/

# MSBuild binary logs
*.binlog

# Code coverage output
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# Publish output; publish profiles and certificates can carry credentials
publish/
*.pubxml
*.publishsettings
*.pfx

# From GitHub's Node.gitignore (github/gitignore)
npm-debug.log*
pnpm-debug.log*
*.tsbuildinfo
.eslintcache
.env
.env.*
!.env.example
