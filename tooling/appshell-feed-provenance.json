{
  "schemaVersion": 1,
  "_comment": [
    "Provenance for the two cross-repo npm tarballs the app-shell fixture stages",
    "(verify-package-fixtures.mjs, HARBORLINE_CAPABILITY_HOST_TARBALL / HARBORLINE_CONTRACTS_TARBALL).",
    "Metadata only: this repository never stores the bytes (.gitignore excludes *.tgz, and",
    "repository.yaml prohibitedSourceClasses forbids build-output). resolve-appshell-feed.mjs",
    "rebuilds them from these refs on a cache miss and verifies sha256 before use.",
    "npm pack is byte-reproducible for these packages: portable tar (mtimes normalized to",
    "1985-10-26), zeroed gzip MTIME, and per-package lockfiles pinning tsc to 6.0.2."
  ],
  "sourceRepository": {
    "name": "harborline-api",
    "remote": "https://github.com/Harborline-Software/harborline-api.git",
    "localPathEnv": "HARBORLINE_API_REPO"
  },
  "cache": {
    "pathEnv": "HARBORLINE_FEED_CACHE",
    "defaultPath": "~/.harborline/feed-cache"
  },
  "artifacts": [
    {
      "id": "contracts",
      "env": "HARBORLINE_CONTRACTS_TARBALL",
      "packageName": "@harborline-software/api-contracts",
      "tarball": "harborline-software-api-contracts-0.1.0-alpha.1.tgz",
      "packagePath": "packages/contracts",
      "ref": "c618a009e62edb87a2a7d3293bdbf7c060515753",
      "sha256": "8bfccf2b4f98c1a6f0a74efab5bed89f5b80eda607a64bbaabffcbfd9e9e8a25",
      "buildOrder": 0,
      "requiresSiblingBuild": []
    },
    {
      "id": "capability-host",
      "env": "HARBORLINE_CAPABILITY_HOST_TARBALL",
      "packageName": "@harborline-software/capability-host",
      "tarball": "harborline-software-capability-host-0.0.0.tgz",
      "packagePath": "apps/capability-host",
      "ref": "c618a009e62edb87a2a7d3293bdbf7c060515753",
      "sha256": "bbb44ca470783359b5bea9e242262c38a8376c536c6fe8571fa0328bfadc68f4",
      "buildOrder": 1,
      "requiresSiblingBuild": [
        "contracts"
      ]
    }
  ]
}
