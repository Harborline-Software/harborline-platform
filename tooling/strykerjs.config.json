{
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "inPlace": true,
  "testFiles": [
    "**/!(*.performance).test.{ts,tsx,mts,js,mjs}"
  ],
  "reporters": [
    "json",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  }
}
