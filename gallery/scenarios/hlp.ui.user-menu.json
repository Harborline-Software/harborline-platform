            "react": "<UserMenu identity={{name:'Ordnance Survey — Niño Ångström',email:'1,284,905',role:'Bay 4 <grid C-7> & 8'}} items={[{id:'long',kind:'action',label:'Awaiting third-party structural certification review',onActivate(){}},{id:'number',kind:'action',label:'1,284,905',onActivate(){}},{id:'hostile',kind:'action',label:'Bay 4 <grid C-7> & 8',onActivate(){}},{id:'name',kind:'action',label:'Ordnance Survey — Niño Ångström',onActivate(){}}]} labels={{trigger:name=>`Account for ${name}`,panel:'Content resilience account',signOut:'Sign out'}} />",
