      "content": {
        "blurb": "The latest child set, caller attribute, class, and scroll-host reference remain intact.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {
          "ariaLabel": "Structure inspection results",
          "className": "gallery-scroll-affordance",
          "data-owner": "app",
          "fadeSize": 24,
          "itemCount": 7,
          "snap": false
        },
        "state": {
          "revision": {
            "kind": "counter",
            "initial": 1
          },
          "hostStatus": {
            "kind": "string",
            "initial": "connected"
          }
        },
        "body": [
          {
            "control": "raw",
            "react": "<ScrollAffordance ref={regionRef} ariaLabel=\"Structure inspection results\" className=\"gallery-scroll-affordance\" data-owner=\"app\" fadeSize={24} itemCount={revision === 1 ? 7 : 4}><Tiles count={revision === 1 ? 7 : 4} revision={revision} /></ScrollAffordance>\n<button type=\"button\" onClick={() => setRevision(current => current === 1 ? 96 : 1)}>Replace children</button>\n<output aria-live=\"polite\">Revision {revision}; host ref {regionRef.current ? 'connected' : 'pending'}.</output>",
            "blazor": "<HarborlineScrollAffordance @ref=\"Region\" AriaLabel=\"Structure inspection results\" Class=\"gallery-scroll-affordance\" data-owner=\"app\" FadeSize=\"24\" ItemCount=\"@Count\">@Tiles(Count, revision)</HarborlineScrollAffordance>\n<button type=\"button\" @onclick=\"ReplaceChildren\">Replace children</button>\n<output aria-live=\"polite\">Revision @revision; host ref @(Region is null ? \"pending\" : \"connected\").</output>",
            "rationale": "Both lanes combine a ref-bearing component, computed article tiles, a 1/96 revision toggle that changes the count from seven to four, and conditional ref status; the closed controls cannot express those computations or article structure."
          }
        ],
        "footer": []
      }
