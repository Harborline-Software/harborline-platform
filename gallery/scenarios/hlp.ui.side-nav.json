    {
      "id": "side-nav.replacement",
      "name": "Complete model replacement",
      "surface": "replacement",
      "sourceCaseIds": [
        "side-nav.host-class",
        "side-nav.replacement"
      ],
      "content": {
        "blurb": "The newest groups, active identity, labels, and callbacks replace the previous model without stale rows.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "state": {
          "revision": {
            "kind": "counter",
            "initial": 1
          },
          "activeId": {
            "kind": "string",
            "initial": "calendar"
          },
          "lastActivation": {
            "kind": "string",
            "initial": "none"
          }
        },
        "body": [
          {
            "control": "raw",
            "react": "] : [{ id: 'spatial', label: label('Spatial workspace', 'مساحة العمل المكانية'), items: [{ id: 'capture', label: label('Photo with pose', 'صورة مع الوضعية'), icon: icon('◎'), badge: <span>96</span> }, { id: 'blueprints', label: label('Blueprint placement', 'موضع المخطط'), icon: icon('▤') }] }]; <SideNav activeItemId={activeId} className=\"gallery-side-nav\" collapsed={collapsed} items={items} onItemActivate={(item: ActivatedItem) => { setActiveId(item.id); setLastActivation(item.label) }} />; <button type=\"button\" onClick={() => { setRevision(current => current === 1 ? 96 : 1); setActiveId('capture') }}>Replace navigation model</button>",
            "blazor": "private IReadOnlyList<SideNavNavigationGroup> Groups => [new(\"operations\", [new(\"overview\", L(\"Overview\", \"نظرة عامة\"), Icon(\"⌂\"), Href: \"#overview\", TrailingContent: Badge(L(\"New\", \"جديد\"))), new(\"calendar\", L(\"Schedule\", \"الجدول\"), Icon(\"▦\"), TrailingContent: Badge(\"3\")), new(\"assets\", L(\"Structures\", \"الهياكل\"), Icon(\"◇\"), Children: [new(\"asset-map\", L(\"Structure map\", \"خريطة الهيكل\"), Icon(\"⌖\")), new(\"asset-archive\", L(\"Archived structures\", \"الهياكل المؤرشفة\"), Icon(\"□\"), Disabled: true)])], L(\"Operations\", \"العمليات\")), new(\"administration\", [new(\"team\", L(\"Team access\", \"وصول الفريق\"), Icon(\"◉\"))], L(\"Administration\", \"الإدارة\"))]; <HarborlineSideNav Groups=\"@Groups\" ActiveItemId=\"@active\" Collapsed=\"@Collapsed\" ItemActivated=\"Activate\" NavigationLabel=\"@NavigationLabel\" />",
            "rationale": "The closed vocabulary cannot express either recursive navigation model or React's revision-dependent complete array replacement; Blazor has no replacement branch and continues to render its base Groups model."
          },
          {
            "control": "output",
            "live": "polite",
            "text": "Last activation: {lastActivation}"
          }
        ],
        "footer": [
          {
            "control": "button",
            "text": "Replace navigation model",
            "action": "replace"
          }
        ],
        "inherits": "side-nav.structure-active"
      }
