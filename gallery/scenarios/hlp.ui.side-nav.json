    {
      "id": "side-nav.content",
      "name": "Content resilience",
      "surface": "long-content",
      "sourceCaseIds": [
        "side-nav.groups-recursion",
        "side-nav.activate"
      ],
      "sourceQualityCaseIds": [],
      "content": {
        "blurb": "Hostile navigation content carries a long item label, a grouped large number, escaped angle brackets and an ampersand, and a name with diacritics and an em dash.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {},
        "state": {},
        "body": [
          {
            "control": "raw",
            "react": "const items = [{id:'content',label:'Content resilience',items:[{id:'long',label:'Awaiting third-party structural certification review'},{id:'number',label:'1,284,905'},{id:'hostile',label:'Bay 4 <grid C-7> & 8'},{id:'name',label:'Ordnance Survey — Niño Ångström'}]}];\n<SideNav items={items} activeItemId=\"long\" navigationLabel=\"Content resilience navigation\" />",
            "blazor": "<HarborlineSideNav Groups=\"@ContentGroups\" ActiveItemId=\"long\" NavigationLabel=\"Content resilience navigation\" />\n@code { private IReadOnlyList<SideNavNavigationGroup> ContentGroups => [new(\"content\", [new(\"long\", \"Awaiting third-party structural certification review\"), new(\"number\", \"1,284,905\"), new(\"hostile\", \"Bay 4 <grid C-7> & 8\"), new(\"name\", \"Ordnance Survey — Niño Ångström\")], \"Content resilience\")]; }",
            "rationale": "The closed descriptor vocabulary cannot express a side-navigation group whose real item collection carries hostile-but-valid text."
