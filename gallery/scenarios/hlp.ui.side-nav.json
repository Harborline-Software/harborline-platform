  "scenarios": [
    {
      "id": "side-nav.structure-active",
      "name": "Groups, links, and active route",
      "surface": "structure-active",
      "sourceCaseIds": [
        "side-nav.defaults",
        "side-nav.groups-recursion",
        "side-nav.active",
        "side-nav.href"
      ],
      "sourceQualityCaseIds": [
        "side-nav.quality.landmark-state"
      ],
      "content": {
        "blurb": "Ordered groups and recursive items expose one current leaf without owning the route table.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {
          "activeItemId": "calendar",
          "className": "gallery-side-nav",
          "collapsed": false,
          "items": [
            {
              "id": "operations",
              "label": "Operations",
              "items": [
                {
                  "id": "overview",
                  "label": "Overview",
                  "icon": "⌂",
                  "badge": "New",
                  "href": "#overview"
                },
                {
                  "id": "calendar",
                  "label": "Schedule",
                  "icon": "▦",
                  "badge": "3"
                },
                {
                  "id": "assets",
                  "label": "Structures",
                  "icon": "◇",
                  "children": [
                    {
                      "id": "asset-map",
                      "label": "Structure map",
                      "icon": "⌖"
                    },
                    {
                      "id": "asset-archive",
                      "label": "Archived structures",
                      "icon": "□",
                      "disabled": true
                    }
                  ]
                }
              ]
            },
            {
              "id": "administration",
              "label": "Administration",
              "items": [
                {
                  "id": "team",
                  "label": "Team access",
                  "icon": "◉"
                }
              ]
            }
          ]
        },
        "state": {
          "activeId": {
            "kind": "string",
            "initial": "calendar"
          },
          "lastActivation": {
            "kind": "string",
            "initial": "none"
          }
        },
        "body": [
          {
            "control": "raw",
            "react": "<SideNav activeItemId={activeId} className=\"gallery-side-nav\" collapsed={collapsed} items={items} onItemActivate={(item) => { setActiveId(item.id); setLastActivation(item.label) }} />",
            "blazor": "<HarborlineSideNav Groups=\"@Groups\" ActiveItemId=\"@active\" Collapsed=\"@Collapsed\" ItemActivated=\"Activate\" NavigationLabel=\"@NavigationLabel\" />",
            "rationale": "The closed descriptor vocabulary has no navigation landmark, recursive group/item, disclosure, icon, badge, active-item, disabled-item, or link-target control, so the SideNav structure and activation wiring cannot be expressed without lane-native markup."
          },
          {
            "control": "output",
            "live": "polite",
            "text": "Last activation: {lastActivation}"
          }
        ],
        "footer": []
      }
    },
