        "blurb": "Carries a long certification label, the grouped value 1,284,905, escaped Bay 4 <grid C-7> & 8 copy, and the name Ordnance Survey — Niño Ångström.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {},
        "state": {},
        "body": [
          {
            "control": "raw",
            "react": "<><FormField name=\"certification-count\" label={'Awaiting third-party structural certification review'} hint={'1,284,905'}><NumberField name=\"certification-count\" value={1284905} onChange={()=>{}} /></FormField><FormField name=\"survey-count\" label={'Ordnance Survey — Niño Ångström'} error={'Bay 4 <grid C-7> & 8'}><NumberField name=\"survey-count\" value={8} onChange={()=>{}} /></FormField></>",
            "blazor": "<HarborlineFormField Name=\"certification-count\" Label=\"@(\"Awaiting third-party structural certification review\")\" Hint=\"@(\"1,284,905\")\"><HarborlineNumberField Name=\"certification-count\" Value=\"1284905\" /></HarborlineFormField><HarborlineFormField Name=\"survey-count\" Label=\"@(\"Ordnance Survey — Niño Ångström\")\" Error=\"@(\"Bay 4 <grid C-7> & 8\")\"><HarborlineNumberField Name=\"survey-count\" Value=\"8\" /></HarborlineFormField>",
            "rationale": "The closed control vocabulary cannot express FormField-wrapped NumberField controls with hostile-but-valid labels, hints, and errors."
          }
        ],
        "footer": []
      }
