            "react": "<><FormField name=\"certification-time\" label={'Awaiting third-party structural certification review'} hint={'1,284,905'}><DateTimeField name=\"certification-time\" value=\"2026-08-09T14:30\" onChange={()=>{}} /></FormField><FormField name=\"survey-time\" label={'Ordnance Survey — Niño Ångström'} error={'Bay 4 <grid C-7> & 8'}><DateTimeField name=\"survey-time\" value=\"2026-08-09T15:30\" onChange={()=>{}} /></FormField></>",
