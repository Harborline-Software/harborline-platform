      "content": {
        "inherits": "app-shell.structure",
        "blurb": "Opening every declared tool preserves order without eviction; sheets dock without replacing their body, and the content floor moves newest panels back to sheets first.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {
          "shellId": "operations",
          "workspace": "Operations",
          "groups": [
            "Portfolio",
            "Work"
          ],
          "actions": [
            {
              "id": "notifications",
              "label": "Notifications",
              "overflow": true
            },
            {
              "id": "pilot",
              "label": "Open Pilot",
              "overflow": true
            },
            {
              "id": "profile",
              "label": "Profile",
              "overflow": false
            }
          ],
          "shortcuts": {
            "toggleNavigation": "Mod+B",
            "openSearch": "Mod+K"
          },
          "openPanelIds": [
            "notifications",
            "pilot",
            "documents",
            "reports",
            "runs",
            "inspector"
          ],
          "spread": false,
          "spreadUnavailable": false,
          "minimumPaneWidth": 300,
          "panelChrome": {
            "headerHeight": 33,
            "forms": {
              "title": [
                "notifications",
                "pilot",
                "runs",
                "inspector"
              ],
              "toggle-chip": [
                "documents",
                "reports"
              ]
            },
            "earnsOverflow": [
              "pilot",
              "documents",
              "reports"
            ],
            "declaresPopOut": [
              "pilot",
              "documents",
              "reports"
            ],
            "affordanceOrder": [
              "overflow",
              "pop-out",
              "expand",
              "close"
            ],
            "sheetAffordances": [
              "close"
            ],
            "slotOrder": [
              "header",
              "toolbar",
              "body",
              "footer"
            ]
          }
        },
        "state": {
          "spread": {
            "kind": "flag",
            "initial": false
          }
        },
        "body": [
          {
            "control": "raw",
            "react": "panelContent={panel => <section>{panel.id}</section>}",
            "blazor": "PanelContent renders the same panel declaration body",
            "rationale": "Each declared panel receives one opaque body slot while the shell owns ordered splitter placement."
          },
          {
            "control": "raw",
            "react": "panelToolbar={panel => <span>{panel.id} toolbar</span>} onPanelPopOut={request => host.popOut(request)}",
            "blazor": "PanelToolbar renders the same row and PanelPoppedOut carries the same request",
            "rationale": "chrome-spec 6: the header is the shell's in both earned forms, the toolbar and footer belong to the body, and pop out is a declared action the host confirms - the shell never opens a window."
          }
        ],
        "footer": []
      }
