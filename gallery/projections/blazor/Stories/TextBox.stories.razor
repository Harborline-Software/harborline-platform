@attribute [Stories("Platform/Text Box")]
<Stories TComponent="TextBoxScenario">@foreach(var item in Items){<Story Name="@item.Name"><Arguments><Arg For="_ => _.ScenarioId" Value="@item.Id" /></Arguments><Template><TextBoxScenario @attributes="context.Args" /></Template></Story>}<Story Name="Content resilience"><Arguments><Arg For="_ => _.ScenarioId" Value='"text-box.content"'/></Arguments><Template><TextBoxScenario @attributes="context.Args"/></Template></Story><Story Name="Error state"><Arguments><Arg For="_ => _.ScenarioId" Value='"text-box.error-state"'/></Arguments><Template><TextBoxScenario @attributes="context.Args"/></Template></Story></Stories>
@code { private static readonly (string Id,string Name)[] Items=[("text-box.ownership-form","Value ownership and form state"),("text-box.clear-reveal","Clear, reveal, and composed actions"),("text-box.attributes-keyboard","Input attributes and keyboard handler"),("text-box.appearance-reflow","Appearance and narrow reflow"),("text-box.replacement","Complete controlled replacement"),("text-box.locale-pseudo","Pseudo-localized actions"),("text-box.locale-ar","Arabic right-to-left editor"),("text-box.theme-light","Light theme"),("text-box.theme-dark","Dark theme")]; }
