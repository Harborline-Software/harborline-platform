<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId">
  <header class="hl-gallery-heading"><h2>@Copy.Title</h2><p>@Copy.Description</p></header>
  <div class="hl-gallery-stage">
    <HarborlineLocaleProvider Catalog="@Catalog" Direction="@Direction" Locale="@Locale">
      <div class="hl-gallery-feedback-stack" style="min-block-size:420px">
        <button type="button" @onclick="@(() => open = true)">Open confirmation</button>
        <output aria-live="polite">Confirms: @confirms · Open-change requests: @requests</output>
        @if (ScenarioId == "confirm-dialog.content")
        {
        <HarborlineConfirmDialog Open="@open" OpenChanged="SetOpen" OnConfirm="Confirm"
                               Title="@ContentTitle"
                               Description="@ContentDescription"
                               CancelLabel="@ContentCancelLabel"
                               ConfirmLabel="@ContentConfirmLabel" />
        }
        else
        {
        <HarborlineConfirmDialog Open="@open" OpenChanged="SetOpen" OnConfirm="Confirm"
                               Title="@DialogTitle" Description="@DialogDescription"
                               ConfirmLabel="@ConfirmLabel" Variant="@Variant"
                               CloseOnOverlayClick="@(!DismissalSuppressed)"
                               CloseOnEscape="@(!DismissalSuppressed)" />
        }
      </div>
    </HarborlineLocaleProvider>
  </div>
</section>

@code {
  [Parameter, EditorRequired] public string ScenarioId { get; set; } = "confirm-dialog.action-pair";

  private bool open = true;
  private int confirms;
  private int requests;

  private bool IsArabic => ScenarioId == "confirm-dialog.reflow-rtl";
  private bool IsDestructive => ScenarioId == "confirm-dialog.destructive";
  private bool LabelsEcho => ScenarioId == "confirm-dialog.labels";
  private bool DismissalSuppressed => ScenarioId == "confirm-dialog.dismissal";
  private const string ContentTitle = "Awaiting third-party structural certification review";
  private const string ContentDescription = "Bay 4 <grid C-7> & 8";
  private const string ContentCancelLabel = "1,284,905";
  private const string ContentConfirmLabel = "Ordnance Survey — Niño Ångström";
  private string Locale => IsArabic ? "ar-SA" : "en-US";
  private string Direction => IsArabic ? "rtl" : "ltr";
  private ConfirmDialogVariant Variant => IsDestructive ? ConfirmDialogVariant.Destructive : ConfirmDialogVariant.Default;
  private string DialogTitle => IsArabic ? "حذف الهيكل نهائيًا؟" : IsDestructive ? "Delete this structure permanently?" : "Discard unsaved changes?";
  private string DialogDescription => IsArabic
    ? "لا يمكن التراجع عن هذا الإجراء بعد التأكيد."
    : "This action cannot be undone once confirmed.";
  private string? ConfirmLabel => IsDestructive
    ? "Permanently delete this structure and every captured pose attached to it"
    : null;
  private IReadOnlyDictionary<string, string> Catalog => IsArabic ? ArabicCatalog : LabelsEcho ? EchoCatalog : EmptyCatalog;

  private static readonly IReadOnlyDictionary<string, string> EmptyCatalog = new Dictionary<string, string>();
  private static readonly IReadOnlyDictionary<string, string> EchoCatalog = new Dictionary<string, string>
  {
    ["common.confirm"] = "common.confirm",
    ["common.cancel"] = "common.cancel",
  };
  private static readonly IReadOnlyDictionary<string, string> ArabicCatalog = new Dictionary<string, string>
  {
    ["common.confirm"] = "تأكيد",
    ["common.cancel"] = "إلغاء",
  };
  private static readonly IReadOnlyDictionary<string, (string Title, string Description)> CopyByScenario =
    new Dictionary<string, (string, string)>
    {
      ["confirm-dialog.action-pair"] = ("Action pair and confirm ordering", "Cancel precedes confirm; confirming invokes the caller once and then requests closure."),
      ["confirm-dialog.labels"] = ("Localized and overridden labels", "Both actions resolve from the catalog, and raw echoed keys fall back to readable defaults."),
      ["confirm-dialog.destructive"] = ("Destructive emphasis", "The destructive variant changes emphasis only — order and semantics are unchanged."),
      ["confirm-dialog.reflow-rtl"] = ("Long content reflow and RTL mirroring", "Expanded confirmation copy wraps, and the action pair mirrors under Arabic."),
      ["confirm-dialog.dismissal"] = ("Dismissal policy passthrough", "Overlay and Escape dismissal are suppressed by policy passed to the composed shell."),
      ["confirm-dialog.content"] = ("Content resilience", "Hostile-but-valid copy remains text across the confirmation title, description, and action labels."),
    };
  private (string Title, string Description) Copy => CopyByScenario[ScenarioId];

  private void SetOpen(bool next) { requests++; open = next; }
  private void Confirm() => confirms++;
}
