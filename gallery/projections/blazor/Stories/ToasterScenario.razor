@inject IToastService Toasts

<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction">
  <header class="hl-gallery-heading"><h2>@Copy.Title</h2><p>@Copy.Description</p></header>
  <div class="hl-gallery-stage hl-gallery-feedback-stack">
    <HarborlineLocaleProvider Locale="@Locale">
      <div style="display: flex; gap: 8px; flex-wrap: wrap">
        <button type="button" @onclick="Seed">@ShowLabel</button>
        <button type="button" @onclick="() => Toasts.Dismiss()">@DismissAllLabel</button>
        @if (ScenarioId == "toaster.positions")
        {
          @foreach (var candidate in Positions)
          {
            <button type="button" @onclick="() => position = candidate">@candidate</button>
          }
        }
      </div>
      <HarborlineToaster Position="@position" DurationMilliseconds="@((int?)null)" MaximumVisible="@MaximumVisible"
                        ShowCloseButton="@(ScenarioId == "toaster.queue-lifecycle")" KeepErrorsPersistent DismissLabel="@DismissLabel"
                        AccessibleLabel="@NotificationsLabel" Direction="@Direction" />
    </HarborlineLocaleProvider>
  </div>
</section>

@code {
  [Parameter, EditorRequired] public string ScenarioId { get; set; } = "toaster.variants-roles";
  private string? seededScenario;
  private ToastPosition position = ToastPosition.BottomRight;
  private static readonly ToastPosition[] Positions = [ToastPosition.TopLeft, ToastPosition.TopCenter, ToastPosition.TopRight, ToastPosition.BottomLeft, ToastPosition.BottomCenter, ToastPosition.BottomRight];

  protected override void OnAfterRender(bool firstRender)
  {
    if (seededScenario == ScenarioId) return;
    seededScenario = ScenarioId;
    Seed();
  }

  private void Seed()
  {
    Toasts.Clear();
    if (ScenarioId == "toaster.content")
    {
      Toasts.Show("Awaiting third-party structural certification review");
      Toasts.Success("1,284,905");
      Toasts.Error("Bay 4 <grid C-7> & 8");
      Toasts.Information("Ordnance Survey — Niño Ångström");
      return;
    }
    if (ScenarioId == "toaster.error-state")
    {
      Toasts.Error("Unable to save changes");
      return;
    }
    if (ScenarioId == "toaster.action-promise")
    {
      Toasts.Show(Message("Blueprint placement needs review"), new ToastOptions(Description: Message("Bay 4, grid C-7"), Action: new ToastAction(IsArabic ? "إعادة المحاولة" : "Retry", () => Task.CompletedTask)));
      _ = Toasts.TrackAsync(Task.FromResult("indexed"), Message("Indexing blueprint"), _ => Message("Blueprint indexed"), _ => Message("Indexing failed"));
      return;
    }
    if (ScenarioId == "toaster.queue-lifecycle")
    {
      Toasts.Show(Message("Capture queued"));
      Toasts.Success(Message("Pose saved"));
      Toasts.Error(Message("Placement failed"), new ToastOptions(Description: Message("Select a different blueprint region")));
      Toasts.Loading(Message("Recalculating orientation"));
      return;
    }
    Toasts.Show(Message("Capture ready"));
    Toasts.Success(Message("Pose saved"));
    Toasts.Error(Message("Placement failed"));
    Toasts.Warning(Message("Blueprint scale is unverified"));
    Toasts.Information(Message("Three collaborators are viewing"));
    Toasts.Loading(Message("Calculating orientation"));
  }

  private (string Title, string Description) Copy => ScenarioId switch
  {
    "toaster.variants-roles" => ("Variants and live-region roles", "Error uses alert while every other variant uses status without redundant live-region metadata."),
    "toaster.queue-lifecycle" => ("Queue, timing, and dismissal", "Newest entries remain visible while persistence, close policy, and bounded dismissal remain deterministic."),
    "toaster.action-promise" => ("Action and tracked operation", "Actions invoke once without closing and one identity transitions from loading to its result."),
    "toaster.positions" => ("Physical positions", "Six source-compatible physical positions remain distinct while motion follows logical direction."),
    "toaster.locale-en" => ("English locale", "Caller messages and a localized dismiss label remain separate."),
    "toaster.locale-pseudo" => ("Pseudo locale", "Expanded messages, descriptions, and actions remain viewport-clamped."),
    "toaster.locale-ar" => ("Arabic locale", "Physical placement is retained while entry and exit motion mirror."),
    "toaster.theme-light" => ("Light theme", "Every toast variant uses public light-theme tokens."),
    "toaster.theme-dark" => ("Dark theme", "The same host-scoped queue on the Harborline dark surface."),
    "toaster.content" => ("Content resilience", "A dense queue preserves hostile-but-valid messages as text."),
    "toaster.error-state" => ("Error state", "A failed save is announced as an error alert."),
    _ => ("Toaster", "Host-scoped notifications.")
  };

  private bool IsArabic => ScenarioId == "toaster.locale-ar";
  private bool IsPseudo => ScenarioId == "toaster.locale-pseudo";
  private string Locale => IsArabic ? "ar-SA" : IsPseudo ? "en-XA" : "en-US";
  private string Direction => IsArabic ? "rtl" : "ltr";
  private string? Theme => ScenarioId switch { "toaster.theme-light" => "light", "toaster.theme-dark" => "dark", _ => null };
  private int MaximumVisible => ScenarioId == "toaster.queue-lifecycle" ? 2 : 6;
  private string ShowLabel => IsArabic ? "إظهار الإشعارات" : IsPseudo ? "⟦ Šhøŵ ţøåšţš ··· ⟧" : "Show toasts";
  private string DismissAllLabel => IsArabic ? "إغلاق الكل" : "Dismiss all";
  private string DismissLabel => IsArabic ? "إغلاق الإشعار" : IsPseudo ? "⟦ Đîšmîšš ñøţîƒîçåţîøñ ···· ⟧" : "Dismiss notification";
  private string NotificationsLabel => IsArabic ? "الإشعارات" : IsPseudo ? "⟦ Ñøţîƒîçåţîøñš ···· ⟧" : "Notifications";
  private string Message(string value) => IsArabic ? $"تم {value}" : IsPseudo ? $"⟦ {value} ······ ⟧" : value;
}
