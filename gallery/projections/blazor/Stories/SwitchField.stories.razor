@code { private static readonly (string Id,string Name)[] Items=[("switch-field.controlled-form","Controlled form compatibility"),("switch-field.activation-states","Activation and validation states"),("switch-field.appearance-replacement","Appearance and replacement"),("switch-field.locale-pseudo","Pseudo-localized compatibility"),("switch-field.locale-ar","Arabic right-to-left switch"),("switch-field.theme-light","Light theme"),("switch-field.theme-dark","Dark theme"),("switch-field.content","Content resilience")]; }
