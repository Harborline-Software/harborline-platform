@attribute [Stories("UI/ConfirmDialog")]

<Stories TComponent="ConfirmDialogScenario" Layout="@typeof(NoMarginLayout)">
  <Story Name="Action pair and confirm ordering">
    <Arguments><Arg For="_ => _.ScenarioId" Value='"confirm-dialog.action-pair"' /></Arguments>
    <Template><ConfirmDialogScenario @attributes="context.Args" /></Template>
  </Story>
  <Story Name="Localized and overridden labels">
    <Arguments><Arg For="_ => _.ScenarioId" Value='"confirm-dialog.labels"' /></Arguments>
    <Template><ConfirmDialogScenario @attributes="context.Args" /></Template>
  </Story>
  <Story Name="Destructive emphasis">
    <Arguments><Arg For="_ => _.ScenarioId" Value='"confirm-dialog.destructive"' /></Arguments>
    <Template><ConfirmDialogScenario @attributes="context.Args" /></Template>
  </Story>
  <Story Name="Long content reflow and RTL mirroring">
    <Arguments><Arg For="_ => _.ScenarioId" Value='"confirm-dialog.reflow-rtl"' /></Arguments>
    <Template><ConfirmDialogScenario @attributes="context.Args" /></Template>
  </Story>
  <Story Name="Dismissal policy passthrough">
    <Arguments><Arg For="_ => _.ScenarioId" Value='"confirm-dialog.dismissal"' /></Arguments>
    <Template><ConfirmDialogScenario @attributes="context.Args" /></Template>
  </Story>
  <Story Name="Content resilience"><Arguments><Arg For="_ => _.ScenarioId" Value='"confirm-dialog.content"'/></Arguments><Template><ConfirmDialogScenario @attributes="context.Args"/></Template></Story>
</Stories>
