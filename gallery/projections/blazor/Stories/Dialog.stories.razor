@attribute [Stories("Platform/Dialog")]
<Stories TComponent="DialogScenario" Layout="@typeof(NoMarginLayout)">@foreach(var item in Items){<Story Name="@item.Name"><Arguments><Arg For="_ => _.ScenarioId" Value="@item.Id" /></Arguments><Template><DialogScenario @attributes="context.Args" /></Template></Story>}</Stories>
@code { private static readonly (string Id,string Name)[] Items=[("dialog.lifecycle-content","Controlled lifecycle and content"),("dialog.dismissal-focus","Dismissal and focus lifecycle"),("dialog.independent-dismissal","Independent dismissal controls"),("dialog.scroll-reflow","Scrollable body and narrow reflow"),("dialog.replacement","Complete controlled replacement"),("dialog.locale-pseudo","Pseudo-localized modal"),("dialog.locale-ar","Arabic right-to-left modal"),("dialog.theme-light","Light theme"),("dialog.theme-dark","Dark theme"),("dialog.content","Content resilience")]; }
