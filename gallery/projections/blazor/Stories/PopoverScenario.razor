<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>@Title</h2><p>Placement, dismissal, and focus lifecycle remain equivalent.</p></header><div class="hl-gallery-stage">@if(ScenarioId=="popover.content"){<HarborlinePopover DefaultOpen="true"><HarborlinePopoverTrigger>@("Awaiting third-party structural certification review")</HarborlinePopoverTrigger><HarborlinePopoverContent AccessibleLabel="Ordnance Survey — Niño Ångström" Side="PopoverSide.Bottom" Align="PopoverAlign.Start"><strong>@("Ordnance Survey — Niño Ångström")</strong><p>@("Bay 4 <grid C-7> & 8")</p><p>1,284,905</p><HarborlinePopoverClose>Close</HarborlinePopoverClose></HarborlinePopoverContent></HarborlinePopover>}else{<HarborlinePopover DefaultOpen="true"><HarborlinePopoverTrigger>Open details</HarborlinePopoverTrigger><HarborlinePopoverContent AccessibleLabel="Invoice details" Side="PopoverSide.Bottom" Align="PopoverAlign.Start"><strong>@(Rtl ? "تفاصيل الفاتورة" : "Invoice details")</strong><p>@(Rtl ? "مستحق خلال ثلاثين يوماً" : "Due in thirty days")</p><HarborlinePopoverClose>Close</HarborlinePopoverClose></HarborlinePopoverContent></HarborlinePopover>}</div></section>
@code { [Parameter, EditorRequired] public string ScenarioId { get; set; } = "popover.defaults"; private bool Rtl => ScenarioId == "popover.rtl-theme"; private string Title => ScenarioId == "popover.content" ? "Content resilience" : ScenarioId == "popover.dismissal" ? "Dismissal and focus" : Rtl ? "RTL and theme" : "Trigger placement"; private string? Theme => Rtl ? "dark" : null; private string? Direction => Rtl ? "rtl" : null; }
