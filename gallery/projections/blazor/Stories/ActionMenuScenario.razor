<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>@(Direction=="rtl"?"إجراءات":"Actions")</h2></header><div class="hl-gallery-stage hl-gallery-menu-stage" style="justify-content:flex-end;min-height:190px">@if(ScenarioId=="action-menu.empty"){<HarborlineActionMenu ScopeId="@ScenarioId" Items="EmptyItems" AccessibleLabel="More actions" />}else @if(ScenarioId=="action-menu.content"){<HarborlineActionMenu ScopeId="@ScenarioId" Items="ContentItems" AccessibleLabel="Awaiting third-party structural certification review"><Trigger>@("Awaiting third-party structural certification review")</Trigger></HarborlineActionMenu>}else{<HarborlineActionMenu ScopeId="@ScenarioId" Items="Items" AccessibleLabel="@(Direction=="rtl"?"المزيد من الإجراءات":"More actions")" />}</div></section>
@code{[Parameter,EditorRequired]public string ScenarioId{get;set;}="action-menu.defaults";private string? Theme=>ScenarioId=="action-menu.theme-dark"?"dark":null;private string? Direction=>ScenarioId=="action-menu.locale-ar"?"rtl":null;private IReadOnlyList<ActionMenuEntry> EmptyItems=>[];private IReadOnlyList<ActionMenuEntry> ContentItems=>[new ActionMenuItem("long","Awaiting third-party structural certification review"),new ActionMenuItem("number","1,284,905"),new ActionMenuItem("hostile","Bay 4 <grid C-7> & 8"),new ActionMenuItem("name","Ordnance Survey — Niño Ångström")];private IReadOnlyList<ActionMenuEntry> Items=>[new ActionMenuItem("edit",Direction=="rtl"?"تحرير":"Edit"),new ActionMenuItem("disabled","Disabled",Disabled:true),new ActionMenuSeparator(),new ActionMenuItem("delete",Direction=="rtl"?"حذف":"Delete",Destructive:true)];}
