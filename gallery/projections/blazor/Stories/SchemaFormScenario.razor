  private static readonly IReadOnlyDictionary<string, SchemaFormControlRenderer> CustomControls =
    new Dictionary<string, SchemaFormControlRenderer> { ["bespoke"] = BespokeControl };

  private static RenderFragment BespokeControl(SchemaFormControlArgs args) => builder =>
  {
    builder.OpenElement(0, "output");
    builder.AddAttribute(1, "aria-describedby", args.Field.HelpText is null ? null : $"{args.Field.Name}-hint");
    builder.AddAttribute(2, "aria-labelledby", $"{args.Field.Name}-label");
    builder.AddAttribute(3, "class", "hl-schema-form__readonly");
    builder.AddAttribute(4, "id", args.Field.Name);
    builder.AddContent(5, $"{args.StringValue} · custom registry");
    builder.CloseElement();
  };

  private static ValueTask<SchemaFormValidationResult?> ValidSubmit(IReadOnlyDictionary<string, object?> _) =>
    ValueTask.FromResult<SchemaFormValidationResult?>(SchemaFormValidationResult.Valid);

  private static ValueTask<SchemaFormValidationResult?> ValidationSubmit(IReadOnlyDictionary<string, object?> _) =>
    ValueTask.FromResult<SchemaFormValidationResult?>(new(false,
    [
      new("/name", "Enter the caller-provided requester name."),
      new("/shipping/address", "Complete the shipping address."),
      new("", "The request cannot be saved yet."),
    ]));

  private static readonly IReadOnlyDictionary<string, (string Title, string Description)> CopyByScenario =
    new Dictionary<string, (string, string)>
    {
      ["schema-form.controls-structure"] = ("Ordered controls and collections", "Registry resolution, fallback, nested updates, and bounded rows share one caller-defined order."),
      ["schema-form.rules-gate"] = ("Rule outcomes and save gate", "Visibility, required, read-only, computed, and presentation outcomes project before save."),
      ["schema-form.validation"] = ("Inline and summary validation", "Save to inspect inline association, summary partitioning, and summary focus."),
      ["schema-form.locale-theme"] = ("Caller locales and dark theme", "Pseudo-expanded and Arabic copy exercise locale formatting, logical direction, and shared theme tokens."),
      ["schema-form.content"] = ("Content resilience", "Hostile form content carries a label longer than its control, a grouped large number, escaped angle brackets and an ampersand, and a name with diacritics and an em dash."),
      ["schema-form.empty-state"] = ("Empty state", "No inspection fields are currently available."),
      ["schema-form.error-state"] = ("Error state", "Save the request to review its validation errors."),
    };

  private (string Title, string Description) Copy => CopyByScenario[ScenarioId];
  private string? Theme => ScenarioId == "schema-form.locale-theme" ? "dark" : null;

  private sealed class GalleryRuleGraph : ISchemaFormRuleGraph
  {
    public SchemaFormRuleEvaluation EvaluateInstance(SchemaFormRuleInstance _) => new()
    {
      Visibility = new Dictionary<string, SchemaFormVisibility>
      {
        ["field:contact"] = new(true, true, false),
        ["field:reference"] = new(true, false, true),
        ["field:internalNote"] = new(false, false, false),
      },
      Values = new Dictionary<string, SchemaFormRuleValue>
      {
        ["field:total"] = new(SchemaFormRuleValueState.Resolved, 1250.5d),
      },
      Presentations = new Dictionary<string, SchemaFormPresentation>
      {
