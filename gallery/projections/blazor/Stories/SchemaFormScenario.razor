<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme">
  <header class="hl-gallery-heading"><h2>@Copy.Title</h2><p>@Copy.Description</p></header>
  <div class="hl-gallery-stage hl-gallery-feedback-grid">
    @if (ScenarioId == "schema-form.controls-structure")
    {
      <HarborlineSchemaForm Controls="CustomControls" InitialValues="ControlsValues" OnSubmit="ValidSubmit"
                          Strings="EnglishStrings" View="ControlsView" />
    }
    else if (ScenarioId == "schema-form.rules-gate")
    {
      <HarborlineSchemaForm InitialValues="RulesValues" OnSubmit="ValidSubmit" RuleGraph="RuleGraph"
                          Strings="EnglishStrings" View="RulesView" />
    }
    else if (ScenarioId == "schema-form.validation")
    {
      <HarborlineSchemaForm InitialValues="ValidationValues" OnSubmit="ValidationSubmit"
                          Strings="EnglishStrings" View="ValidationView" />
    }
    else if (ScenarioId == "schema-form.error-state")
    {
      <HarborlineSchemaForm InitialValues="ValidationValues" OnSubmit="ValidationSubmit"
                          Strings="EnglishStrings" View="ValidationView" />
    }
    else if (ScenarioId == "schema-form.empty-state")
    {
      <HarborlineSchemaForm InitialValues="EmptyValues" OnSubmit="ValidSubmit"
                          Strings="EnglishStrings" View="EmptyView" />
    }
    else if (ScenarioId == "schema-form.content")
    {
      <HarborlineSchemaForm InitialValues="ContentValues" OnSubmit="ValidSubmit"
                          Strings="EnglishStrings" View="ContentView" />
    }
    else
    {
      <HarborlineSchemaForm InitialValues="PseudoValues" LocaleChain="PseudoLocale" OnSubmit="ValidSubmit"
                          Strings="PseudoStrings" View="PseudoView" />
      <HarborlineSchemaForm InitialValues="ArabicValues" LocaleChain="ArabicLocale" OnSubmit="ValidSubmit"
                          Strings="ArabicStrings" View="ArabicView" />
    }
  </div>
</section>

