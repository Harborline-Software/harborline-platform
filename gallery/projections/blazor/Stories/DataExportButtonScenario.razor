<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>Data export</h2></header><div class="hl-gallery-stage hl-gallery-button-row">@if(ScenarioId=="data-export-button.content"){<HarborlineDataExportButton Label="@ContentLabel" Formats="AllFormats" OnExport="HandleExport"/>}else{<HarborlineDataExportButton Label="@(Direction=="rtl"?"تصدير":"Export data")" Formats="AllFormats" OnExport="HandleExport"/>}@if(ScenarioId=="data-export.states"){<HarborlineDataExportButton Disabled OnExport="HandleExport"/><HarborlineDataExportButton Loading OnExport="HandleExport"/>}</div></section>
@code{[Parameter,EditorRequired]public string ScenarioId{get;set;}="data-export.defaults";private const string ContentLabel="Awaiting third-party structural certification review — 1,284,905 — Bay 4 <grid C-7> & 8 — Ordnance Survey — Niño Ångström";private static readonly IReadOnlyList<ExportFormat> AllFormats=[ExportFormat.Csv,ExportFormat.Xlsx,ExportFormat.Pdf,ExportFormat.Json,ExportFormat.Md];private string? Theme=>ScenarioId.EndsWith("rtl-theme")?"dark":null;private string? Direction=>ScenarioId.EndsWith("rtl-theme")?"rtl":null;private static Task HandleExport(ExportFormat format)=>Task.CompletedTask;}
