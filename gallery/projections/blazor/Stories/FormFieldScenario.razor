<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>@Title</h2><p>Labels, hints, alerts, and inherited state stay connected.</p></header><div class="hl-gallery-stage hl-gallery-feedback-grid">@if(ScenarioId=="form-field.content"){<HarborlineFormField Name="certification-amount" Label="@("Awaiting third-party structural certification review")" Hint="@("1,284,905")"><HarborlineNumberField Name="certification-amount" Value="1284905" /></HarborlineFormField><HarborlineFormField Name="survey-amount" Label="@("Ordnance Survey — Niño Ångström")" Error="@("Bay 4 <grid C-7> & 8")"><HarborlineNumberField Name="survey-amount" Value="8" /></HarborlineFormField>}else if(ScenarioId=="form-field.error-state"){<HarborlineFormField Name="amount" Label="Total amount" Error="Amount is required"><HarborlineNumberField Name="amount" Value="125.5" /></HarborlineFormField>}else{<HarborlineFormField Name="amount" Label="@(Rtl ? "المبلغ الإجمالي" : "Total amount")" Required="true" Hint="@Hint" Error="@(States ? "Amount is required" : null)" Disabled="@States"><HarborlineNumberField Name="amount" Value="125.50" /></HarborlineFormField>}</div></section>
@code { [Parameter, EditorRequired] public string ScenarioId { get; set; } = "form-field.defaults"; private bool States => ScenarioId == "form-field.states"; private bool Rtl => ScenarioId == "form-field.rtl-theme"; private string Hint => Rtl ? "أدخل المبلغ قبل الضريبة\nبالعملة المحلية" : "Enter the pre-tax amount\nIn local currency"; private string Title => ScenarioId == "form-field.error-state" ? "Error state" : ScenarioId == "form-field.content" ? "Content resilience" : States ? "Error and disabled" : Rtl ? "RTL and theme" : "Label and hint"; private string? Theme => Rtl ? "dark" : null; private string? Direction => Rtl ? "rtl" : null; }
