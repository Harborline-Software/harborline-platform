@attribute [Stories("Platform/Conversation List")]
<Stories TComponent="ConversationListScenario">@foreach(var entry in Entries){<Story Name="@entry.Name"><Arguments><Arg For="_ => _.ScenarioId" Value="@entry.Id"/></Arguments><Template><ConversationListScenario @attributes="context.Args"/></Template></Story>}<Story Name="Content resilience"><Arguments><Arg For="_ => _.ScenarioId" Value='"conversation-list.content"'/></Arguments><Template><ConversationListScenario @attributes="context.Args"/></Template></Story></Stories>
@code{private static readonly (string Id,string Name)[] Entries=[("conversation-list.empty","Empty state"),("conversation-list.rows","Rows and active state"),("conversation-list.rename","Rename workflow"),("conversation-list.delete","Confirmed delete workflow"),("conversation-list.locale-ar","Arabic and expanded labels"),("conversation-list.invalid","Input validation"),("conversation-list.theme-light","Light theme"),("conversation-list.theme-dark","Dark theme")];}
