@namespace Harborline.Gallery.Blazor.Stories
@using Harborline.Foundation.RuleAuthoring
@using Harborline.Contracts.Rules
@using System.Text.Json
<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId"><header class="hl-gallery-heading"><h2>Rule authoring</h2><p>Build a closed formula or decision table without authoring raw JSON.</p></header><div class="hl-gallery-stage"><HarborlineRulesAuthoringEditor Value="@Draft" ValueChanged="value => Draft = value" ExpressionContracts="@(ScenarioId == "rule-authoring.promotion" ? PromotionContracts : Contracts)" PreviewKind="sample" Catalogue="@Catalogue" CatalogueChanged="value => Catalogue = value" Lineage="@Lineage" Outcome="@PreviewOutcome" Response="@Response" OperationRequested="Operate" /></div></section>
@code {
    [Parameter] public string ScenarioId { get; set; } = "rule-authoring.from-empty";
    private RulesDraft Draft = RulesDraft.Empty;
    private RulesOperationResponse? Response;
    private RulesRuleCatalogue? Catalogue;
    private RulesLineageView? Lineage;
    private RulesOutcome? PreviewOutcome => ScenarioId == "rule-authoring.preview-outcomes" ? new("Value", "sample", "2026-06-30T00:00:00.0000000Z", Value: "\"ready\"", RuleName: "preview-value", MemberName: "amount") : null;
    private static readonly RulesExpressionContract[] Contracts=[new("rule","typed value","preview",[new("amount","Amount",ColumnValueType.Number)])];
    private static readonly RulesExpressionContract[] PromotionContracts=[new("rule","typed value","preview",[new("self","Self",ColumnValueType.Number),new("amount","Amount",ColumnValueType.Number)])];
    protected override void OnParametersSet() { if (ScenarioId == "rule-authoring.promotion" && Catalogue is null) { Draft = new RulesDraft("amount-check", "", "Amount check", "Draft", "", new FormulaDraft { Scope = RuleScope.Field, ScopeTarget = "amount", OutputType = RuleActionKind.Validate, Inputs = [new FormulaInputDecl("self", "self", ColumnValueType.Number)], Expression = new FormulaExpr.Call(">=", [new FormulaExpr.Ref("self"), new FormulaExpr.Literal("0", ColumnValueType.Number)]) }); Catalogue = new([Draft]); } if (ScenarioId == "rule-authoring.lineage" && Catalogue is null) { using var stream = typeof(RuleAuthoringScenario).Assembly.GetManifestResourceStream("rule-authoring-lineage.json")!; using var fixture = JsonDocument.Parse(stream); var root = fixture.RootElement; var rules = root.GetProperty("documents").EnumerateArray().Select(row => { var doc = RuleIntentValidator.ValidateJson(row.GetRawText(), RuleIntentPhase.Author).Document!; return new RulesDraft(doc.Envelope.Id, "", doc.Name, "Draft", "", doc.Draft); }).ToArray(); Catalogue = new(rules); Draft = rules[0]; var lineage = root.GetProperty("lineage"); static Dictionary<string, IReadOnlyList<string>> Map(JsonElement element) => element.EnumerateObject().ToDictionary(p => p.Name, p => (IReadOnlyList<string>)p.Value.EnumerateArray().Select(x => x.GetString()!).ToArray()); Lineage = new(Map(lineage.GetProperty("consumersOf")), Map(lineage.GetProperty("calculationsReadBy")), lineage.GetProperty("deadWeight").EnumerateArray().Select(x => x.GetString()!).ToArray()); } if (ScenarioId == "rule-authoring.lifecycle-fence" && Draft.Identity == "") Draft = RulesDraft.Empty with { Identity = "amount-rule", ExpectedRevision = "1", VersionSelection = "Latest" }; }
    private void Operate(RulesOperationRequest request) { if (ScenarioId != "rule-authoring.lifecycle-fence") return; Response = new(request.RequestId, request.Identity, request.ExpectedRevision, request.Generation, new("amount-rule", "2", "Published"), Materialization: LoadMaterialization()); }
    private static RulesMaterialization LoadMaterialization() { using var stream = typeof(RuleAuthoringScenario).Assembly.GetManifestResourceStream("rules-editor-contract-fixtures.json")!; using var document = JsonDocument.Parse(stream); return JsonSerializer.Deserialize<RulesMaterialization>(document.RootElement.GetProperty("lifecycle").GetProperty("responses")[4].GetProperty("materialization"), new JsonSerializerOptions(JsonSerializerDefaults.Web))!; }
}
