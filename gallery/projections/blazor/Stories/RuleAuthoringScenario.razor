@namespace Harborline.Gallery.Blazor.Stories
@using Harborline.Foundation.RuleAuthoring
<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId"><header class="hl-gallery-heading"><h2>Rule authoring</h2><p>Build a closed formula or decision table without authoring raw JSON.</p></header><div class="hl-gallery-stage"><HarborlineRulesAuthoringEditor Value="@Draft" ValueChanged="value => Draft = value" ExpressionContracts="@Contracts" PreviewKind="sample" Outcome="@PreviewOutcome" Response="@Response" OperationRequested="Operate" /></div></section>
@code {
    [Parameter] public string ScenarioId { get; set; } = "rule-authoring.from-empty";
    private RulesDraft Draft = RulesDraft.Empty;
    private RulesOperationResponse? Response;
    private RulesOutcome? PreviewOutcome => ScenarioId == "rule-authoring.preview-outcomes" ? new("Value", "sample", "2026-06-30T00:00:00.0000000Z", Value: "\"ready\"", RuleName: "preview-value", MemberName: "amount") : null;
    private static readonly RulesExpressionContract[] Contracts=[new("rule","typed value","preview",[new("amount","Amount",ColumnValueType.Number)])];
    protected override void OnParametersSet() { if (ScenarioId == "rule-authoring.lifecycle-fence" && Draft.Identity == "") Draft = RulesDraft.Empty with { Identity = "amount-rule", ExpectedRevision = "1", VersionSelection = "Latest" }; }
    private void Operate(RulesOperationRequest request) { if (ScenarioId != "rule-authoring.lifecycle-fence") return; Response = new(request.RequestId, request.Identity, request.ExpectedRevision, request.Generation, new("amount-rule", "2", "Published"), Materialization: new([new("tenant-a", "amount-rule", "fixture-v1", "1.0.0", "{}")], "{}", "sha256:fixture")); }
}
