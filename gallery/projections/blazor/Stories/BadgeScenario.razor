<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>Badges</h2></header><div class="hl-gallery-stage hl-gallery-button-row">@if(ScenarioId=="badge.content"){<HarborlineBadge>@("Awaiting third-party structural certification review")</HarborlineBadge><HarborlineBadge Variant="BadgeVariant.Info">@("1,284,905")</HarborlineBadge><HarborlineBadge Variant="BadgeVariant.Danger">@("Bay 4 <grid C-7> & 8")</HarborlineBadge><HarborlineBadge Variant="BadgeVariant.Success">@("Ordnance Survey — Niño Ångström")</HarborlineBadge>}else if(ScenarioId=="badge.overlays"){<HarborlineBadge ThemeColor="BadgeThemeColor.Success" FillMode="BadgeFillMode.Solid">3</HarborlineBadge><HarborlineBadge ThemeColor="BadgeThemeColor.Warning" FillMode="BadgeFillMode.Outline" Rounded="BadgeRounded.Full">Pending</HarborlineBadge><HarborlineBadge AnnounceChanges>4 updates</HarborlineBadge>}else{<HarborlineBadge>@(Direction=="rtl"?"مسودة":"Draft")</HarborlineBadge><HarborlineBadge Variant="BadgeVariant.Info">Info</HarborlineBadge><HarborlineBadge Variant="BadgeVariant.Success">Ready</HarborlineBadge><HarborlineBadge Variant="BadgeVariant.Danger">Blocked</HarborlineBadge>}</div></section>
@code{[Parameter,EditorRequired]public string ScenarioId{get;set;}="badge.variants";private string? Theme=>ScenarioId.EndsWith("rtl-theme")?"dark":null;private string? Direction=>ScenarioId.EndsWith("rtl-theme")?"rtl":null;}
