<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>@Title</h2><p>Local wall-clock strings remain free of timezone conversion.</p></header><div class="hl-gallery-stage hl-gallery-feedback-grid">@if(ScenarioId=="date-time-field.error-state"){<HarborlineFormField Name="inspection-time" Label="Inspection time" Error="Enter a valid inspection time" Required="true"><HarborlineDateTimeField Name="inspection-time" Value="" Error="true" Required="true" /></HarborlineFormField>}else if(ScenarioId=="date-time-field.content"){<HarborlineFormField Name="certification-time" Label="@("Awaiting third-party structural certification review")" Hint="@("1,284,905")"><HarborlineDateTimeField Name="certification-time" Value="2026-08-09T14:30" /></HarborlineFormField><HarborlineFormField Name="survey-time" Label="@("Ordnance Survey — Niño Ångström")" Error="@("Bay 4 <grid C-7> & 8")"><HarborlineDateTimeField Name="survey-time" Value="2026-08-09T15:30" /></HarborlineFormField>}else{<HarborlineFormField Name="starts" Label="@(Rtl ? "وقت البدء" : "Start time")" Hint="Local time" Error="@(States ? "Start time is required" : null)" Disabled="@States"><HarborlineDateTimeField Name="starts" Value="2026-08-09T14:30" Step="900" /></HarborlineFormField><HarborlineFormField Name="ends" Label="@(Rtl ? "وقت الانتهاء" : "End time")" Required="true"><HarborlineDateTimeField Name="ends" Value="2026-08-09T15:30" /></HarborlineFormField>}</div></section>
@code { [Parameter, EditorRequired] public string ScenarioId { get; set; } = "date-time-field.defaults"; private bool States => ScenarioId == "date-time-field.states"; private bool Rtl => ScenarioId == "date-time-field.rtl-theme"; private string Title => ScenarioId == "date-time-field.error-state" ? "Error state" : ScenarioId == "date-time-field.content" ? "Content resilience" : States ? "States and descriptions" : Rtl ? "RTL and theme" : "Local time and constraints"; private string? Theme => Rtl ? "dark" : null; private string? Direction => Rtl ? "rtl" : null; }
