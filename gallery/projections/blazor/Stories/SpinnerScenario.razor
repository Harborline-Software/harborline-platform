<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>Progress</h2></header><div class="hl-gallery-stage hl-gallery-button-row">@if(ScenarioId=="spinner.content"){<HarborlineSpinner Label="@("Awaiting third-party structural certification review — 1,284,905 — Bay 4 <grid C-7> & 8 — Ordnance Survey — Niño Ångström")"/>}else if(ScenarioId=="spinner.sizes-colors"){<HarborlineSpinner Size="SpinnerSize.Xs"/><HarborlineSpinner Size="SpinnerSize.Sm" ThemeColor="SpinnerThemeColor.Info"/><HarborlineSpinner Size="SpinnerSize.Md" ThemeColor="SpinnerThemeColor.Success"/><HarborlineSpinner Size="SpinnerSize.Lg" ThemeColor="SpinnerThemeColor.Warning"/>}else{<HarborlineSpinner Label="@(Direction=="rtl"?"جار التحميل":"Loading")"/><HarborlineSpinner Type="SpinnerType.Converging" Label="Synchronizing"/>}</div></section>
@code{[Parameter,EditorRequired]public string ScenarioId{get;set;}="spinner.types";private string? Theme=>ScenarioId.EndsWith("rtl-theme")?"dark":null;private string? Direction=>ScenarioId.EndsWith("rtl-theme")?"rtl":null;}
