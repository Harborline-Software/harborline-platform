<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>Alerts</h2></header><div class="hl-gallery-stage">@if(ScenarioId=="alert.content"){<HarborlineAlert Title="Awaiting third-party structural certification review">@("1,284,905 · Bay 4 <grid C-7> & 8 · Ordnance Survey — Niño Ångström")</HarborlineAlert>}else if(ScenarioId=="alert.variants"){<HarborlineAlert Title="Information">Review the latest changes.</HarborlineAlert><HarborlineAlert Variant="AlertVariant.Success" Title="Saved">Record updated.</HarborlineAlert><HarborlineAlert Variant="AlertVariant.Warning">Approval is required.</HarborlineAlert><HarborlineAlert Variant="AlertVariant.Error">Export failed.</HarborlineAlert>}else{<HarborlineAlert Closable DismissLabel="@(Direction=="rtl"?"إغلاق التنبيه":"Close notice")">@(Direction=="rtl"?"اكتملت المزامنة":"This notice can be dismissed.")</HarborlineAlert>}</div></section>
@code{[Parameter,EditorRequired]public string ScenarioId{get;set;}="alert.variants";private string? Theme=>ScenarioId.EndsWith("rtl-theme")?"dark":null;private string? Direction=>ScenarioId.EndsWith("rtl-theme")?"rtl":null;}
