<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>@Title</h2><p>Native grouped selection retains labels, descriptions, and inherited state.</p></header><div class="hl-gallery-stage">@if(ErrorState){<HarborlineFormField Name="inspection-priority" Label="Inspection priority" Required="true" Error="Choose an inspection priority"><HarborlineRadioGroup Name="inspection-priority" Value="" Options="@ErrorOptions" Error="true" /></HarborlineFormField>}else if(Content){<HarborlineFormField Name="content-choice" Label="Content cases"><HarborlineRadioGroup Name="content-choice" Value="large-number" Options="@ContentOptions" /></HarborlineFormField>}else{<HarborlineFormField Name="billing" Label="@(Rtl ? "دورة الفوترة" : "Billing cycle")" Required="true" Error="@(States ? "Choose a cycle" : null)"><HarborlineRadioGroup Name="billing" Value="quarterly" Options="@Options" Orientation="@(States ? RadioGroupOrientation.Horizontal : RadioGroupOrientation.Vertical)" Error="@States" /></HarborlineFormField>}</div></section>
@code { [Parameter, EditorRequired] public string ScenarioId { get; set; } = "radio-group.defaults"; private bool States => ScenarioId == "radio-group.states"; private bool Rtl => ScenarioId == "radio-group.rtl-theme"; private bool Content => ScenarioId == "radio-group.content"; private bool ErrorState => ScenarioId == "radio-group.error-state"; private IReadOnlyList<HarborlineRadioOption> ErrorOptions => [new("routine", "Routine"), new("urgent", "Urgent")]; private IReadOnlyList<HarborlineRadioOption> ContentOptions => [new("long-label", "Awaiting third-party structural certification review"), new("large-number", "1,284,905"), new("hostile-text", "Bay 4 <grid C-7> & 8"), new("unusual-name", "Ordnance Survey — Niño Ångström")]; private IReadOnlyList<HarborlineRadioOption> Options => Rtl ? [new("monthly", "شهري"), new("quarterly", "ربع سنوي", "أربع فواتير كل عام"), new("annual", "سنوي", Disabled: true)] : [new("monthly", "Monthly"), new("quarterly", "Quarterly", "Four invoices each year"), new("annual", "Annual", Disabled: true)]; private string Title => ErrorState ? "Error state" : Content ? "Content resilience" : States ? "States and orientation" : Rtl ? "RTL and theme" : "Selection and descriptions"; private string? Theme => Rtl ? "dark" : null; private string? Direction => Rtl ? "rtl" : null; }
