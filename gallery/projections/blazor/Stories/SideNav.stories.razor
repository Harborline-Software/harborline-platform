@code { private static readonly (string Id,string Name)[] Items=[("side-nav.structure-active","Groups, links, and active route"),("side-nav.activation-states","Activation, disclosure, and disabled state"),("side-nav.collapsed-badges","Collapsed rail, badges, and targets"),("side-nav.replacement","Complete model replacement"),("side-nav.locale-pseudo","Pseudo-localized navigation"),("side-nav.locale-ar","Arabic right-to-left navigation"),("side-nav.theme-light","Light theme"),("side-nav.theme-dark","Dark theme")]; }
