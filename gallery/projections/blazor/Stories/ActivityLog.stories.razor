@attribute [Stories("Platform/Activity Log")]
<Stories TComponent="ActivityLogScenario">@foreach(var entry in Entries){<Story Name="@entry.Name"><Arguments><Arg For="_ => _.ScenarioId" Value="@entry.Id"/></Arguments><Template><ActivityLogScenario @attributes="context.Args"/></Template></Story>}<Story Name="Content resilience"><Arguments><Arg For="_ => _.ScenarioId" Value='"activity-log.content"'/></Arguments><Template><ActivityLogScenario @attributes="context.Args"/></Template></Story></Stories>
@code{private static readonly (string Id,string Name)[] Entries=[("activity-log.empty","Empty history"),("activity-log.list","List layout and tones"),("activity-log.table","Table layout"),("activity-log.responsive","Responsive layout"),("activity-log.disclosure","Bounded disclosure"),("activity-log.invalid","Input validation"),("activity-log.locale-en","English locale"),("activity-log.locale-pseudo","Pseudo-expanded locale"),("activity-log.locale-ar","Arabic RTL"),("activity-log.theme-light","Light theme"),("activity-log.theme-dark","Dark theme")];}
