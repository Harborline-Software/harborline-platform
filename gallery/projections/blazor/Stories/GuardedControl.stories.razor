@attribute [Stories("Platform/Guarded Control")]
<Stories TComponent="GuardedControlScenario">
    @foreach (var scenario in Scenarios)
    {
        <Story Name="@scenario.Name">
            <Arguments><Arg For="_ => _.ScenarioId" Value="@scenario.Id" /></Arguments>
            <Template><GuardedControlScenario @attributes="context.Args" /></Template>
        </Story>
    }
    <Story Name="Content resilience"><Arguments><Arg For="_ => _.ScenarioId" Value='"guarded-control.content"'/></Arguments><Template><GuardedControlScenario @attributes="context.Args"/></Template></Story>
</Stories>

@code {
    private static readonly (string Id, string Name)[] Scenarios =
    [
        ("guarded-control.covered", "Covered and unavailable"),
        ("guarded-control.two-step", "Arm and commit"),
        ("guarded-control.keyboard-recovery", "Keyboard, focus, and recovery"),
        ("guarded-control.locale-en", "English locale"),
        ("guarded-control.locale-pseudo", "Pseudo locale"),
        ("guarded-control.locale-ar", "Arabic locale"),
        ("guarded-control.theme-light", "Light theme"),
        ("guarded-control.theme-dark", "Dark theme"),
    ];
}
