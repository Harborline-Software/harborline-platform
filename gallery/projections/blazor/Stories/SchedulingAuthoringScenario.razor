@namespace Harborline.Gallery.Blazor.Stories
@using System.Text.Json.Nodes
<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId"><header class="hl-gallery-heading"><h2>@Copy.Title</h2><p>@Copy.Description</p></header><div class="hl-gallery-stage"><HarborlineSchedulingAuthoringEditor Value="Body" ValueChanged="next => Body = next" CreateRequested="next => Body = next" Catalogue="Catalogue" Refusals="Refusals" /></div></section>
@code {
 [Parameter] public string ScenarioId {get;set;} = "scheduling-authoring.from-empty";
 private JsonObject Body = new();
 private string? _loaded;
 protected override void OnParametersSet() { if (_loaded == ScenarioId) return; _loaded = ScenarioId; Body = ScenarioId == "scheduling-authoring.bound" ? JsonNode.Parse("""{"name":"Inspection","starts":{"kind":"form","target_id":"forms.inspection"},"due_date":"2027-01-01T00:00:00Z","problem_class":"Project","solver":{"backend_id":"prototype.exhaustive-proof.v2","parameters":{"seed":7},"guarantee":"feasible_proof","work_budget":10},"modules":[{"module":"precedence","parameters":{"before":"a","after":"b"}}]}""")!.AsObject() : new(); }
 private static readonly ScheduleCatalogue Catalogue = new() { Types=[new("types.asset","Asset")],Legality=[new("legality.safety","Safety rules")],Backends=[new("prototype.exhaustive-proof.v2","Prototype",["feasible_proof"])],Modules=[new("precedence","Precedence","chain")] };
 private IReadOnlyList<ScheduleRefusal> Refusals => ScenarioId == "scheduling-authoring.refusals" ? [new("scheduling.definition.name_required","/name")] : [];
 private (string Title,string Description) Copy => ScenarioId switch {
 "scheduling-authoring.from-empty" => ("Author from empty","Create a Schedule from nothing using named native controls."),
 "scheduling-authoring.bound" => ("Bound solver and module","Choose a registered backend and explicitly opt into an admitted module."),
 "scheduling-authoring.refusals" => ("Refusal list","Server refusals appear before publish in a live region."),
 _ => ("Schedule","Unknown scenario") };
}
