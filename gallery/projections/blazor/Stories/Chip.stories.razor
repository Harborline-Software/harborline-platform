@attribute [Stories("Platform/Chip")]
<Stories TComponent="ChipScenario">@foreach(var entry in Entries){<Story Name="@entry.Name"><Arguments><Arg For="_ => _.ScenarioId" Value="@entry.Id"/></Arguments><Template><ChipScenario @attributes="context.Args"/></Template></Story>}<Story Name="Content resilience"><Arguments><Arg For="_ => _.ScenarioId" Value='"chip.content"'/></Arguments><Template><ChipScenario @attributes="context.Args"/></Template></Story></Stories>
@code{private static readonly (string Id,string Name)[] Entries=[("chip.defaults","Content and defaults"),("chip.interactions","Selection and removal"),("chip.locale-ar","Arabic and expanded labels"),("chip.invalid","Accessible content validation"),("chip.theme-light","Light theme"),("chip.theme-dark","Dark theme")];}
