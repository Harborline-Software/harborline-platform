<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction">
  <header class="hl-gallery-heading"><h2>@Copy.Title</h2><p>@Copy.Description</p></header>
  <div class="hl-gallery-stage">
    <HarborlineLocaleProvider Locale="@Locale" Direction="@Direction">
      <div class="hl-gallery-feedback-stack">
        <div style="border:1px solid var(--hl-color-border, #888);max-inline-size:@(Collapsed ? "96px" : "320px");min-block-size:420px">
          @if(ScenarioId=="side-nav.content")
          {
            <HarborlineSideNav Groups="@ContentGroups" ActiveItemId="long" NavigationLabel="Content resilience navigation" />
          }
          else
          {
            <HarborlineSideNav Groups="@Groups" ActiveItemId="@active" Collapsed="@Collapsed"
                                 ItemActivated="Activate" NavigationLabel="@NavigationLabel" />
          }
        </div>
        <output aria-live="polite">Last activation: @lastActivation</output>
      </div>
    </HarborlineLocaleProvider>
  </div>
</section>

@code {
  [Parameter, EditorRequired] public string ScenarioId { get; set; } = "side-nav.structure-active";
  private string active = "calendar";
  private string lastActivation = "none";
  private bool IsArabic => ScenarioId == "side-nav.locale-ar";
  private bool IsPseudo => ScenarioId == "side-nav.locale-pseudo";
  private bool Collapsed => ScenarioId == "side-nav.collapsed-badges";
  private string Locale => IsArabic ? "ar-SA" : IsPseudo ? "en-XA" : "en-US";
  private string Direction => IsArabic ? "rtl" : "ltr";
  private string NavigationLabel => IsArabic ? "التنقل الرئيسي" : IsPseudo ? "⟦ Þřîmåřÿ ñåṽîĝåţîøñ ······ ⟧" : "Navigation";
  private string L(string english, string arabic) => IsArabic ? arabic : IsPseudo ? $"⟦ {english} ······ ⟧" : english;
  private RenderFragment Icon(string glyph) => builder => { builder.OpenElement(0, "span"); builder.AddAttribute(1, "style", "display:inline-grid;min-width:20px;place-items:center"); builder.AddContent(2, glyph); builder.CloseElement(); };
  private RenderFragment Badge(string value) => builder => { builder.OpenElement(0, "span"); builder.AddContent(1, value); builder.CloseElement(); };

  private IReadOnlyList<SideNavNavigationGroup> Groups =>
  [
    new("operations",
    [
      new("overview", L("Overview", "نظرة عامة"), Icon("⌂"), Href: "#overview", TrailingContent: Badge(L("New", "جديد"))),
      new("calendar", L("Schedule", "الجدول"), Icon("▦"), TrailingContent: Badge("3")),
      new("assets", L("Structures", "الهياكل"), Icon("◇"), Children:
      [
        new("asset-map", L("Structure map", "خريطة الهيكل"), Icon("⌖")),
        new("asset-archive", L("Archived structures", "الهياكل المؤرشفة"), Icon("□"), Disabled: true),
      ]),
    ], L("Operations", "العمليات")),
    new("administration", [new("team", L("Team access", "وصول الفريق"), Icon("◉"))], L("Administration", "الإدارة")),
  ];
  private IReadOnlyList<SideNavNavigationGroup> ContentGroups =>
  [new("content", [new("long", "Awaiting third-party structural certification review"), new("number", "1,284,905"), new("hostile", "Bay 4 <grid C-7> & 8"), new("name", "Ordnance Survey — Niño Ångström")], "Content resilience")];

  private static readonly IReadOnlyDictionary<string, (string Title, string Description)> CopyByScenario = new Dictionary<string, (string, string)>
  {
    ["side-nav.structure-active"] = ("Groups, links, and active route", "Ordered groups and recursive items expose one current leaf without owning the route table."),
    ["side-nav.activation-states"] = ("Activation, disclosure, and disabled state", "Buttons, links, disclosure, disabled policy, and visible focus retain native keyboard behavior."),
    ["side-nav.collapsed-badges"] = ("Collapsed rail, badges, and targets", "The icon rail preserves names and tooltips while noninteractive badges remain outside activation targets."),
    ["side-nav.replacement"] = ("Complete model replacement", "The newest groups, active identity, labels, and callbacks replace the previous model without stale rows."),
    ["side-nav.locale-pseudo"] = ("Pseudo-localized navigation", "Expanded group, item, tooltip, and badge copy reflows without clipping."),
    ["side-nav.locale-ar"] = ("Arabic right-to-left navigation", "Indentation, disclosure, icons, badges, and tooltips follow logical direction."),
    ["side-nav.theme-light"] = ("Light theme", "Navigation surface, active route, hover, disabled, badge, and focus use Harborline light tokens."),
    ["side-nav.theme-dark"] = ("Dark theme", "The same recursive navigation model on the Harborline dark surface."),
    ["side-nav.content"] = ("Content resilience", "Hostile-but-valid labels remain text across a real navigation collection."),
  };
  private (string Title, string Description) Copy => CopyByScenario[ScenarioId];
  private void Activate(SideNavNavigationItem item) { active = item.Id; lastActivation = item.Label; }
  private string? Theme => ScenarioId switch { "side-nav.theme-light" => "light", "side-nav.theme-dark" => "dark", _ => null };
}
