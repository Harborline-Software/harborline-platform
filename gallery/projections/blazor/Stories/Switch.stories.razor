@attribute [Stories("Platform/Switch")]
<Stories TComponent="SwitchScenario">
  @foreach (var scenario in Scenarios)
  {
    <Story Name="@scenario.Name"><Arguments><Arg For="_ => _.ScenarioId" Value="@scenario.Id" /></Arguments><Template><SwitchScenario @attributes="context.Args" /></Template></Story>
  }
  <Story Name="Error state"><Arguments><Arg For="_ => _.ScenarioId" Value='"switch.error-state"' /></Arguments><Template><SwitchScenario @attributes="context.Args" /></Template></Story>
</Stories>

@code {
  private static readonly (string Id, string Name)[] Scenarios =
  [
    ("switch.states", "Controlled state and stable naming"),
    ("switch.activation-validation", "Activation, validation, and form value"),
    ("switch.sizing", "Sizes and touch target"),
    ("switch.locale-en", "English locale"),
    ("switch.locale-pseudo", "Pseudo locale"),
    ("switch.locale-ar", "Arabic locale"),
    ("switch.theme-light", "Light theme"),
    ("switch.theme-dark", "Dark theme"),
    ("switch.content", "Content resilience"),
  ];
}
