<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction">
  <header class="hl-gallery-heading">
    <h2>@Copy.Title</h2>
    <p>@Copy.Description</p>
  </header>
  <div class="hl-gallery-stage" style="min-height: 420px; display: flex; gap: 16px">
    @* A layers rail inside a real, open Dialog or Sheet, with no lens active at first. Once a lens is active,
       one Escape clears it and the overlay stays open; with none, the rail leaves Escape to the overlay. *@
    @if (ScenarioId == "layers-rail.inside-dialog")
    {
      <HarborlineDialog Open="@open" OpenChanged="@(value => open = value)" Title="Settings"><HarborlineLayersRail Lenses="@OverlayLenses" State="@OverlayState" StateChanged="@(value => overlayState = value)" Canvas="@OverlayCanvas" Provenance="@OverlayProvenance" /></HarborlineDialog>
    }
    else if (ScenarioId == "layers-rail.inside-sheet")
    {
      <HarborlineSheet Open="@open" OpenChanged="@(value => open = value)"><HarborlineSheetContent CloseLabel="Close panel"><HarborlineSheetTitle>Panel</HarborlineSheetTitle><HarborlineLayersRail Lenses="@OverlayLenses" State="@OverlayState" StateChanged="@(value => overlayState = value)" Canvas="@OverlayCanvas" Provenance="@OverlayProvenance" /></HarborlineSheetContent></HarborlineSheet>
    }
    else if (ScenarioId == "layers-rail.content")
    {
      <RailFixture ScenarioId="layers-rail.content" />
    }
    else
    {
      <RailFixture ScenarioId="@ScenarioId" />
      @if (ScenarioId == "layers-rail.locale-pseudo")
      {
        <RailFixture ScenarioId="@ScenarioId" Compact />
      }
    }
  </div>
</section>

@code {
  [Parameter, EditorRequired] public string ScenarioId { get; set; } = "layers-rail.structure";
  // A composed overlay starts open: reset when the story shows another scenario.
  private bool open = true;
  private string? shownScenario;
  private LayersState overlayState = LayersState.Initialize(["layout", "rules", "access"], null);
  private string? overlaySelectedId;
  protected override void OnParametersSet()
  {
    if (shownScenario == ScenarioId) return;
    shownScenario = ScenarioId;
    open = true;
    overlayState = LayersState.Initialize(["layout", "rules", "access"], null);
    overlaySelectedId = null;
  }
  private LayersState OverlayState => overlayState;
  private static IReadOnlyList<AspectLens> OverlayLenses { get; } =
  [
    new("layout", "Layout", LensTone.Muted, AspectLensKind.Colorize, _ => new(true, "base")),
    new("rules", "Rules", LensTone.Warning, AspectLensKind.Filter, id => new(id == "pose", id == "pose" ? "1 rule" : null), Empty: "Add a rule to a selected field."),
    new("access", "Access", LensTone.Danger, AspectLensKind.Colorize, id => new(true, id == "structure" ? "tenant" : null))
  ];
  private static IReadOnlyList<CanvasNode> OverlayNodes { get; } =
  [
    new("structure", "section", "Structure", 0, null, HasChildren: true),
    new("location", "field", "Placement", 1, "structure", "Blueprint coordinate"),
    new("pose", "field", "Photo pose", 1, "structure", "Position and orientation")
  ];
  private CanvasModel OverlayCanvas => new(OverlayNodes, overlaySelectedId, id => { overlaySelectedId = id; InvokeAsync(StateHasChanged); });
  private static ProvenanceResolver OverlayProvenance { get; } = new(_ => new(ProvenanceSource.Tenant, [ProvenanceSource.Tenant], false, false, true));

  private (string Title, string Description) Copy => ScenarioId switch
  {
    "layers-rail.structure" => ("Rail structure", "A named complementary rail orders the lens group above one outline tree."),
    "layers-rail.lenses" => ("Lens states and shortcuts", "Active and passive lenses preserve visible state while Escape returns to neutral."),
    "layers-rail.outline" => ("Outline keyboard and focus", "Roving tree focus, collapse fallback, and selection follow the APG keyboard model."),
    "layers-rail.provenance" => ("Provenance, insert, and empty", "Source, lock, insert, and empty teaching signals remain explicit and host-owned."),
    "layers-rail.locale-en" => ("English locale", "All rail chrome is supplied through the frozen labels interface."),
    "layers-rail.locale-pseudo" => ("Pseudo locale", "Expanded rail labels and compact mode expose clipping and reflow defects."),
    "layers-rail.locale-ar" => ("Arabic locale", "Logical indentation and alignment follow RTL while tree keys retain their meaning."),
    "layers-rail.theme-light" => ("Light theme", "Lens, selection, provenance, focus, and outline states use public light-theme tokens."),
    "layers-rail.theme-dark" => ("Dark theme", "The same structural rail on the Harborline dark surface."),
    "layers-rail.inside-dialog" => ("Inside a dialog", "Escape clears an active lens and leaves the dialog open; with no lens active, it closes the dialog."),
    "layers-rail.inside-sheet" => ("Inside a sheet", "Escape clears an active lens and leaves the sheet open; with no lens active, it closes the sheet."),
    "layers-rail.content" => ("Content resilience", "Rail nodes and lens projections carry a long label, grouped large number, escaped hostile text, and an unusual name with diacritics."),
    _ => ("Layers rail", "Builder layers and outline.")
  };

  private string Direction => ScenarioId == "layers-rail.locale-ar" ? "rtl" : "ltr";
  private string? Theme => ScenarioId switch { "layers-rail.theme-light" => "light", "layers-rail.theme-dark" => "dark", _ => null };
}
