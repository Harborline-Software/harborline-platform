<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>@Title</h2><p>@Description</p></header><div class="hl-gallery-stage hl-gallery-feedback-grid">@if(ErrorState){<HarborlineNumberField AccessibleLabel="Inspection quantity" Error="true" Name="inspection-quantity" Value="128" />}else if(ScenarioId=="number-field.content"){<HarborlineFormField Name="certification-count" Label="@("Awaiting third-party structural certification review")" Hint="@("1,284,905")"><HarborlineNumberField Name="certification-count" Value="1284905" /></HarborlineFormField><HarborlineFormField Name="survey-count" Label="@("Ordnance Survey — Niño Ångström")" Error="@("Bay 4 <grid C-7> & 8")"><HarborlineNumberField Name="survey-count" Value="8" /></HarborlineFormField>}else{<HarborlineFormField Name="quantity" Label="@(Rtl ? "الكمية" : "Quantity")" Hint="0–100" Error="@(States ? "Quantity is out of range" : null)" Disabled="@States"><HarborlineNumberField Name="quantity" Value="42.50" Min="0" Max="100" Step="0.5" Error="@States" /></HarborlineFormField>}</div></section>
@code { [Parameter, EditorRequired] public string ScenarioId { get; set; } = "number-field.defaults"; private bool States => ScenarioId == "number-field.states"; private bool Rtl => ScenarioId == "number-field.rtl-theme"; private bool ErrorState => ScenarioId == "number-field.error-state"; private string Title => ErrorState ? "Error state" : ScenarioId == "number-field.content" ? "Content resilience" : States ? "States and descriptions" : Rtl ? "RTL and theme" : "Raw values and constraints"; private string Description => ErrorState ? "The number field renders its declared invalid state with an accessible name." : "Intermediate numeric text is never parsed or clamped by the adapter."; private string? Theme => Rtl ? "dark" : null; private string? Direction => Rtl ? "rtl" : null; }
