@attribute [Stories("Platform/Action Menu")]
<Stories TComponent="ActionMenuScenario">@foreach(var entry in Entries){<Story Name="@entry.Name"><Arguments><Arg For="_ => _.ScenarioId" Value="@entry.Id"/></Arguments><Template><ActionMenuScenario @attributes="context.Args"/></Template></Story>}<Story Name="Content resilience"><Arguments><Arg For="_ => _.ScenarioId" Value='"action-menu.content"'/></Arguments><Template><ActionMenuScenario @attributes="context.Args"/></Template></Story></Stories>
@code{private static readonly (string Id,string Name)[] Entries=[("action-menu.defaults","Trigger and entries"),("action-menu.pointer","Pointer and item states"),("action-menu.keyboard","Keyboard, typeahead, and focus"),("action-menu.empty","Empty collection"),("action-menu.dismissal","Dismissal paths"),("action-menu.locale-en","English locale"),("action-menu.locale-pseudo","Pseudo-expanded locale"),("action-menu.locale-ar","Arabic RTL alignment"),("action-menu.theme-light","Light theme"),("action-menu.theme-dark","Dark theme")];}
