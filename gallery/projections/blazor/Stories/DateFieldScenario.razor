<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction"><header class="hl-gallery-heading"><h2>@Title</h2><p>Raw date values remain browser-native and FormField-aware.</p></header><div class="hl-gallery-stage hl-gallery-feedback-grid">@if(ScenarioId=="date-field.error-state"){<HarborlineFormField Name="inspection-date" Label="Inspection date" Error="Enter a valid inspection date" Required="true"><HarborlineDateField Name="inspection-date" Value="" Error="true" Required="true" /></HarborlineFormField>}else if(ScenarioId=="date-field.content"){<HarborlineFormField Name="certification-date" Label="@("Awaiting third-party structural certification review")" Hint="@("1,284,905")"><HarborlineDateField Name="certification-date" Value="2026-08-09" /></HarborlineFormField><HarborlineFormField Name="survey-date" Label="@("Ordnance Survey — Niño Ångström")" Error="@("Bay 4 <grid C-7> & 8")"><HarborlineDateField Name="survey-date" Value="2026-09-09" /></HarborlineFormField>}else{<HarborlineFormField Name="issued" Label="@Label" Hint="@(States ? "Choose a valid accounting date" : "YYYY-MM-DD")" Error="@(States ? "Date is required" : null)" Disabled="@States"><HarborlineDateField Name="issued" Value="2026-08-09" Min="2026-01-01" Max="2026-12-31" /></HarborlineFormField>@if (!States){<HarborlineFormField Name="due" Label="@(Rtl ? "تاريخ الاستحقاق" : "Due date")" Required="true"><HarborlineDateField Name="due" Value="2026-09-09" /></HarborlineFormField>}}</div></section>
@code { [Parameter, EditorRequired] public string ScenarioId { get; set; } = "date-field.defaults"; private bool States => ScenarioId == "date-field.states"; private bool Rtl => ScenarioId == "date-field.rtl-theme"; private string Label => Rtl ? "تاريخ الإصدار" : "Issue date"; private string Title => ScenarioId == "date-field.error-state" ? "Error state" : ScenarioId == "date-field.content" ? "Content resilience" : States ? "States and descriptions" : Rtl ? "RTL and theme" : "Value and bounds"; private string? Theme => Rtl ? "dark" : null; private string? Direction => Rtl ? "rtl" : null; }
