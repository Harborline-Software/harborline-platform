@using Harborline.UIAdapters.Blazor.Shell

<section class="hl-gallery-scene" data-gallery-probe data-gallery-scenario="@ScenarioId" data-theme="@Theme" dir="@Direction">
  <header class="hl-gallery-heading"><h2>@Copy.Title</h2><p>@Copy.Description</p></header>
  <div class="hl-gallery-stage hl-gallery-feedback-grid" style="min-height: @(ScenarioId == "user-menu.disclosure" ? 470 : 320)px; align-items: end">
    <HarborlineLocaleProvider Locale="@Locale">
      @if(ScenarioId=="user-menu.content")
      {
        <HarborlineUserMenu Identity="@ContentIdentity" Items="@ContentItems" Labels="@ContentLabels" />
      }
      else
      {
        <HarborlineUserMenu Identity="@Identity" Items="@Items" OnSignOut="HandleSignOut" Placement="UserMenuPlacement.Bottom"
                          Alignment="@Alignment" Labels="@Labels" Direction="@Direction" CanShowRail="@CanShowRail" />
        @if (ScenarioId == "user-menu.placement-dismissal")
        {
          <HarborlineUserMenu Identity="@Identity" Items="@Items" OnSignOut="HandleSignOut" Placement="UserMenuPlacement.Top"
                            Alignment="@Alignment" Labels="@Labels" Direction="@Direction" CanShowRail="@CanShowRail" />
        }
        @* DefaultOpen rather than a click: a screenshot and a visual-parity comparison cannot click,
           so the open state has to be a rendering to be drawn at all. *@
        @if (ScenarioId == "user-menu.disclosure")
        {
          <HarborlineUserMenu Identity="@Identity" Items="@Items" OnSignOut="HandleSignOut" Placement="UserMenuPlacement.Bottom"
                            Alignment="@Alignment" Labels="@Labels" Direction="@Direction" CanShowRail="@CanShowRail" DefaultOpen />
        }
      }
    </HarborlineLocaleProvider>
  </div>
</section>

@code {
  [Parameter, EditorRequired] public string ScenarioId { get; set; } = "user-menu.identity";
  private bool compact;
  private void HandleSignOut() { }

  private (string Title, string Description) Copy => ScenarioId switch
  {
    "user-menu.identity" => ("Identity, avatar, and initials", "Structured identity remains authoritative and avatar failure preserves a stable trigger name."),
    "user-menu.simple-menu" => ("Simple menu and selection", "Ordered actions and links use a complete menu keyboard model with explicit disabled and close policy."),
    "user-menu.custom-dialog" => ("Custom controls dialog", "Embedded native controls change the popup pattern to dialog and retain their own keyboard behavior."),
    "user-menu.placement-dismissal" => ("Placement, touch, and dismissal", "Logical alignment, viewport clamping, touch sizing, and focus restoration remain deterministic."),
    "user-menu.disclosure" => ("Disclosure, open and closed", "Both disclosure states drawn together: the trigger closed, and the panel opened through DefaultOpen rather than a click."),
    "user-menu.locale-en" => ("English locale", "Catalog-backed trigger, panel, and sign-out labels include caller identity."),
    "user-menu.locale-pseudo" => ("Pseudo locale", "Expanded identity and action copy reflow without clipping."),
    "user-menu.locale-ar" => ("Arabic locale", "Logical placement follows RTL while item order remains stable."),
    "user-menu.theme-light" => ("Light theme", "Closed, open, hover, focus, disabled, and danger states use public tokens."),
    "user-menu.theme-dark" => ("Dark theme", "The same account surface on the Harborline dark theme."),
    "user-menu.content" => ("Content resilience", "Hostile-but-valid identity and action labels remain text."),
    _ => ("User menu", "Account actions.")
  };

  private bool IsArabic => ScenarioId == "user-menu.locale-ar";
  private bool IsPseudo => ScenarioId == "user-menu.locale-pseudo";
  private string Locale => IsArabic ? "ar-SA" : IsPseudo ? "en-XA" : "en-US";
  private string Direction => IsArabic ? "rtl" : "ltr";
  private string? Theme => ScenarioId switch { "user-menu.theme-light" => "light", "user-menu.theme-dark" => "dark", _ => null };
  private UserMenuAlignment Alignment => IsArabic ? UserMenuAlignment.InlineStart : UserMenuAlignment.InlineEnd;
  private bool CanShowRail => ScenarioId is not "user-menu.locale-ar" and not "user-menu.placement-dismissal";
  private UserIdentity Identity => new(
    IsArabic ? "آدا لوفليس" : IsPseudo ? "⟦ Åđå ßÿřøñ Ļøṽëļåçë ······ ⟧" : "Ada Lovelace",
    "ada@example.test",
    IsArabic ? "محللة" : "Analyst");
  private UserIdentity ContentIdentity => new("Ordnance Survey — Niño Ångström", "1,284,905", "Bay 4 <grid C-7> & 8");
  private UserMenuLabels Labels => new(
    name => IsArabic ? $"حساب {name}" : IsPseudo ? $"⟦ Åççøûñţ ƒøř {name} ··· ⟧" : $"Account for {name}",
    IsArabic ? "الحساب" : "Account",
    IsArabic ? "تسجيل الخروج" : IsPseudo ? "⟦ Šîĝñ øûţ ··· ⟧" : "Sign out");
  private UserMenuLabels ContentLabels => new(name => $"Account for {name}", "Content resilience account", "Sign out");
  private IReadOnlyList<UserMenuEntry> ContentItems =>
  [
    new("long", UserMenuEntryKind.Action, "Awaiting third-party structural certification review", ActivateAsync: () => Task.CompletedTask),
    new("number", UserMenuEntryKind.Action, "1,284,905", ActivateAsync: () => Task.CompletedTask),
    new("hostile", UserMenuEntryKind.Action, "Bay 4 <grid C-7> & 8", ActivateAsync: () => Task.CompletedTask),
    new("name", UserMenuEntryKind.Action, "Ordnance Survey — Niño Ångström", ActivateAsync: () => Task.CompletedTask),
  ];
  private IReadOnlyList<UserMenuEntry> Items => ScenarioId == "user-menu.custom-dialog"
    ? [new UserMenuEntry("density", UserMenuEntryKind.Custom, Content: builder =>
      {
        builder.OpenElement(0, "label");
        builder.OpenElement(1, "input");
        builder.AddAttribute(2, "type", "checkbox");
        builder.AddAttribute(3, "checked", compact);
        builder.AddAttribute(4, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args => compact = args.Value as bool? ?? false));
        builder.CloseElement();
        builder.AddContent(5, " Compact rows");
        builder.CloseElement();
      }, CloseOnSelect: false)]
    : [
      new UserMenuEntry("profile", UserMenuEntryKind.Action, IsArabic ? "الملف الشخصي" : IsPseudo ? "⟦ Þřøƒîļë ··· ⟧" : "Profile", ActivateAsync: () => Task.CompletedTask),
      new UserMenuEntry("pin", UserMenuEntryKind.Action, IsArabic ? "تثبيت الشريط" : "Pin navigation", ActivateAsync: () => Task.CompletedTask, CloseOnSelect: false),
      new UserMenuEntry("separator-1", UserMenuEntryKind.Separator),
      new UserMenuEntry("billing", UserMenuEntryKind.Link, IsArabic ? "الفوترة" : "Billing", Destination: "/billing", Disabled: true),
    ];
}
