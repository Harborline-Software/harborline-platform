<?xml version="1.0" encoding="utf-8"?>
<!-- The gallery restores from exactly two sources: the repository's packed artifacts and
     nuget.org. These were CLI double-dash-source arguments until the Windows relocation found
     that MSBuild property plumbing under the BlazorWebAssembly SDK backslash-normalizes URL
     sources into nonexistent local paths (NU1301). nuget.config feeds NuGet directly, with no
     property round-trip, and behaves identically on every platform. <clear/> keeps machine-level
     sources out so the set stays exactly these two. -->
<configuration>
  <packageSources>
    <clear />
    <add key="harborline-artifacts" value="../../../artifacts/packages/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
