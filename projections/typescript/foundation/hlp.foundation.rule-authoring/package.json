{
  "name": "@harborline-software/rule-authoring",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Typed Rules source, strict codecs, full compiler intent diagnostics, advisory lint, seeds and preview. The shared .NET definition store owns publication; this package contains no persistence implementation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.8.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harborline-Software/harborline-platform.git",
    "directory": "projections/typescript/foundation/hlp.foundation.rule-authoring"
  },
  "peerDependencies": {
    "@harborline-software/rule-engine": "0.1.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "@harborline-software/rule-engine": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.1.3",
  "justifications": {
    "@eslint/js": "R-0084",
    "@typescript/native": "R-0086",
    "eslint": "R-0084",
    "typescript": "R-0086",
    "typescript-eslint": "R-0084",
    "vitest": "R-0083"
  }
}
