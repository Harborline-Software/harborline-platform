{
  "name": "@harborline-software/contracts",
  "version": "0.0.0-alpha.0",
  "private": true,
  "description": "Generated Harborline Forms and Workflow wire contracts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./authorization": {
      "types": "./dist/authorization.d.ts",
      "import": "./dist/authorization.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:native": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "keywords": [
    "harborline",
    "forms",
    "contracts"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harborline-Software/harborline-platform.git",
    "directory": "projections/typescript/contracts/hlp.contracts.forms"
  }
}
