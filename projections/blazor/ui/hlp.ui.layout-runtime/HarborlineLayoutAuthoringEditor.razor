@namespace Harborline.UIAdapters.Blazor.Components.Layout
<form class="hl-layout-authoring" @onsubmit="PreventSubmit">
  <label>Layout name<input aria-label="Layout name" value="@Value.Name" @onchange="e => Change(Value with { Name = Text(e) })" /></label>
  <label>Medium<select aria-label="Layout medium" value="@Value.Medium" @onchange="e => Change(Value with { Medium = Text(e) })"><option value="screen">Screen</option><option value="page">Page</option></select></label>
  <label>Default intent<select aria-label="Default intent" value="@(Value.DefaultIntent ?? "observe")" @onchange="e => Change(Value with { DefaultIntent = Text(e) })">@Options(Intents)</select></label>
  <label>Container flow<select aria-label="Container flow" value="@(Value.ContainerFlow ?? "stack")" @onchange="e => Change(Value with { ContainerFlow = Text(e) })">@Options(Flows)</select></label>
  <label>Collapse below<select aria-label="Collapse below" value="@Value.CollapseBelow" @onchange="e => Change(Value with { CollapseBelow = string.IsNullOrEmpty(Text(e)) ? null : Text(e) })"><option value="">No collapse</option>@foreach (var token in Tokens) { <option value="@token">@token</option> }</select></label>
  <label>Gap<select aria-label="Container gap" value="@(Value.Gap ?? 0)" @onchange="e => Change(Value with { Gap = int.Parse(Text(e), System.Globalization.CultureInfo.InvariantCulture) })">@foreach (var gap in Gaps) { <option value="@gap">@gap</option> }</select></label>
  <label>Density<select aria-label="Container density" value="@Value.Density" @onchange="e => Change(Value with { Density = string.IsNullOrEmpty(Text(e)) ? null : Text(e) })"><option value="">Default density</option><option value="comfortable">comfortable</option><option value="compact">compact</option></select></label>
  <fieldset><legend>Blocks</legend>@for (var index = 0; index < Value.Blocks.Count; index++) { var current = index; var block = Value.Blocks[index]; <div><select aria-label="@($"Block {current + 1} kind")" value="@block.Kind" @onchange="e => ChangeKind(current, block, Text(e))"><option value="">Choose a block</option>@Options(Kinds)</select>@if (block.Kind == "layout.dashboard-widget") { <select aria-label="@($"Block {current + 1} Helm widget")" value="@block.WidgetId" @onchange="e => Replace(current, block with { WidgetId = string.IsNullOrEmpty(Text(e)) ? null : Text(e) })"><option value="">Choose a registered widget</option>@Options(Catalogue.HelmWidgets ?? [])</select> }<select aria-label="@($"Block {current + 1} intent")" value="@(block.Intent ?? Value.DefaultIntent ?? "observe")" @onchange="e => Replace(current, WithIntent(block, Text(e)))">@Options(Intents)</select>@BindingPicker(current, block)@BlockStructure(current, block)@BlockBehaviour(current, block)<select aria-label="@($"Block {current + 1} zone")" value="@block.Zone" @onchange="e => Replace(current, block with { Zone = string.IsNullOrEmpty(Text(e)) ? null : Text(e) })"><option value="">No zone</option>@foreach (var zone in Catalogue.Zones) { <option value="@zone">@zone</option> }</select><select aria-label="@($"Block {current + 1} width")" value="@(block.Width ?? "hug")" @onchange="e => Replace(current, block with { Width = Text(e) })">@Options(Sizings)</select><select aria-label="@($"Block {current + 1} alignment")" value="@(block.AlignSelf ?? "stretch")" @onchange="e => Replace(current, block with { AlignSelf = Text(e) })">@Options(Alignments)</select><select aria-label="@($"Block {current + 1} static region")" value="@block.StaticRegion" @onchange="e => Replace(current, block with { StaticRegion = string.IsNullOrEmpty(Text(e)) ? null : Text(e) })"><option value="">Flow content</option>@foreach (var region in Catalogue.StaticRegions ?? []) { <option value="@region">@region</option> }</select><label><input aria-label="@($"Block {current + 1} break before")" type="checkbox" checked="@block.BreakBefore" @onchange="e => Replace(current, block with { BreakBefore = IsChecked(e) })" />Start page run on a new sheet</label><label><input aria-label="@($"Block {current + 1} avoid page break")" type="checkbox" checked="@block.AvoidPageBreak" @onchange="e => Replace(current, block with { AvoidPageBreak = IsChecked(e) })" />Keep row whole</label><button type="button" aria-label="@($"Remove block {current + 1}")" @onclick="() => Remove(current)">Remove</button></div> }<button type="button" @onclick="Add">Add block</button></fieldset>
  @if (Value.Medium == "page") { <fieldset><legend>Page runs</legend>@for (var index = 0; index < (Value.PageRuns?.Count ?? 0); index++) { var current = index; var run = Value.PageRuns![index]; <div><select aria-label="@($"Page run {current + 1} layout")" value="@run.PageLayoutId" @onchange="e => ReplaceRun(current, run with { PageLayoutId = Text(e) })">@Options(Catalogue.PageLayouts ?? [])</select><select aria-label="@($"Page run {current + 1} master")" value="@run.PageMasterId" @onchange="e => ReplaceRun(current, run with { PageMasterId = Text(e) })">@Options(Catalogue.PageMasters ?? [])</select><button type="button" @onclick="() => RemoveRun(current)">Remove run</button></div> }<button type="button" @onclick="AddRun">Add page run</button></fieldset> }
</form>
@code {
  private static readonly string[] Tokens = ["sm", "md", "lg"];
  private static readonly LayoutAuthoringOption[] Intents = [new("capture", "capture"), new("observe", "observe"), new("issue", "issue")];
  private static readonly LayoutAuthoringOption[] Flows = [new("stack", "stack"), new("flow", "flow"), new("areas", "areas")];
  private static readonly LayoutAuthoringOption[] Sizings = [new("hug", "hug"), new("fill", "fill"), new("fixed", "fixed")];
  private static readonly LayoutAuthoringOption[] Alignments = [new("start", "start"), new("center", "center"), new("end", "end"), new("stretch", "stretch")];
  private static readonly int[] Gaps = [0, 1, 2, 3, 4, 5, 6, 7, 8];
  private static readonly LayoutAuthoringOption[] BindingKinds = [new("record_field", "Record field"), new("query", "Query"), new("measure", "Measure"), new("template", "Template"), new("static", "Static content")];
  private static readonly HashSet<string> CanonicalKinds = ["layout.table", "layout.list", "layout.board", "layout.calendar", "layout.map", "layout.dashboard-widget", "layout.file-library"];
  [Parameter, EditorRequired] public LayoutAuthoringDraft Value { get; set; } = LayoutAuthoringDraft.Empty;
  [Parameter, EditorRequired] public LayoutAuthoringCatalogue Catalogue { get; set; } = new([], []);
  [Parameter] public EventCallback<LayoutAuthoringDraft> ValueChanged { get; set; }
  private IReadOnlyList<LayoutAuthoringOption> Kinds => Catalogue.BlockKinds.Where(kind => CanonicalKinds.Contains(kind.Id)).ToArray();
  private static string Text(ChangeEventArgs args) => args.Value?.ToString() ?? "";
  private static bool IsChecked(ChangeEventArgs args) => args.Value is bool value && value;
  private static void PreventSubmit() { }
  private Task Change(LayoutAuthoringDraft value) => ValueChanged.InvokeAsync(value);
  private Task Replace(int index, LayoutAuthoringBlock next) => Change(Value with { Blocks = Value.Blocks.Select((current, position) => position == index ? next : current).ToArray() });
  private Task ChangeKind(int index, LayoutAuthoringBlock block, string kind) => Replace(index, block with { Kind = kind, WidgetId = kind == "layout.dashboard-widget" ? block.WidgetId : null });
  private Task Remove(int index) => Change(Value with { Blocks = Value.Blocks.Where((_, position) => position != index).ToArray() });
  private Task Add() => Change(Value with { Blocks = [.. Value.Blocks, new($"block-{Value.Blocks.Count + 1}", Kinds.FirstOrDefault()?.Id ?? "layout.table")] });
  private Task ReplaceRun(int index, LayoutAuthoringPageRun next) => Change(Value with { PageRuns = (Value.PageRuns ?? []).Select((current, position) => position == index ? next : current).ToArray() });
  private Task RemoveRun(int index) => Change(Value with { PageRuns = (Value.PageRuns ?? []).Where((_, position) => position != index).ToArray() });
  private Task AddRun() => Change(Value with { PageRuns = [.. (Value.PageRuns ?? []), new($"run-{(Value.PageRuns?.Count ?? 0) + 1}", Catalogue.PageLayouts?.FirstOrDefault()?.Id ?? "", Catalogue.PageMasters?.FirstOrDefault()?.Id ?? "")] });
  /// <summary>
  /// Binds one block to a record field, query, measure, template or static content
  /// (layout-auth-13 to layout-auth-16). Changing the kind keeps the block and clears its
  /// name rather than deleting it, so an unbound block stays visible (layout-auth-31).
  /// </summary>
  private RenderFragment BindingPicker(int index, LayoutAuthoringBlock block) => builder =>
  {
    var sequence = 0;
    var label = $"Block {index + 1} binding";
    builder.OpenElement(sequence++, "select");
    builder.AddAttribute(sequence++, "aria-label", $"{label} kind");
    builder.AddAttribute(sequence++, "value", block.Binding?.Kind ?? "");
    builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => Rebind(index, block, Text(e))));
    builder.OpenElement(sequence++, "option");
    builder.AddAttribute(sequence++, "value", "");
    builder.AddContent(sequence++, "Needs a binding");
    builder.CloseElement();
    foreach (var kind in BindingKinds)
    {
      builder.OpenElement(sequence++, "option");
      builder.AddAttribute(sequence++, "value", kind.Id);
      builder.AddContent(sequence++, kind.Label);
      builder.CloseElement();
    }
    builder.CloseElement();

    if (block.Binding is { } binding)
    {
      if (binding.Kind == "static")
      {
        // Static content is authored on the block, so there is nothing to pick from.
        builder.OpenElement(sequence++, "input");
        builder.AddAttribute(sequence++, "aria-label", $"{label} content");
        builder.AddAttribute(sequence++, "value", binding.Name);
        builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => Replace(index, block with { Binding = binding with { Name = Text(e) } })));
        builder.CloseElement();
      }
      else
      {
        builder.OpenElement(sequence++, "select");
        builder.AddAttribute(sequence++, "aria-label", $"{label} name");
        builder.AddAttribute(sequence++, "value", binding.Name);
        builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => Replace(index, block with { Binding = binding with { Name = Text(e) } })));
        builder.OpenElement(sequence++, "option");
        builder.AddAttribute(sequence++, "value", "");
        builder.AddContent(sequence++, "Needs a binding");
        builder.CloseElement();
        var names = Catalogue.Bindables is { } bindables && bindables.TryGetValue(binding.Kind, out var offered) ? offered : [];
        foreach (var name in names)
        {
          builder.OpenElement(sequence++, "option");
          builder.AddAttribute(sequence++, "value", name.Id);
          builder.AddContent(sequence++, name.Label);
          builder.CloseElement();
        }
        builder.CloseElement();
      }

      if (binding.Name.Length == 0)
      {
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "role", "status");
        builder.AddContent(sequence++, $"Block {index + 1} needs a binding");
        builder.CloseElement();
      }
    }
  };

  // Rebinding keeps the block, clears the name, and stops a repeat the new kind cannot carry.
  private Task Rebind(int index, LayoutAuthoringBlock block, string kind)
    => Replace(index, block with { Binding = kind.Length == 0 ? null : new(kind, ""), Repeating = block.Repeating && CollectionKinds.Contains(kind) });

  // A block keeps only the members its intent admits: a related block observes (layout-auth-19)
  // and only a capture block carries capture properties (layout-auth-21).
  private static LayoutAuthoringBlock WithIntent(LayoutAuthoringBlock block, string intent)
    => block with { Intent = intent, RelatedRelationship = intent == "observe" ? block.RelatedRelationship : null, Capture = intent == "capture" ? block.Capture : null };

  // Sets capture members, dropping empty ones so an unnarrowed block carries no capture object.
  private static LayoutAuthoringBlock WithCapture(LayoutAuthoringBlock block, LayoutAuthoringCapture next)
    => block with { Capture = next.Required || next.ValidationRules is { Count: > 0 } || !string.IsNullOrEmpty(next.PromptOverride) ? next with { ValidationRules = next.ValidationRules is { Count: > 0 } ? next.ValidationRules : null, PromptOverride = string.IsNullOrEmpty(next.PromptOverride) ? null : next.PromptOverride } : null };

  private bool DeclaredRequired(LayoutAuthoringBlock block)
    => block.Binding is { Kind: "record_field" } binding && (Catalogue.RequiredFields ?? []).Contains(binding.Name);

  private static IReadOnlyList<string> Toggle(IReadOnlyList<string>? values, string value, bool on)
    => on ? [.. values ?? [], value] : (values ?? []).Where(current => current != value).ToArray();

  /// <summary>
  /// The block's behaviour on this surface. layout-auth-19: an observing block may traverse one
  /// Records relationship the catalogue declares, and stores only its key; the relationship
  /// declaration supplies the target, so the editor never asks for or writes one.
  /// layout-auth-20: show_when is a Rules expression, stored exactly as written; the shared
  /// engine compiles and evaluates it fail-closed, so the editor keeps no grammar of its own.
  /// layout-auth-21: a capture block may add a requirement and name registered validation rules;
  /// a requirement Records declares is shown and cannot be removed here. layout-auth-22: its prompt
  /// override is stored on the block, so it applies to this surface's context and nowhere else.
  /// layout-auth-33: the selection the block opens with is authored here; what a reader has
  /// selected at run time is execution state and is never offered for saving.
  /// </summary>
  private RenderFragment BlockBehaviour(int index, LayoutAuthoringBlock block) => @<text>@if ((block.Intent ?? Value.DefaultIntent ?? "observe") == "observe") { <select aria-label="@($"Block {index + 1} related record")" value="@(block.RelatedRelationship ?? "")" @onchange="e => Replace(index, block with { RelatedRelationship = string.IsNullOrEmpty(Text(e)) ? null : Text(e) })"><option value="">Not related</option>@Options(Catalogue.Relationships ?? [])</select> }<label>Default selection<input aria-label="@($"Block {index + 1} default selection")" value="@(block.DefaultSelection ?? "")" @onchange="e => Replace(index, block with { DefaultSelection = string.IsNullOrEmpty(Text(e)) ? null : Text(e) })" /></label><label>Show when<input aria-label="@($"Block {index + 1} show when")" value="@(block.ShowWhen ?? "")" @onchange="e => Replace(index, block with { ShowWhen = string.IsNullOrEmpty(Text(e)) ? null : Text(e) })" /></label>@if ((block.Intent ?? Value.DefaultIntent ?? "observe") == "capture") { var capture = block.Capture ?? new(); <label><input aria-label="@($"Block {index + 1} required")" type="checkbox" checked="@(DeclaredRequired(block) || capture.Required)" disabled="@DeclaredRequired(block)" @onchange="e => Replace(index, WithCapture(block, capture with { Required = IsChecked(e) }))" />Required</label><label>Prompt override<input aria-label="@($"Block {index + 1} prompt override")" value="@(capture.PromptOverride ?? "")" @onchange="e => Replace(index, WithCapture(block, capture with { PromptOverride = Text(e) }))" /></label>@foreach (var rule in Catalogue.ValidationRules ?? []) { <label><input aria-label="@($"Block {index + 1} validation rule {rule.Label}")" type="checkbox" checked="@((capture.ValidationRules ?? []).Contains(rule.Id))" @onchange="e => Replace(index, WithCapture(block, capture with { ValidationRules = Toggle(capture.ValidationRules, rule.Id, IsChecked(e)) }))" />@rule.Label</label> } }</text>;

  // layout-auth-18: only a collection can repeat, and a query or a record field is the collection.
  private static readonly HashSet<string> CollectionKinds = ["query", "record_field"];

  /// <summary>
  /// layout-auth-18: a repeating block binds a collection, and its row subtree is authored once
  /// as its children. A block can be placed inside any block but itself or its own descendant.
  /// </summary>
  private RenderFragment BlockStructure(int index, LayoutAuthoringBlock block) => @<text><select aria-label="@($"Block {index + 1} parent")" value="@(block.ParentId ?? "")" @onchange="e => Replace(index, block with { ParentId = string.IsNullOrEmpty(Text(e)) ? null : Text(e) })"><option value="">Surface root</option>@foreach (var (candidate, position) in Parents(block)) { <option value="@candidate.Id">@($"Block {position + 1}")</option> }</select>@if (block.Binding is { } binding && CollectionKinds.Contains(binding.Kind)) { <label><input aria-label="@($"Block {index + 1} repeats per row")" type="checkbox" checked="@block.Repeating" @onchange="e => Replace(index, block with { Repeating = IsChecked(e) })" />Repeats per row</label> }</text>;

  private IEnumerable<(LayoutAuthoringBlock Candidate, int Position)> Parents(LayoutAuthoringBlock block)
    => Value.Blocks.Select((candidate, position) => (candidate, position)).Where(pair => pair.candidate.Id != block.Id && !IsInside(pair.candidate, block.Id));

  // Whether block sits anywhere inside ancestorId, bounded so a malformed cycle cannot spin.
  private bool IsInside(LayoutAuthoringBlock block, string ancestorId)
  {
    LayoutAuthoringBlock? current = block;
    for (var step = 0; current?.ParentId is { } parent && step < Value.Blocks.Count; step++)
    {
      if (parent == ancestorId) return true;
      current = Value.Blocks.FirstOrDefault(candidate => candidate.Id == parent);
    }
    return false;
  }

  private static RenderFragment Options(IReadOnlyList<LayoutAuthoringOption> options) => builder => { var sequence = 0; foreach (var option in options) { builder.OpenElement(sequence++, "option"); builder.AddAttribute(sequence++, "value", option.Id); builder.AddContent(sequence++, option.Label); builder.CloseElement(); } };
}
