@namespace Harborline.UIAdapters.Blazor.Components.Forms
@inherits HarborlineComponentBase
@using System.Globalization
@using System.Text.RegularExpressions
@using Harborline.UIAdapters.Blazor.Localization

<div dir="@Direction" class="@CombineClasses("hl-numeric-text-box")" style="@CombineStyles()"
     data-disabled="@(Disabled ? "true" : null)" data-error="@(Error ? "true" : null)"
     data-fill-mode="@FillToken" data-readonly="@(ReadOnly ? "true" : null)"
     data-rounded="@RoundedToken" data-size="@SizeToken" @attributes="AdditionalAttributes">
    <input class="hl-numeric-text-box__input" id="@Id" name="@Name" type="text" inputmode="decimal" value="@DisplayedValue" placeholder="@Placeholder"
           disabled="@Disabled" readonly="@ReadOnly" required="@Required"
           aria-required="@(Required ? "true" : null)" aria-invalid="@(Error ? "true" : null)" aria-label="@AccessibleLabel"
           @onfocus="HandleFocusAsync" @oninput="HandleInput" @onblur="HandleBlurAsync" @onkeydown="HandleKeyDownAsync" />
    @if (Spinners && !ReadOnly)
    {
        <div class="hl-numeric-text-box__spinners">
            <button class="hl-numeric-text-box__spinner" type="button" aria-label="@ResolvedIncrementLabel" disabled="@(Disabled || AtMaximum)" @onclick="() => SpinAsync(1)"><span aria-hidden="true">▲</span></button>
            <button class="hl-numeric-text-box__spinner" type="button" aria-label="@ResolvedDecrementLabel" disabled="@(Disabled || AtMinimum)" @onclick="() => SpinAsync(-1)"><span aria-hidden="true">▼</span></button>
        </div>
    }
</div>

@code {
    private static readonly Regex StrictNumber = new(@"^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$", RegexOptions.CultureInvariant | RegexOptions.Compiled);
    [CascadingParameter] private HarborlineLocaleContext? LocaleContext { get; set; }
    [Parameter] public double? Value { get; set; }
    [Parameter] public double? DefaultValue { get; set; }
    [Parameter] public EventCallback<double?> ValueChanged { get; set; }
    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public int Decimals { get; set; } = 2;
    [Parameter] public string? Format { get; set; }
    [Parameter] public string? Locale { get; set; }
    [Parameter] public string Currency { get; set; } = "USD";
    [Parameter] public bool Spinners { get; set; } = true;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public NumericTextBoxSize Size { get; set; } = NumericTextBoxSize.Medium;
    [Parameter] public NumericTextBoxFillMode FillMode { get; set; } = NumericTextBoxFillMode.Solid;
    [Parameter] public NumericTextBoxRounded Rounded { get; set; } = NumericTextBoxRounded.Medium;
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? AccessibleLabel { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> Focused { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> Blurred { get; set; }
    [Parameter] public string? IncrementLabel { get; set; }
    [Parameter] public string? DecrementLabel { get; set; }

    private bool controlled;
    private bool initialized;
    private bool editing;
    private bool skipNextBlurCommit;
    private double? internalValue;
    private string rawValue = string.Empty;
    private double? Current => controlled ? Value : internalValue;
    private string DisplayedValue => editing ? rawValue : FormatValue(Current);
    private string Direction => LocaleContext?.Direction ?? "ltr";
    private string EffectiveLocale => Locale ?? LocaleContext?.Locale ?? "en";
    private string ResolvedIncrementLabel => LocaleContext?.ResolveString("forms.numeric.increment", instanceOverride: IncrementLabel) ?? IncrementLabel ?? "Increment";
    private string ResolvedDecrementLabel => LocaleContext?.ResolveString("forms.numeric.decrement", instanceOverride: DecrementLabel) ?? DecrementLabel ?? "Decrement";
    private bool AtMaximum => Max is double max && Current is double current && current >= max;
    private bool AtMinimum => Min is double min && Current is double current && current <= min;
    private string SizeToken => Size switch { NumericTextBoxSize.Small => "sm", NumericTextBoxSize.Large => "lg", _ => "md" };
    private string FillToken => FillMode.ToString().ToLowerInvariant();
    private string RoundedToken => Rounded.ToString().ToLowerInvariant();

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        controlled = parameters.TryGetValue<double?>(nameof(Value), out _);
        await base.SetParametersAsync(parameters);
        if (!initialized) { internalValue = DefaultValue; initialized = true; }
    }

    protected override void OnParametersSet()
    {
        if (Min is double min && !double.IsFinite(min) || Max is double max && !double.IsFinite(max)) throw new InvalidOperationException("invalid-bound");
        if (Min is double lower && Max is double upper && lower > upper) throw new InvalidOperationException("invalid-min-max");
        if (!double.IsFinite(Step) || Step <= 0) throw new InvalidOperationException("invalid-step");
        if (Decimals is < 0 or > 20) throw new InvalidOperationException("invalid-decimals");
        if (Current is double value && !double.IsFinite(value)) throw new InvalidOperationException("invalid-controlled-value");
    }

    private async Task HandleFocusAsync(FocusEventArgs args)
    {
        if (!ReadOnly && !Disabled) { editing = true; rawValue = Current?.ToString("R", CultureInfo.InvariantCulture) ?? string.Empty; }
        await Focused.InvokeAsync(args);
    }

    private void HandleInput(ChangeEventArgs args)
    {
        if (!Disabled && !ReadOnly) rawValue = args.Value?.ToString() ?? string.Empty;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (Disabled || ReadOnly) return;
        if (args.Key == "Enter")
        {
            skipNextBlurCommit = true;
            await CommitAsync();
        }
        else if (Spinners && args.Key == "ArrowUp" && !AtMaximum) await SpinAsync(1);
        else if (Spinners && args.Key == "ArrowDown" && !AtMinimum) await SpinAsync(-1);
    }

    private async Task HandleBlurAsync(FocusEventArgs args)
    {
        if (!Disabled && !ReadOnly)
        {
            if (skipNextBlurCommit) skipNextBlurCommit = false;
            else await CommitAsync();
        }
        editing = false;
        await Blurred.InvokeAsync(args);
    }

    private async Task CommitAsync()
    {
        var trimmed = rawValue.Trim();
        double? next = null;
        if (trimmed.Length > 0 && StrictNumber.IsMatch(trimmed) && double.TryParse(trimmed, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed) && double.IsFinite(parsed)) next = Clamp(parsed);
        if (!controlled) internalValue = next;
        editing = false;
        await ValueChanged.InvokeAsync(next);
    }

    private async Task SpinAsync(int direction)
    {
        if (Disabled || ReadOnly || direction > 0 && AtMaximum || direction < 0 && AtMinimum) return;
        var next = Clamp((Current ?? 0) + direction * Step);
        if (!controlled) internalValue = next;
        await ValueChanged.InvokeAsync(next);
    }

    private double Clamp(double value) => Math.Min(Max ?? double.PositiveInfinity, Math.Max(Min ?? double.NegativeInfinity, value));

    private string FormatValue(double? value)
    {
        if (value is null) return string.Empty;
        try
        {
            var culture = CultureInfo.GetCultureInfo(EffectiveLocale);
            if (Format is { Length: > 0 } format && (format[0] == 'c' || format[0] == 'p'))
            {
                var digits = format.Length > 1 && int.TryParse(format[1..], out var parsed) ? parsed : format[0] == 'c' ? 2 : 0;
                if (format[0] == 'c')
                {
                    var numberFormat = (NumberFormatInfo)culture.NumberFormat.Clone();
                    try
                    {
                        var region = new RegionInfo(culture.Name);
                        numberFormat.CurrencySymbol = string.Equals(region.ISOCurrencySymbol, Currency, StringComparison.OrdinalIgnoreCase)
                            ? culture.NumberFormat.CurrencySymbol
                            : Currency;
                    }
                    catch (ArgumentException) { numberFormat.CurrencySymbol = Currency; }
                    numberFormat.CurrencyDecimalDigits = digits;
                    return value.Value.ToString("C", numberFormat);
                }
                return value.Value.ToString($"P{digits}", culture);
            }
            return value.Value.ToString($"N{Decimals}", culture);
        }
        catch (CultureNotFoundException) { return value.Value.ToString("R", CultureInfo.InvariantCulture); }
    }
}
