@namespace Harborline.UIAdapters.Blazor.Components.Forms
@inherits HarborlineComponentBase

<input type="number" id="@Name" name="@Name" value="@Value" min="@Min" max="@Max" step="@Step" tabindex="@TabIndex"
       disabled="@EffectiveDisabled" required="@EffectiveRequired"
       aria-required="@(EffectiveRequired ? "true" : null)" aria-invalid="@(Error ? "true" : null)"
       aria-label="@AccessibleLabel" aria-labelledby="@FieldContext?.LabelId"
       aria-describedby="@(DescribedBy ?? FieldContext?.DescribedBy)"
       class="@CombineClasses("hl-number-field", Error ? "hl-number-field--error" : null, EffectiveDisabled ? "hl-number-field--disabled" : null)"
       style="@CombineStyles()" @oninput="OnInputAsync" @attributes="AdditionalAttributes" />

@code {
    [CascadingParameter] public FormFieldContextValue? FieldContext { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public double? Step { get; set; }
    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? AccessibleLabel { get; set; }
    [Parameter] public int? TabIndex { get; set; }
    [Parameter] public string? DescribedBy { get; set; }
    private bool EffectiveDisabled => Disabled || FieldContext?.Disabled == true;
    private bool EffectiveRequired => Required || FieldContext?.Required == true;
    private Task OnInputAsync(ChangeEventArgs args) => EffectiveDisabled ? Task.CompletedTask : ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}
