@namespace Harborline.UIAdapters.Blazor.Components.Layout
@inherits HarborlineComponentBase
<button type="@Type" class="@CombineClasses("hl-sheet__close")" style="@CombineStyles()" @onclick="DismissAsync" @attributes="AdditionalAttributes">@ChildContent</button>
@code {
    [CascadingParameter] public SheetContext? Context { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    private Task DismissAsync() => Context?.SetOpenAsync(false) ?? Task.CompletedTask;
}
