@namespace Harborline.UIAdapters.Blazor.Components.Layout

<CascadingValue Value="Context" IsFixed="false">@ChildContent</CascadingValue>

@code {
    [Parameter] public bool? Open { get; set; }
    [Parameter] public bool DefaultOpen { get; set; }
    [Parameter] public bool Modal { get; set; } = true;
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool localOpen;
    private bool initialized;
    private readonly string instanceId = $"hl-sheet-{Guid.NewGuid():N}";
    private SheetContext? context;
    private bool IsOpen => Open ?? localOpen;
    private SheetContext Context => context ??= new(() => IsOpen, SetOpenAsync, Modal, instanceId);

    protected override void OnParametersSet()
    {
        if (!initialized) { localOpen = DefaultOpen; initialized = true; }
        if (context is not null) context.Modal = Modal;
    }

    private async Task SetOpenAsync(bool next)
    {
        if (Open is null) localOpen = next;
        await OpenChanged.InvokeAsync(next);
        StateHasChanged();
    }
}
