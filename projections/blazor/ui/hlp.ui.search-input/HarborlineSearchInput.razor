@namespace Harborline.UIAdapters.Blazor.Components.Forms
@inherits HarborlineComponentBase
@using Harborline.UIAdapters.Blazor.Localization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div class="@CombineClasses("hl-search-input")" style="@CombineStyles()" dir="@(Direction ?? LocaleContext?.Direction)" aria-busy="@(busy ? "true" : "false")" @attributes="AdditionalAttributes">
  <svg aria-hidden="true" viewBox="0 0 20 20" class="hl-search-input__search"><circle cx="8" cy="8" r="5"/><path d="m12 12 5 5"/></svg>
  <input @ref="input" type="search" role="searchbox" value="@draft" placeholder="@ResolvedPlaceholder" aria-label="@ResolvedAccessibleLabel"
         class="hl-search-input__control" @oninput="HandleInputAsync" />
  @if (draft.Length > 0)
  {
    <button type="button" class="hl-search-input__clear" aria-label="@ResolvedClearLabel" @onclick="ClearAsync"><svg aria-hidden="true" viewBox="0 0 20 20"><path d="m5 5 10 10M15 5 5 15" /></svg></button>
  }
</div>

@code {
  [CascadingParameter] private HarborlineLocaleContext? LocaleContext { get; set; }
  [Parameter] public string Value { get; set; } = string.Empty;
  [Parameter] public EventCallback<string> ValueChanged { get; set; }
  [Parameter] public int DebounceMs { get; set; } = 200;
  [Parameter] public string? Placeholder { get; set; }
  [Parameter] public string? AccessibleLabel { get; set; }
  [Parameter] public string? ClearLabel { get; set; }
  [Parameter] public string? Direction { get; set; }

  private string draft = string.Empty;
  private string? lastHostValue;
  private bool busy;
  private bool disposed;
  private CancellationTokenSource? pending;
  private ElementReference input;
  private IJSObjectReference? module;
  private IJSObjectReference? escapeRegistration;
  private DotNetObjectReference<HarborlineSearchInput>? self;

  // Escape on a nonempty search is Clear: the browser's own search clearing would publish only after
  // the debounce, and an unhandled Escape would also close an enclosing overlay. search-input.js marks
  // the key handled on the input itself and calls back here; an empty search leaves Escape to the overlay.
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    // Disposal can happen during either await; whatever arrives afterwards is released here.
    try
    {
      self = DotNetObjectReference.Create(this);
      var imported = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Harborline.UIAdapters.Blazor/search-input.js");
      if (disposed) { if (imported is not null) await imported.DisposeAsync(); return; }
      module = imported;
      if (module is null) return;
      var registration = await module.InvokeAsync<IJSObjectReference>("observeEscape", input, self);
      if (disposed) { if (registration is not null) { await registration.InvokeVoidAsync("dispose"); await registration.DisposeAsync(); } return; }
      escapeRegistration = registration;
    }
    catch (JSException) { }
    catch (JSDisconnectedException) { }
    catch (InvalidOperationException) { }
    catch (TaskCanceledException) { }
  }

  // Called from JavaScript rather than a Blazor event handler, so it renders the cleared draft itself.
  [JSInvokable]
  public async Task ClearFromEscapeAsync()
  {
    if (draft.Length == 0 || disposed) return;
    await ClearAsync();
    if (!disposed) StateHasChanged();
  }
  // Caller text, then the host catalog, then the default catalog. Blank text at any step is no text, and a
  // catalog miss echoes the key, so neither the searchbox nor the clear button is ever unnamed.
  private string Copy(string key, string? caller)
  {
    if (!string.IsNullOrWhiteSpace(caller)) return caller;
    var fallback = Harborline.Foundation.Localization.HarborlineDefaultStrings.Get(key);
    var catalog = LocaleContext?.ResolveString(key) ?? fallback;
    return string.IsNullOrWhiteSpace(catalog) || catalog == key ? fallback : catalog;
  }
  private string ResolvedPlaceholder => Copy("structural.search.placeholder", Placeholder);
  // Blank caller text is not a name; fall back to the resolved placeholder so the searchbox is never unnamed.
  private string ResolvedAccessibleLabel => string.IsNullOrWhiteSpace(AccessibleLabel) ? ResolvedPlaceholder : AccessibleLabel;
  private string ResolvedClearLabel => Copy("structural.search.clear", ClearLabel);

  protected override void OnParametersSet()
  {
    if (DebounceMs < 0) throw new InvalidOperationException("invalid-debounce-delay");
    if (!string.Equals(lastHostValue, Value, StringComparison.Ordinal))
    {
      CancelPending();
      lastHostValue = Value;
      draft = Value;
      busy = false;
    }
  }

  private Task HandleInputAsync(ChangeEventArgs args)
  {
    draft = args.Value?.ToString() ?? string.Empty;
    CancelPending();
    var debounce = new CancellationTokenSource();
    pending = debounce;
    busy = true;
    _ = PublishAfterDelayAsync(draft, debounce);
    return Task.CompletedTask;
  }

  private async Task PublishAfterDelayAsync(string value, CancellationTokenSource debounce)
  {
    try
    {
      await Task.Delay(DebounceMs, debounce.Token).ConfigureAwait(false);
      await InvokeAsync(async () =>
      {
        if (disposed || debounce.IsCancellationRequested || !ReferenceEquals(pending, debounce)) return;
        await ValueChanged.InvokeAsync(value);
        if (disposed || debounce.IsCancellationRequested || !ReferenceEquals(pending, debounce)) return;
        pending = null;
        debounce.Dispose();
        busy = false;
        StateHasChanged();
      });
    }
    catch (OperationCanceledException) when (debounce.IsCancellationRequested)
    {
    }
  }

  private async Task ClearAsync()
  {
    CancelPending();
    draft = string.Empty;
    busy = false;
    // The clear control disappears with the draft; move keyboard focus to the searchbox before the
    // host handles the empty value, so an awaited host handler can neither drop focus to the page
    // nor have it pulled back later, and a host that removes the input cannot fault the focus.
    try { await input.FocusAsync(); }
    catch (JSException) { }
    catch (JSDisconnectedException) { }
    catch (InvalidOperationException) { }
    await ValueChanged.InvokeAsync(string.Empty);
  }

  private void CancelPending()
  {
    if (pending is null) return;
    pending.Cancel();
    pending.Dispose();
    pending = null;
  }

  protected override void Dispose(bool disposing)
  {
    disposed = true;
    CancelPending();
    base.Dispose(disposing);
  }

  // Blazor calls only DisposeAsync when a component has both, so it runs the synchronous cleanup too.
  public async ValueTask DisposeAsync()
  {
    Dispose();
    try
    {
      if (escapeRegistration is not null) { await escapeRegistration.InvokeVoidAsync("dispose"); await escapeRegistration.DisposeAsync(); }
      if (module is not null) await module.DisposeAsync();
    }
    catch (JSException) { }
    catch (JSDisconnectedException) { }
    catch (InvalidOperationException) { }
    catch (TaskCanceledException) { }
    finally { self?.Dispose(); }
  }
}
