     @if(docked){<button type="button" class="hl-app-shell__end-panel-control" data-panel-expand aria-pressed="@expanded.ToString().ToLowerInvariant()" aria-label="@(expanded?PanelRestoreLabel:PanelExpandLabel) @label" @onclick="()=>ToggleExpandedPanel(panel.Id)">⤢</button>}
     <button type="button" class="hl-app-shell__end-panel-control" data-panel-close data-sheet-close="@(docked?null:"true")" aria-label="Close @panel.Id" @onclick="()=>CloseDeclaredPanel(panel.Id)">×</button>
    </span>
