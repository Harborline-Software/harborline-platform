   @if(panel.Footer is not null){<div class="hl-app-shell__panel-footer" data-shell-panel-footer data-footer-kind="@panel.Footer.Kind">@if(panel.Footer.Binding is not null){<button type="button" class="hl-app-shell__panel-footer-action" @onclick="()=>BindingInvoked.InvokeAsync(panel.Footer.Binding)">@(ResolveLabel?.Invoke(panel.Footer.LabelKey)??panel.Footer.LabelKey)</button>}else{<span>@(ResolveLabel?.Invoke(panel.Footer.LabelKey)??panel.Footer.LabelKey)</span>}</div>}
