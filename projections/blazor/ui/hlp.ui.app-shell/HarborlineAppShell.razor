 private RenderFragment DockNodeFragment(DockNode node,double fraction=1)=>@<text>@if(node is DockSplit split){<div class="hl-app-shell__dock-split" style="flex:@Number(fraction) 1 0px;min-inline-size:@(Number(Minimum(node,true)))px" data-orientation="@split.Orientation" data-split-ratio="@split.Ratio">@DockNodeFragment(split.First,split.Ratio)@if(Minimum(split.First,split.Orientation=="horizontal")>0&&Minimum(split.Second,split.Orientation=="horizontal")>0){<DockDivider Vertical="@(split.Orientation=="horizontal")" Fraction="@split.Ratio" Minimum="@Minimum(split.First,split.Orientation=="horizontal")" SecondMinimum="@Minimum(split.Second,split.Orientation=="horizontal")" Changed="ratio=>ResizeDockNode(node,split with{Ratio=ratio})" Reset="ResetDock" />}else{<div class="hl-app-shell__dock-divider" aria-hidden="true"></div>}@DockNodeFragment(split.Second,1-split.Ratio)</div>}else if(node is DockPane pane){<div class="hl-app-shell__dock-pane" style="flex:@Number(fraction) 1 0px;min-inline-size:@(Number(Minimum(node,true)))px" data-shell-pane-scroll data-pane-minimum-sum="@pane.Panels.Sum(ShellChromeContract.PanelMinimumHeight)" data-stack-depth="@pane.Panels.Count" data-has-docked="@pane.Panels.Any(panel=>ContainerKind(panel)=="docked").ToString().ToLowerInvariant()">@for(var index=0;index<pane.Panels.Count;index++){var panel=pane.Panels[index];@PanelFragment(panel,pane.Fractions[index])@if(index==0&&pane.Panels.Count==2&&pane.Panels.All(p=>ContainerKind(p)=="docked")){<DockDivider Vertical="false" Fraction="@pane.Fractions[0]" Minimum="@ShellChromeContract.PanelMinimumHeight(panel)" SecondMinimum="@ShellChromeContract.PanelMinimumHeight(pane.Panels[1])" Changed="ratio=>ResizeDockNode(node,pane with{Fractions=new[]{ratio,1-ratio}})" Reset="ResetDock" />}}</div>}</text>;

