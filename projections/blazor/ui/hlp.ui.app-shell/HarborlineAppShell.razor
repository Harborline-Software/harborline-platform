 private RenderFragment PanelFragment(PackPanelDeclaration panel,double fraction)=>@<text>
  @{var kind=ContainerKind(panel);var docked=kind=="docked";var label=PanelLabel(panel);var form=ShellChromeContract.PanelHeaderForm(panel);
