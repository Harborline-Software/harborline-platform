@namespace Harborline.UIAdapters.Blazor.Components.Layout
@using Microsoft.AspNetCore.Components.Web
@{ var split=SplitPinned(Workspace,PinnedItemIds); var visibleGroups=split.Groups.Where(g=>g.Items.Count>0||g.AddAction is not null).ToArray(); }
<section class="hl-app-shell__zone" data-shell-zone="pinned" data-zone-cap="@PinCap" aria-label="@PinnedLabel">
 <div class="hl-app-shell__zone-label">@PinnedLabel</div>
 @if(split.Pinned.Count>0){@foreach(var item in (showAllPinned?split.Pinned:split.Pinned.Take(PinCap))){@Row(item,true)}}else{<p class="hl-app-shell__zone-empty">@Empty</p>}
 @if(!showAllPinned&&split.Pinned.Count>PinCap){<button type="button" class="hl-app-shell__show-more" @onclick="()=>showAllPinned=true">Show @(split.Pinned.Count-PinCap) more</button>}
</section>
@if(visibleGroups.Length>0){<section class="hl-app-shell__zone" data-shell-zone="groups" data-zone-cap="@GroupCap" aria-label="@GroupsLabel"><div class="hl-app-shell__zone-label">@GroupsLabel</div>@foreach(var group in visibleGroups){var expanded=expandedGroups.Contains(group.Id);<div class="hl-app-shell__group" data-group-id="@group.Id"><div class="hl-app-shell__group-label"><span>@group.Label</span>@if(group.AddAction is not null){<button type="button" class="hl-app-shell__group-add" aria-label="@group.AddAction.Label" @onclick="()=>BindingInvoked.InvokeAsync(group.AddAction.Binding)">+</button>}</div>@foreach(var item in (expanded?group.Items:group.Items.Take(GroupCap))){@Row(item,false)}@if(!expanded&&group.Items.Count>GroupCap){<button type="button" class="hl-app-shell__show-more" @onclick="()=>expandedGroups.Add(group.Id)">Show @(group.Items.Count-GroupCap) more</button>}</div>}</section>}

@code{
 [Parameter,EditorRequired]public ShellWorkspaceViewModel Workspace{get;set;}=null!;
 [Parameter]public string? ActiveItemId{get;set;}[Parameter]public IReadOnlyList<string> PinnedItemIds{get;set;}=[];[Parameter]public int PinCap{get;set;}=8;[Parameter]public int GroupCap{get;set;}=7;
 [Parameter]public EventCallback<string> BindingInvoked{get;set;}[Parameter]public EventCallback<ShellNavItem> Navigated{get;set;}[Parameter]public EventCallback<(string Id,bool Pinned)> PinToggled{get;set;}[Parameter]public EventCallback<ShellThreadEvent> ThreadActivated{get;set;}[Parameter]public EventCallback<ShellThreadActionEvent> ThreadActioned{get;set;}[Parameter]public EventCallback<ShellThreadRenameEvent> ThreadRenamed{get;set;}[Parameter]public EventCallback<ShellNavThread> ThreadRenameCancelled{get;set;}
 [Parameter]public string PinnedLabel{get;set;}="Pinned";[Parameter]public string Empty{get;set;}="Nothing pinned yet";[Parameter]public string GroupsLabel{get;set;}="Groups";
 private string? menuFor;private bool showAllPinned;private readonly HashSet<string> expandedGroups=[];private readonly Dictionary<string,string> renameValues=[];

 public static (IReadOnlyList<ShellNavItem> Pinned,IReadOnlyList<ShellGroupViewModel> Groups) SplitPinned(ShellWorkspaceViewModel workspace,IReadOnlyList<string> ids){var all=workspace.Groups.SelectMany(g=>g.Items).ToDictionary(i=>i.Id);var pinned=ids.Where(all.ContainsKey).Select(id=>all[id]).ToArray();var set=pinned.Select(i=>i.Id).ToHashSet();return(pinned,workspace.Groups.Select(g=>g with{Items=g.Items.Where(i=>!set.Contains(i.Id)).ToArray()}).ToArray());}

 private RenderFragment Row(ShellNavItem item,bool pinned)=>b=>{
  var s=0;b.OpenElement(s++,"div");b.AddAttribute(s++,"class","hl-app-shell__rail-row");b.AddAttribute(s++,"data-shell-row",true);
  b.OpenElement(s++,"a");b.AddAttribute(s++,"href",ShellChromeContract.Address(item.Kind??"workspaces",item.Id));b.AddAttribute(s++,"class","hl-app-shell__rail-link");if(item.Id==ActiveItemId)b.AddAttribute(s++,"aria-current","page");b.AddAttribute(s++,"onclick",EventCallback.Factory.Create(this,()=>Navigated.InvokeAsync(item)));b.OpenElement(s++,"span");b.AddAttribute(s++,"class","hl-app-shell__rail-label");b.AddContent(s++,item.Label);b.CloseElement();if(item.Count is not null){b.OpenElement(s++,"span");b.AddAttribute(s++,"class","hl-app-shell__count");b.AddAttribute(s++,"data-shell-count",true);b.AddContent(s++,item.Count);b.CloseElement();}b.CloseElement();
  if(item.Pinnable){b.OpenElement(s++,"button");b.AddAttribute(s++,"type","button");b.AddAttribute(s++,"class","hl-app-shell__pin-toggle");b.AddAttribute(s++,"aria-label",$"{(pinned?"Unpin":"Pin")} {item.Label}");b.AddAttribute(s++,"onclick",EventCallback.Factory.Create(this,()=>TogglePin(item.Id,pinned)));b.AddEventStopPropagationAttribute(s++,"onclick",true);b.AddMarkupContent(s++,"<svg aria-hidden=\"true\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><path d=\"M12 17v5M9 10.76V6h6v4.76L19 15v1H5v-1z\" /></svg>");b.CloseElement();}
  if(item.Threads?.Count>0)b.AddContent(s++,Threads(item.Threads,item.Id));b.CloseElement();
 };
 private Task TogglePin(string id,bool pinned){if(!pinned&&PinnedItemIds.Count>=PinCap)return Task.CompletedTask;return PinToggled.InvokeAsync((id,!pinned));}

 private RenderFragment Threads(IReadOnlyList<ShellNavThread> threads,string owner)=>b=>{var s=0;b.OpenElement(s++,"div");b.AddAttribute(s++,"class","hl-app-shell__threads");foreach(var thread in threads){b.OpenElement(s++,"div");b.AddAttribute(s++,"class","hl-app-shell__thread-row");if(thread.Editing){if(!renameValues.ContainsKey(thread.Id))renameValues[thread.Id]=thread.Label;b.OpenElement(s++,"input");b.AddAttribute(s++,"class","hl-app-shell__thread-rename");b.AddAttribute(s++,"aria-label",$"Rename {thread.Label}");b.AddAttribute(s++,"value",renameValues[thread.Id]);b.AddAttribute(s++,"oninput",EventCallback.Factory.Create<ChangeEventArgs>(this,e=>renameValues[thread.Id]=e.Value?.ToString()??""));b.AddAttribute(s++,"onkeydown",EventCallback.Factory.Create<KeyboardEventArgs>(this,e=>RenameKey(e,thread)));b.CloseElement();}else{b.OpenElement(s++,"button");b.AddAttribute(s++,"type","button");b.AddAttribute(s++,"class","hl-app-shell__thread-btn");if(thread.Active)b.AddAttribute(s++,"data-active","true");b.AddAttribute(s++,"title",thread.Label);b.AddAttribute(s++,"onclick",EventCallback.Factory.Create(this,()=>ThreadActivated.InvokeAsync(new(thread,owner))));b.OpenElement(s++,"span");b.AddAttribute(s++,"class","hl-app-shell__thread-label");b.AddContent(s++,thread.Label);b.CloseElement();b.CloseElement();}if(thread.Actions?.Count>0){b.OpenElement(s++,"button");b.AddAttribute(s++,"type","button");b.AddAttribute(s++,"class","hl-app-shell__kebab");b.AddAttribute(s++,"aria-label","Session options");b.AddAttribute(s++,"aria-haspopup","menu");b.AddAttribute(s++,"aria-expanded",(menuFor==thread.Id).ToString().ToLowerInvariant());b.AddAttribute(s++,"onclick",EventCallback.Factory.Create(this,()=>menuFor=menuFor==thread.Id?null:thread.Id));b.AddContent(s++,"⋮");b.CloseElement();if(menuFor==thread.Id){b.OpenElement(s++,"div");b.AddAttribute(s++,"role","menu");b.AddAttribute(s++,"class","hl-app-shell__row-menu");foreach(var action in thread.Actions.Where(a=>!a.Destructive).Concat(thread.Actions.Where(a=>a.Destructive))){b.OpenElement(s++,"button");b.AddAttribute(s++,"type","button");b.AddAttribute(s++,"role","menuitem");b.AddAttribute(s++,"class","hl-app-shell__row-menu-item");if(action.Destructive)b.AddAttribute(s++,"data-destructive","true");b.AddAttribute(s++,"onclick",EventCallback.Factory.Create(this,()=>Action(thread,action.Id)));b.AddContent(s++,action.Label);b.CloseElement();}b.CloseElement();}}b.CloseElement();}b.CloseElement();};
 private async Task Action(ShellNavThread thread,string id){menuFor=null;await ThreadActioned.InvokeAsync(new(thread,id));}
 private Task RenameKey(KeyboardEventArgs e,ShellNavThread thread)=>e.Key=="Enter"?ThreadRenamed.InvokeAsync(new(thread,renameValues[thread.Id])):e.Key=="Escape"?ThreadRenameCancelled.InvokeAsync(thread):Task.CompletedTask;
}
