@namespace Harborline.UIAdapters.Blazor.Components.Layout
@using System.Globalization
@using System.Text.Json
@using Harborline.UIAdapters.Blazor.Components.DataDisplay
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="root" class="hl-app-shell-rev6-frame" data-shell-id="@ShellId" data-revision="6" data-form="@form" data-panel-placement="@placement" data-frame-owner="@OwnerScope" data-panel-open="@(PanelVisible ? "true" : "false")" data-frame-controlled-panel-open="@(current?.PanelOpen == true ? "true" : "false")" data-frame-active="@current?.Tabs.Active" data-focus-mode="@(current?.FocusMode == true ? "true" : "false")" style="@GeometryStyle">
 @if (current is null)
 {
  <main @ref="main" tabindex="-1" aria-label="Workspace"><p>No current workspace presentation.</p></main>
 }
 else
 {
  var shown = current;
  var dirty = shown.Tabs.PendingClose is not null;
  <div data-frame-background inert="@(dirty || phoneNavigationOpen ? "" : null)" aria-hidden="@(dirty || phoneNavigationOpen ? "true" : null)">
   @if (form != "phone" && !shown.FocusMode)
   {
    @Navigation(shown, false)
   }
   @if (shown.Sidebar is not null && !shown.FocusMode && (form == "unmeasured" || sidebarWidth > 0))
   {
    <aside class="hl-rev6-sidebar" aria-label="@shown.Sidebar.Title" data-shell-scroll-region>
     @Sidebar(shown)
    </aside>
   }
   <div class="hl-rev6-workspace">
    <header class="hl-rev6-header">
     @if (form == "phone" && !shown.FocusMode)
     {
      <button type="button" data-navigation-trigger aria-label="Open navigation" aria-expanded="@(phoneNavigationOpen ? "true" : "false")" aria-controls="@drawerId" @onclick="() => OpenNavigation(shown.Owner)">@Icon("menu")</button>
     }
     <div class="hl-rev6-location"><strong>@shown.Header.Title</strong><span>@shown.Header.Breadcrumb</span></div>
     <button type="button" class="hl-rev6-search" aria-label="@shown.Header.SearchLabel" title="@shown.Header.SearchLabel" @onclick='() => Command(shown.Owner, "search")'>@Icon("search")<span>@shown.Header.SearchPlaceholder</span></button>
     <div class="hl-rev6-actions">
      @foreach (var action in shown.Header.Actions)
      {
       <button @key="action.Id" type="button" disabled="@(!action.Enabled)" title="@action.DisabledReason" aria-describedby="@(action.DisabledReason is null ? null : ActionReasonId(action.Id))" @onclick="() => Request(shown.Owner, new AppShellRev6FrameActionRequested(shown.Owner, action.Id))">@action.Label</button>
       @if (action.DisabledReason is not null) { <span class="hl-rev6-sr" id="@ActionReasonId(action.Id)">@action.DisabledReason</span> }
      }
      <button type="button" data-panel-toggle aria-label="@(PanelVisible ? "Hide side panel" : "Show side panel")" aria-expanded="@(PanelVisible ? "true" : "false")" aria-controls="@panelId" @onclick="() => SetPanel(shown.Owner, !PanelVisible)">@Icon("panel")</button>
      @if (shown.FocusMode) { <button type="button" @onclick='() => Command(shown.Owner, "exit-focus")'>Exit focus</button> }
     </div>
    </header>
    <main @ref="main" class="hl-rev6-main" tabindex="-1" aria-label="@shown.MainFace.AccessibleLabel" data-shell-scroll-region>
     @if (Supported(shown.MainFace))
     {
      <HarborlineViewRuntime @key="shown.Owner" Plan="@(shown.MainFace.Plan!)" Rows="@(shown.MainFace.Rows!)" AccessibleLabel="@shown.MainFace.AccessibleLabel" Empty="@shown.MainFace.Empty" ActionsDisabled="shown.MainFace.ActionsDisabled"
       OnRowActivate="@(id => Request(shown.Owner, new AppShellRev6FrameRowActivated(shown.Owner, id)))" OnAction="@(id => Request(shown.Owner, new AppShellRev6FrameActionRequested(shown.Owner, id)))" />
     }
     else { <p data-unsupported-face>No supported view is available.</p> }
    </main>
   </div>
   @if (PanelVisible && (placement == "float" || placement == "sheet"))
   {
    <button type="button" class="hl-rev6-panel-scrim" tabindex="-1" aria-label="Dismiss side panel" data-panel-close @onclick="() => SetPanel(shown.Owner, false)"></button>
   }
   <aside class="hl-rev6-panel" id="@panelId" aria-label="Workspace tabs" hidden="@(!PanelVisible)" aria-hidden="@(!PanelVisible ? "true" : null)">
    <HarborlineAppShellRev6TabSurface @key="shown.Owner" ShellId="@ShellId" Owner="shown.Owner" Presentation="shown.Tabs" Intent="@(value => ForwardTab(shown.Owner, value))" TabContent="TabContent" EmptyFallback="main" ManageCloseRecovery="false" SuppressDialog="true" />
    <div class="hl-rev6-panel-actions">
     <button type="button" aria-label="New panel tab" @onclick='() => Command(shown.Owner, "new-tab")'>@Icon("plus")</button>
     <button type="button" aria-label="Hide side panel" data-panel-close @onclick="() => SetPanel(shown.Owner, false)">@Icon("close")</button>
    </div>
   </aside>
  </div>
  @if (phoneNavigationOpen && !dirty)
  {
   <div class="hl-rev6-drawer-scrim" data-drawer-dismiss @onclick="() => CloseNavigation(shown.Owner)"></div>
   <div id="@drawerId" role="dialog" aria-modal="true" aria-label="Navigation" class="hl-rev6-drawer" data-navigation-dialog>
    <button type="button" data-drawer-dismiss aria-label="Close navigation" @onclick="() => CloseNavigation(shown.Owner)">@Icon("close")</button>
    @Navigation(shown, true)
   </div>
  }
  @if (dirty)
  {
   <div class="hl-rev6-dirty-scrim" aria-hidden="true"></div>
   <HarborlineAppShellRev6DirtyCloseDialog @key="shown.Owner" Presentation="shown.Tabs" TitleId="@dialogTitle" Intent="@(value => ResolveClose(shown.Owner, value))" />
  }
 }
</div>

<style>
 .hl-app-shell-rev6-frame { position: relative; isolation: isolate; inline-size: 100%; block-size: 100%; min-inline-size: 0; min-block-size: 0; overflow: hidden; color: var(--color-foreground, var(--hl-foreground, #202123)); background: var(--color-background, var(--hl-surface, #fff)); font: 12px/1.4 Inter, ui-sans-serif, system-ui, sans-serif; }
 .hl-app-shell-rev6-frame *, .hl-app-shell-rev6-frame *::before, .hl-app-shell-rev6-frame *::after { box-sizing: border-box; }
 .hl-app-shell-rev6-frame [data-frame-background] { display: grid; grid-template-columns: var(--frame-rail) var(--frame-sidebar) minmax(0, 1fr) var(--frame-panel); block-size: 100%; min-inline-size: 0; min-block-size: 0; }
 .hl-app-shell-rev6-frame [hidden] { display: none !important; }
 .hl-app-shell-rev6-frame button, .hl-app-shell-rev6-frame a, .hl-app-shell-rev6-frame input, .hl-app-shell-rev6-frame textarea { font: inherit; }
 .hl-app-shell-rev6-frame button, .hl-app-shell-rev6-frame a { color: inherit; }
