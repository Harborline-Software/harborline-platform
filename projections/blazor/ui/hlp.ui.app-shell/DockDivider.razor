@namespace Harborline.UIAdapters.Blazor.Components.Layout
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
<div @ref="element" class="hl-app-shell__dock-divider" role="separator" tabindex="0" aria-label="Resize panels" aria-description="Arrow keys resize; Shift uses larger steps. Enter commits, Escape cancels, 0 resets panels." aria-orientation="@(Vertical?"vertical":"horizontal")" aria-valuemin="@Number(Minimum)" aria-valuemax="@Number(Maximum)" aria-valuenow="@Number(Value)" @onkeydown="KeyDown" @onblur="()=>Finish(false)" @onpointerdown="Start" @onpointermove="Move" @onpointerup="CommitPointer" @onpointercancel="CancelPointer" @onlostpointercapture="CancelPointer"></div>
@code {
    [Parameter] public bool Vertical {get;set;}
    [Parameter] public double Fraction {get;set;}
    [Parameter] public double Minimum {get;set;}
    [Parameter] public double SecondMinimum {get;set;}
    [Parameter] public EventCallback<double> Changed {get;set;}
    [Parameter] public EventCallback Reset {get;set;}
    private ElementReference element;
    private IJSObjectReference? module;
    private IJSObjectReference? connection;
    private bool disposed;
    private DotNetObjectReference<DockDivider>? reference;
    private double extent, direction=1;
    private double? startFraction, startPosition;
    private long? pointer;
    private double Total=>Math.Max(extent,Minimum+SecondMinimum);
    private double Maximum=>Total-SecondMinimum;
    private double Value=>Math.Clamp(Fraction*Total,Minimum,Maximum);
    private static string Number(double value)=>value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if(!first||disposed)return;
        var imported=await JS.InvokeAsync<IJSObjectReference>("import","./_content/Harborline.UIAdapters.Blazor/dock-divider.js");
        if(disposed){await DisposeModule(imported);return;}
        module=imported;
        reference=DotNetObjectReference.Create(this);
        var measured=await module.InvokeAsync<double>("measure",element,Vertical);
        if(disposed)return;
        extent=measured;
        var observed=await module.InvokeAsync<IJSObjectReference>("observe",element,Vertical,reference);
        if(disposed){await DisposeConnection(observed);return;}
        connection=observed;
        await InvokeAsync(()=>{if(!disposed)StateHasChanged();});
    }
    [JSInvokable] public Task Measure(double size)=>disposed?Task.CompletedTask:InvokeAsync(()=>{if(disposed)return;extent=size;StateHasChanged();});
    private Task Update(double next)=>disposed?Task.CompletedTask:Changed.InvokeAsync(Math.Clamp(next,Minimum,Maximum)/Total);
    private async Task Finish(bool cancel){if(disposed)return;var start=startFraction;startFraction=null;startPosition=null;pointer=null;if(cancel&&start.HasValue)await Changed.InvokeAsync(start.Value);}
    private async Task Start(PointerEventArgs e){if(disposed||e.Button!=0||pointer.HasValue)return;startFraction=Fraction;startPosition=Vertical?e.ClientX:e.ClientY;pointer=e.PointerId;if(module is not null){var measuredDirection=await module.InvokeAsync<double>("direction",element);if(!disposed)direction=measuredDirection;}}
    private Task Move(PointerEventArgs e)=>pointer==e.PointerId&&startPosition.HasValue?Update(startFraction!.Value*Total+(Vertical?direction:1)*((Vertical?e.ClientX:e.ClientY)-startPosition.Value)):Task.CompletedTask;
    private Task CancelPointer(PointerEventArgs e)=>pointer==e.PointerId?Finish(true):Task.CompletedTask;
    private Task CommitPointer(PointerEventArgs e)=>pointer==e.PointerId?Finish(false):Task.CompletedTask;
    // No @onkeydown:stopPropagation. The directive is a render-time flag and cannot vary per key, so
    // an unconditional stop swallowed every shell shortcut (Mod+K, Mod+\, Mod+N, Mod+Shift+I, Mod+1..9)
    // while a divider had focus. The handled set below is the divider's own authority and holds no
    // Mod+ combination, so nothing the shell owns needs swallowing here; the pass-through set is
    // pinned by conformance/hlp.ui.app-shell/dividers-v1.json and asserted in both shells. Browser
    // defaults for the handled keys are still suppressed, in dock-divider.js, where React uses
    // preventDefault for the same purpose.
    private async Task KeyDown(KeyboardEventArgs e)
    {
        // Dividers handle BARE keys only. A Mod chord on a focused divider is the shell's (Mod+Enter, Mod+0,
        // Mod+K...), so it must not be consumed here — the React mirror is DockDivider.tsx keyDown.
        if(disposed||e.CtrlKey||e.MetaKey||e.AltKey)return;
        if(e.Key=="0"){await Finish(false);if(!disposed)await Reset.InvokeAsync();return;}
        if(e.Key is "Enter" or "Escape"){await Finish(e.Key=="Escape");return;}
        var increase=Vertical?"ArrowRight":"ArrowDown";var decrease=Vertical?"ArrowLeft":"ArrowUp";
        if(e.Key!=increase&&e.Key!=decrease&&e.Key is not ("Home" or "End"))return;
        startFraction??=Fraction;
        await Update(e.Key=="Home"?Minimum:e.Key=="End"?Maximum:Value+(e.Key==increase?1:-1)*(e.ShiftKey?32:8));
    }
    private static async ValueTask DisposeConnection(IJSObjectReference? resource)
    {
        if(resource is null)return;
        try{try{await resource.InvokeVoidAsync("dispose");}finally{await resource.DisposeAsync();}}
        catch(JSDisconnectedException){}
    }
    private static async ValueTask DisposeModule(IJSObjectReference resource){try{await resource.DisposeAsync();}catch(JSDisconnectedException){}}
    public async ValueTask DisposeAsync()
    {
        if(disposed)return;
        disposed=true;
        try{await DisposeConnection(connection);if(module is not null)await DisposeModule(module);}
        finally{reference?.Dispose();}
    }
}
