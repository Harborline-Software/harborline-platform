@namespace Harborline.UIAdapters.Blazor.Components.Forms
@using Harborline.UIAdapters.Blazor.Components.Forms.Inputs
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

@if (Editor == "none" || Members.Count == 0)
{
    <output id="@Args.Field.Name" aria-disabled="true" aria-labelledby="@Args.LabelId"></output>
}
else if (Editor == "radiogroup")
{
    <HarborlineRadioGroup Name="@Args.Field.Name" Value="@SelectedValue" Options="@RadioOptions"
                         ValueChanged="@SelectAsync" Disabled="@Args.Disabled" Required="@Args.Required"
                         Error="@Args.HasError" LabelledBy="@Args.LabelId" DescribedBy="@Args.DescribedBy" />
}
else if (Editor is "singlevalue" or "choicelist")
{
    <HarborlineSelectField Name="@Args.Field.Name" Value="@SelectedValue" Options="@SelectOptions"
                          ValueChanged="@SelectAsync" Disabled="@Args.Disabled" Required="@Args.Required"
                          Error="@Args.HasError" />
}
else if (Editor is "recordpicker" or "taxonomypicker")
{
    <div class="hl-schema-form__domain-picker" data-domain-search="local">
        <input @ref="input" id="@Args.Field.Name" name="@Args.Field.Name" role="combobox" type="text"
               aria-autocomplete="list" aria-expanded="@open.ToString().ToLowerInvariant()"
               aria-controls="@ListId" aria-activedescendant="@ActiveId" aria-labelledby="@Args.LabelId"
               aria-describedby="@Args.DescribedBy" aria-invalid="@(Args.HasError ? "true" : null)"
               aria-required="@(Args.Required ? "true" : null)" disabled="@Args.Disabled"
               value="@query" autocomplete="off" @oninput="Search" @onkeydown="KeyDownAsync"
               @onfocus="Open" data-hl-domain-picker="true" />
        @if (open)
        {
            <div id="@ListId" role="listbox" aria-labelledby="@Args.LabelId">
                @for (var index = 0; index < matches.Count; index++)
                {
                    var member = matches[index];
                    <button id="@(ListId + "-" + index)" role="option" type="button" tabindex="-1"
                            data-active="@(index == active ? "true" : null)"
                            aria-selected="@(Args.Value is string selected && selected == member ? "true" : "false")"
                            disabled="@Args.Disabled" @onclick="() => SelectAsync(member)">@member</button>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public SchemaFormControlArgs Args { get; set; } = default!;
    private string Editor => Args.Field.ControlHint?.ToLowerInvariant() ?? "none";
    private IReadOnlyList<string> Members => Args.Field.PermittedValues ?? [];
    private string SelectedValue => Args.Value is string value && Members.Contains(value, StringComparer.Ordinal) ? value : null!;
    private IReadOnlyList<HarborlineRadioOption> RadioOptions => Members.Select(value => new HarborlineRadioOption(value, value)).ToArray();
    private IReadOnlyList<SelectOption> SelectOptions => Members.Select(value => new SelectOption(value, value)).ToArray();
    private string ListId { get; } = "hl-domain-" + Guid.NewGuid().ToString("N");
    private string? ActiveId => open && active >= 0 && active < matches.Count ? ListId + "-" + active : null;
    private string query = "";
    private string? previousValue;
    private IReadOnlyList<string>? previousMembers;
    private IReadOnlyList<string> matches = [];
    private bool open;
    private int active = -1;
    private ElementReference input;
    private IJSObjectReference? module;
    private IJSObjectReference? keyboardBinding;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Editor is "recordpicker" or "taxonomypicker" && Members.Count > 0 && keyboardBinding is null)
        {
            module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Harborline.UIAdapters.Blazor/schema-form.js");
            keyboardBinding = await module.InvokeAsync<IJSObjectReference>("bindDomainPicker", input);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (keyboardBinding is not null)
            {
                await keyboardBinding.InvokeVoidAsync("dispose");
                await keyboardBinding.DisposeAsync();
            }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    protected override void OnParametersSet()
    {
        if (previousValue != SelectedValue || !ReferenceEquals(previousMembers, Members))
        {
            query = SelectedValue ?? "";
            previousValue = SelectedValue;
            previousMembers = Members;
            open = false;
            active = -1;
            matches = [];
        }
    }

    private void Open()
    {
        if (Args.Disabled) return;
        open = true;
        matches = Members.Where(value => value.Contains(query, StringComparison.OrdinalIgnoreCase)).Take(25).ToArray();
    }

    private void Search(ChangeEventArgs change)
    {
        if (Args.Disabled) return;
        query = change.Value?.ToString() ?? "";
        active = -1;
        Open();
    }

    private async Task KeyDownAsync(KeyboardEventArgs key)
    {
        if (Args.Disabled) return;
        if (key.Key is "Escape" or "Tab") { open = false; active = -1; return; }
        if (key.Key is "ArrowDown" or "ArrowUp")
        {
            Open();
            if (matches.Count > 0)
                active = key.Key == "ArrowDown" ? (active + 1) % matches.Count
                    : active <= 0 ? matches.Count - 1 : active - 1;
        }
        else if (key.Key == "Enter" && open && active >= 0 && active < matches.Count)
            await SelectAsync(matches[active]);
    }

    private async Task SelectAsync(string member)
    {
        if (Args.Disabled || !Members.Contains(member, StringComparer.Ordinal)) return;
        query = member;
        open = false;
        active = -1;
        await Args.ValueChanged.InvokeAsync(member);
    }
}
