@namespace Harborline.UIAdapters.Blazor.Components.DataExchange
@* Inline siblings stay contiguous: Razor whitespace changes their wrapping relative to React. *@
<form class="hl-data-exchange-authoring" @onsubmit="PreventSubmit">@if (_incoming is not null) { <aside role="alert">Revision changed.<button type="button" @onclick="KeepEdits">Keep edits</button><button type="button" @onclick="DiscardEdits">Discard edits</button></aside> }<label>Definition name<input disabled="@ReadOnly" aria-label="Definition name" value="@Current.Name" @onchange="e => Change(Current with { Name = Text(e) })" /></label><fieldset><legend>Source</legend><label>Source capability<select disabled="@ReadOnly" aria-label="Source capability" value="@Current.SourceCapability" @onchange="e => Change(Current with { SourceCapability = Text(e) })"><option value="">Choose a capability</option>@Options(Catalogue.SourceCapabilities)</select></label><label>Connector version<input disabled="@ReadOnly" aria-label="Connector version" value="@Current.ConnectorVersion" @onchange="e => Change(Current with { ConnectorVersion = Text(e) })" /></label><label>Format<select disabled="@ReadOnly" aria-label="Format" value="@Current.FormatCapability" @onchange="e => Change(Current with { FormatCapability = Text(e) })"><option value="">Choose a format</option>@Options(Catalogue.Formats)</select></label><label>Secret reference<input disabled="@ReadOnly" aria-label="Secret reference" value="@Current.SecretReference" @onchange="e => Change(Current with { SecretReference = Text(e) })" /></label><button type="button" disabled="@(!IntentsEnabled)" @onclick="Discover">Discover source</button></fieldset><fieldset><legend>Discovered source shape</legend>@if (Current.DiscoveredColumns.Count == 0) { <p>No source columns discovered.</p> }@for (var index = 0; index < Current.DiscoveredColumns.Count; index++) { var current = index; var column = Current.DiscoveredColumns[current]; <label><input type="checkbox" disabled="@ReadOnly" aria-label="@($"Include {column.Name}")" checked="@column.Selected" @onchange="e => SelectColumn(current, e.Value is true)" />@column.Name</label> }</fieldset><fieldset><legend>Mapping profile</legend><dl><dt>Profile</dt><dd>@MappingProfile</dd><dt>Schema</dt><dd>@MappingSchema</dd><dt>Document version</dt><dd>@MappingVersion</dd></dl></fieldset><fieldset><legend>Canonical mappings</legend>
    @if (Current.Mappings.Count == 0) { <p>No mappings authored.</p> }@for (var index = 0; index < Current.Mappings.Count; index++) { var current = index; var mapping = Current.Mappings[current]; <div><select disabled="@ReadOnly" aria-label="@($"Mapping {current + 1} source column")" value="@mapping.SourceColumn" @onchange="e => ReplaceMapping(current, mapping with { SourceColumn = Text(e) })"><option value="">Choose source column</option>@SourceOptions()</select><select disabled="@ReadOnly" aria-label="@($"Mapping {current + 1} canonical target")" value="@mapping.CanonicalTarget" @onchange="e => ReplaceMapping(current, mapping with { CanonicalTarget = Text(e) })"><option value="">Choose canonical target</option>@Options(Catalogue.CanonicalTargets)</select><input disabled="@ReadOnly" aria-label="@($"Mapping {current + 1} target pointer")" value="@mapping.TargetPointer" @onchange="e => ReplaceMapping(current, mapping with { TargetPointer = Text(e) })" /><select disabled="@ReadOnly" aria-label="@($"Mapping {current + 1} datatype")" value="@mapping.Datatype" @onchange="e => ReplaceMapping(current, mapping with { Datatype = Text(e) })">@Options(Catalogue.Datatypes)</select><label><input type="checkbox" disabled="@ReadOnly" aria-label="@($"Mapping {current + 1} required")" checked="@mapping.Required" @onchange="e => ReplaceMapping(current, mapping with { Required = e.Value is true })" />Required</label><input disabled="@ReadOnly" aria-label="@($"Mapping {current + 1} null")" value="@mapping.NullValue" @onchange="e => ReplaceMapping(current, mapping with { NullValue = Text(e) })" /><input disabled="@ReadOnly" aria-label="@($"Mapping {current + 1} default")" value="@mapping.DefaultValue" @onchange="e => ReplaceMapping(current, mapping with { DefaultValue = Text(e) })" /><input disabled="@ReadOnly" aria-label="@($"Mapping {current + 1} separator")" value="@mapping.Separator" @onchange="e => ReplaceMapping(current, mapping with { Separator = Text(e) })" /><select disabled="@ReadOnly" aria-label="@($"Mapping {current + 1} transform")" value="@mapping.Transform" @onchange="e => ReplaceMapping(current, mapping with { Transform = Text(e) })"><option value="">No transform</option>@Options(Catalogue.Transforms)</select><button type="button" disabled="@ReadOnly" aria-label="@($"Remove mapping {current + 1}")" @onclick="() => RemoveMapping(current)">Remove</button></div> }
    <button type="button" disabled="@ReadOnly" @onclick="AddMapping">Add mapping</button></fieldset><label>External key columns<input disabled="@ReadOnly" aria-label="External key columns" value="@string.Join(", ", Current.ExternalKeyColumns)" @onchange="ChangeExternalKeys" /></label><label>Replay policy<select disabled="@ReadOnly" aria-label="Replay policy" value="@Current.ReplayPolicy" @onchange="e => Change(Current with { ReplayPolicy = Text(e) })"><option value="append">Append</option><option value="overwrite">Overwrite</option><option value="append_dedup">Append and deduplicate</option></select></label><label>Schedule reference<select disabled="@ReadOnly" aria-label="Schedule reference" value="@Current.ScheduleReference" @onchange="e => Change(Current with { ScheduleReference = Text(e) })"><option value="">Manual only</option>@Options(Catalogue.Schedules)</select></label><fieldset><legend>Reference set deliveries</legend><input disabled="@ReadOnly" aria-label="Reference dataset" value="@Current.ReferenceDataset" @onchange="e => Change(Current with { ReferenceDataset = Text(e) })" /><input disabled="@ReadOnly" aria-label="Pack distribution" value="@Current.PackDistribution" @onchange="e => Change(Current with { PackDistribution = Text(e) })" /><input disabled="@ReadOnly" aria-label="Feed distribution" value="@Current.FeedDistribution" @onchange="e => Change(Current with { FeedDistribution = Text(e) })" /></fieldset><div><button type="button" disabled="@(!IntentsEnabled)" @onclick="Save">Save draft</button><button type="button" disabled="@(!PublishEnabled)" @onclick="Publish">Publish definition</button></div>
  @if (AuthoringRefusals.Count > 0) { <fieldset><legend>Authoring refusals</legend><ul>@foreach (var refusal in AuthoringRefusals) { <li><span>@refusal.Stage</span>: <a href="@refusal.TargetHref">@refusal.Code</a></li> }</ul></fieldset> }
  <div><button type="button" disabled="@(!IntentsEnabled)" @onclick="DryRun">Create dry run</button><button type="button" aria-label="Commit reviewed run" disabled="@(!CommitEnabled)" @onclick="Commit">Commit reviewed run</button></div>
  @if (Run is not null) { <fieldset><legend>Persisted run evidence</legend><dl><dt>Dry run</dt><dd>@Run.DryRunId</dd><dt>Commit run</dt><dd>@(Run.CommitRunId ?? "Not committed")</dd><dt>Batch identity</dt><dd>@(Run.BatchIdentity ?? "No batch identity")</dd><dt>Effect identity</dt><dd>@(Run.EffectIdentity ?? "Per effect")</dd><dt>Attempt identity</dt><dd>@(Run.AttemptId ?? "Per delivery attempt")</dd><dt>Status</dt><dd>@Run.Status</dd><dt>Staleness</dt><dd>@(Run.Stale ? "Stale" : "Current")</dd><dt>Candidate checkpoint</dt><dd>@Run.CandidateCheckpoint</dd></dl><p>Applied @Run.Census.Applied; skipped @Run.Census.Skipped; conflicted @Run.Census.Conflicted; rejected @Run.Census.Rejected; failed @Run.Census.Failed; halted @Run.Census.Halted</p><ul>@foreach (var refusal in Run.Refusals) { <li>@refusal</li> }</ul></fieldset> }
  else { <fieldset><legend>Persisted run evidence</legend><p>No dry run recorded.</p></fieldset> }
</form>

@code {
  public const string MappingProfile = "hl:tabular-mapping/v1";
  public const string MappingSchema = "https://schemas.harborline.software/mapping/tabular/v1";
  public const string MappingVersion = "1.0.0";
  [Parameter, EditorRequired] public DataExchangeAuthoringDraft Value { get; set; } = DataExchangeAuthoringDraft.Empty;
  [Parameter, EditorRequired] public DataExchangeAuthoringCatalogue Catalogue { get; set; } = new([], [], [], [], []);
  [Parameter] public DataExchangeRunSummary? Run { get; set; }
  [Parameter] public bool CanCommit { get; set; }
  [Parameter] public bool CanPublish { get; set; }
  [Parameter] public bool ReadOnly { get; set; }
  [Parameter] public IReadOnlyList<DataExchangeAuthoringRefusal> AuthoringRefusals { get; set; } = [];
  [Parameter] public EventCallback<DataExchangeAuthoringDraft> ValueChanged { get; set; }
  [Parameter] public EventCallback DiscoverSource { get; set; }
  [Parameter] public EventCallback CreateDryRun { get; set; }
  [Parameter] public EventCallback CommitReviewedRun { get; set; }
  [Parameter] public EventCallback SaveDraft { get; set; }
  [Parameter] public EventCallback PublishDefinition { get; set; }
  private DataExchangeAuthoringDraft Current = DataExchangeAuthoringDraft.Empty; private DataExchangeAuthoringDraft? _loaded; private DataExchangeAuthoringDraft? _incoming; private bool _dirty;
  private bool IntentsEnabled => !ReadOnly && _incoming is null;
  private bool CommitEnabled => IntentsEnabled && CanCommit && Run is { Stale: false, Status: "Ready" };
  private bool PublishEnabled => IntentsEnabled && CanPublish && AuthoringRefusals.Count == 0;
  // ADR 0096 pending edits: a new identity or revision never silently overwrites local edits.
  protected override void OnParametersSet()
  {
    if (ReferenceEquals(Value, _loaded)) return;
    var revisionChanged = _loaded is not null && RevisionKey(Value) != RevisionKey(_loaded);
    _loaded = Value;
    if (revisionChanged && _dirty && AuthoredContent(Value) != AuthoredContent(Current)) { _incoming = Value; return; }
    if (revisionChanged) _dirty = false;
    _incoming = null;
    Current = Value;
  }
  private static string RevisionKey(DataExchangeAuthoringDraft value) => $"{value.Identity}\u0000{value.ExpectedRevision}";
  private static string AuthoredContent(DataExchangeAuthoringDraft value) => System.Text.Json.JsonSerializer.Serialize(value with { Identity = "", ExpectedRevision = "" });
  private void KeepEdits() => _incoming = null;
  private Task DiscardEdits() { if (_incoming is null) return Task.CompletedTask; Current = _incoming; _incoming = null; _dirty = false; return ValueChanged.InvokeAsync(Current); }
  private static string Text(ChangeEventArgs args) => args.Value?.ToString() ?? "";
  private Task Change(DataExchangeAuthoringDraft draft) { if (ReadOnly) return Task.CompletedTask; Current = draft; _dirty = true; return ValueChanged.InvokeAsync(draft); }
  private Task SelectColumn(int index, bool selected) => Change(Current with { DiscoveredColumns = Current.DiscoveredColumns.Select((column, position) => position == index ? column with { Selected = selected } : column).ToArray() });
  private Task ReplaceMapping(int index, DataExchangeMappingRow mapping) => Change(Current with { Mappings = Current.Mappings.Select((current, position) => position == index ? mapping : current).ToArray() });
  private Task RemoveMapping(int index) => Change(Current with { Mappings = Current.Mappings.Where((_, position) => position != index).ToArray() });
  private Task AddMapping() => Change(Current with { Mappings = [.. Current.Mappings, new(Current.DiscoveredColumns.FirstOrDefault(column => column.Selected)?.Name ?? "", "", "", "string", false, "", "", "", "")] });
  private Task ChangeExternalKeys(ChangeEventArgs args) => Change(Current with { ExternalKeyColumns = Text(args).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) });
  private Task Discover() => IntentsEnabled ? DiscoverSource.InvokeAsync() : Task.CompletedTask;
  private Task Save() => IntentsEnabled ? SaveDraft.InvokeAsync() : Task.CompletedTask;
  private Task DryRun() => IntentsEnabled ? CreateDryRun.InvokeAsync() : Task.CompletedTask;
  private Task Commit() => CommitEnabled ? CommitReviewedRun.InvokeAsync() : Task.CompletedTask;
  private Task Publish() => PublishEnabled ? PublishDefinition.InvokeAsync() : Task.CompletedTask;
  private static void PreventSubmit() { }
  private RenderFragment SourceOptions() => Options(Current.DiscoveredColumns.Where(column => column.Selected).Select(column => new DataExchangeOption(column.Name, column.Name)).ToArray());
  private static RenderFragment Options(IReadOnlyList<DataExchangeOption> options) => builder =>
  {
    var sequence = 0;
    foreach (var option in options)
    {
      builder.OpenElement(sequence++, "option");
      builder.AddAttribute(sequence++, "value", option.Id);
      builder.AddContent(sequence++, option.Label);
      builder.CloseElement();
    }
  };
}
