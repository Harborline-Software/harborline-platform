@namespace Harborline.UIAdapters.Blazor.Components.Feedback
@inherits HarborlineComponentBase

<button @ref="trigger" id="@Context?.TriggerId" type="@Type" class="@CombineClasses("hl-popover-trigger")" style="@CombineStyles()"
        aria-haspopup="dialog" aria-expanded="@(Context?.Open == true ? "true" : "false")"
        aria-controls="@(Context?.Open == true ? Context.ContentId : null)" disabled="@Disabled"
        @onclick="ToggleAsync" @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [CascadingParameter] public PopoverContext? Context { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    private ElementReference trigger;
    protected override void OnAfterRender(bool firstRender) { if (Context is not null) Context.TriggerElement = trigger; }
    private Task ToggleAsync() => Context is null || Disabled ? Task.CompletedTask : Context.SetOpenAsync(!Context.Open);
}
