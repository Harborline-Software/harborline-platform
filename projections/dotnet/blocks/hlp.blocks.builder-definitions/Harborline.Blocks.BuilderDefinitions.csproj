<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <HarborlinePublicDistributionAuthorized>false</HarborlinePublicDistributionAuthorized>
    <PackageId>Harborline.Blocks.BuilderDefinitions</PackageId>
    <AssemblyName>Harborline.Blocks.BuilderDefinitions</AssemblyName>
    <RootNamespace>Harborline.Blocks.BuilderDefinitions</RootNamespace>
    <Description>Shared definition catalogue substrate, including deterministic platform package export, empty-store replay, and raise-only safety-floor reattachment.</Description>
    <PackageTags>harborline;forms;workflows;builder;definitions;archive;package;seed</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Internal-only projection; public distribution is not authorized.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../foundation/hlp.foundation.rule-authoring/Harborline.Foundation.RuleAuthoring.csproj" />
    <EmbeddedResource Include="../../../../_shared/layout/placement.schema.json" LogicalName="Harborline.Layout.PlacementSchema" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="../../../../_shared/packs/platform/platform-pack.export.json" LogicalName="Harborline.Blocks.BuilderDefinitions.platform-pack.export.json" />
    <None Include="../../../../_shared/packs/platform/platform-pack.export.json" Pack="true" PackagePath="_shared/packs/platform/" />
    <None Include="../../../../LICENSE" Link="LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
