<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <HarborlinePublicDistributionAuthorized>false</HarborlinePublicDistributionAuthorized>
    <PackageId>Harborline.Foundation.ExecutionRuntime</PackageId>
    <AssemblyName>Harborline.Foundation.ExecutionRuntime</AssemblyName>
    <RootNamespace>Harborline.Foundation.ExecutionRuntime</RootNamespace>
    <Description>The execution runtime substrate for Harborline Platform: run identity, status, retry, dead-letter, and durable non-secret effect receipts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Internal-only projection; public distribution is not authorized.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../contracts/hlp.contracts.identities/Harborline.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../../LICENSE" Link="LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
