<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <HarborlinePublicDistributionAuthorized>false</HarborlinePublicDistributionAuthorized>
    <PackageId>Harborline.Foundation.Scheduling</PackageId>
    <AssemblyName>Harborline.Foundation.Scheduling</AssemblyName>
    <RootNamespace>Harborline.Foundation.Scheduling</RootNamespace>
    <Description>Bounded RRULE expansion and shared wall-clock conversion for Harborline Platform.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Internal-only projection; public distribution is not authorized.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Foundation.Scheduling.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-0122: RRULE expansion runs on Ical.Net behind IRruleExpansionService; NodaTime is its zone engine and the
         wall-clock resolver's (ADR-0123 decision 4). Justification R-0146 call 5. -->
    <PackageReference Include="Ical.Net" />
    <PackageReference Include="NodaTime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../../LICENSE" Link="LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
