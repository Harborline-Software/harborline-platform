<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <HarborlinePublicDistributionAuthorized>false</HarborlinePublicDistributionAuthorized>
    <PackageId>Harborline.Foundation.RuleAuthoring</PackageId>
    <AssemblyName>Harborline.Foundation.RuleAuthoring</AssemblyName>
    <RootNamespace>Harborline.Foundation.RuleAuthoring</RootNamespace>
    <Description>Typed Rules source, strict codecs, full compiler intent diagnostics, advisory lint, seeds and preview. The shared .NET definition store owns publication; this package contains no persistence implementation.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Internal-only projection; public distribution is not authorized.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Foundation.RuleAuthoring.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../hlp.foundation.rule-runtime/Harborline.Foundation.RuleEngine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../../LICENSE" Link="LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
