{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "vitest": ["../hlp.ui.button/node_modules/vitest/dist/index.d.ts"]
    },
    "typeRoots": ["../hlp.ui.button/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["dist"]
}
