    {
      "id": "chart.line-series",
      "name": "Line series and missing values",
      "surface": "line-series",
      "sourceCaseIds": [
        "chart.line-single",
        "chart.line-multiple",
        "chart.line-null-gap",
        "chart.visibility-defaults"
      ],
      "sourceQualityCaseIds": [
        "chart.quality.name-summary",
        "chart.quality.contrast"
      ],
      "content": {
        "blurb": "Ordered categories and series retain missing values without substituting zero.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {
          "definition": {
            "kind": "line",
            "accessibleName": "Monthly occupancy trend",
            "title": "Monthly occupancy",
            "categories": [
              "January",
              "February",
              "March",
              "April",
              "May",
              "June"
            ],
            "series": [
              {
                "name": "North Pier",
                "values": [
                  91,
                  92,
                  null,
                  94,
                  95,
                  96
                ]
              },
              {
                "name": "South Pier",
                "values": [
                  84,
                  86,
                  88,
                  87,
                  90,
                  92
                ]
              }
            ],
            "motion": "host"
          }
        },
        "state": {},
        "body": [
          {
            "control": "raw",
            "react": "<Chart definition={{ ...occupancy, motion: 'host' }} />",
            "blazor": "<HarborlineChart Definition=\"@Definition\" AccessibleName=\"@AccessibleName\" Title=\"@ChartTitle\" DataSummaryLabel=\"@DataSummaryLabel\" ShowLegend=\"@ShowLegend\" ShowTooltip=\"@ShowTooltip\" Motion=\"@Motion\" />",
            "rationale": "The closed control vocabulary has no chart control and cannot express the rendered chart graphics, legend, tooltip, or generated accessible data table."
          }
        ],
        "footer": []
      }
    },
    {
