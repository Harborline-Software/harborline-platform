        "body": [
          {
            "control": "raw",
            "react": "<Chart definition={definition} /> where title is 'Structural sensor history · 256 samples', accessibleName is 'Hourly structural sensor history', categories are Array.from({ length: 256 }, (_, index) => `Sample ${index + 1}`), and series are Displacement, Vibration, Temperature, and Humidity with the formulas in Chart.stories.tsx lines 105-108.",
            "blazor": "<HarborlineChart Definition=\"@Definition\" AccessibleName=\"@AccessibleName\" Title=\"@ChartTitle\" DataSummaryLabel=\"@DataSummaryLabel\" ShowLegend=\"@ShowLegend\" ShowTooltip=\"@ShowTooltip\" Motion=\"@Motion\" /> where LargeDefinition uses Enumerable.Range(1, 256) and the four formulas in ChartScenario.razor lines 145-152.",
