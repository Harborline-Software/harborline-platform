    {
      "id": "chart.empty",
      "name": "Empty series and slices",
      "surface": "empty",
      "sourceCaseIds": [
        "chart.empty-series"
      ],
      "sourceQualityCaseIds": [
        "chart.quality.contrast",
        "chart.quality.visual-parity"
      ],
      "content": {
        "blurb": "A definition with nothing to plot says so instead of drawing axes over no data.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {
          "definition": {
            "kind": "line",
            "accessibleName": "Monthly occupancy trend",
            "title": "Monthly occupancy",
            "categories": [],
            "series": []
          },
          "empty": "No occupancy has been recorded for this period yet."
        },
        "state": {},
        "body": [
          {
            "control": "raw",
            "react": "<Chart definition={emptyOccupancy} empty=\"No occupancy has been recorded for this period yet.\" />",
            "blazor": "<HarborlineChart Definition=\"@Definition\" AccessibleName=\"@AccessibleName\" Title=\"@ChartTitle\" Empty=\"@EmptyText\" ShowLegend=\"@ShowLegend\" ShowTooltip=\"@ShowTooltip\" Motion=\"@Motion\" />",
            "rationale": "The closed control vocabulary has no chart control and cannot express the empty state a chart owes when its series carry no plottable value."
          }
        ],
        "footer": []
      }
    },
    {
      "id": "chart.validation",
      "name": "Validation and provider boundary",
      "surface": "validation",
      "sourceCaseIds": [
        "chart.line-count-mismatch",
        "chart.labels-and-values",
        "chart.provider-isolation"
      ],
      "sourceQualityCaseIds": [
        "chart.quality.tokens"
      ],
      "content": {
        "blurb": "Stable errors protect the neutral definition from renderer-specific options.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {},
        "state": {},
        "body": [
          {
            "control": "raw",
            "react": "<div style={{ display: 'grid', gap: 16, gridTemplateColumns: 'minmax(0, 1.4fr) minmax(15rem, 1fr)' }}><Chart definition={occupancy} /><aside aria-label=\"Chart validation boundary\"><h3>Neutral validation</h3><dl>{errors.map(([code, meaning]) => <div key={code}><dt><code>{code}</code></dt><dd>{meaning}</dd></div>)}</dl><p>Renderer options and provider identities remain private to each projection.</p></aside></div>",
            "blazor": "<div style=\"display:grid;gap:16px;grid-template-columns:minmax(0, 1.4fr) minmax(15rem, 1fr)\"><HarborlineChart Definition=\"@Occupancy\" AccessibleName=\"Monthly occupancy trend\" Title=\"Monthly occupancy\" /><aside aria-label=\"Chart validation boundary\"><h3>Neutral validation</h3><dl>@foreach (var error in ValidationErrors) { <div><dt><code>@error.Code</code></dt><dd>@error.Meaning</dd></div> }</dl><p>Renderer options and provider identities remain private to each projection.</p></aside></div>",
            "rationale": "The chart plus aside, heading, description list, code terms, and responsive grid require controls and layout primitives outside the closed vocabulary. The lane error collections supply category-value-count-mismatch — Each line series has one value per category.; duplicate-series-name — Line series names are unique.; label-required — Series and slice labels are nonblank.; non-finite-value — Values are finite numbers or null."
          }
        ],
        "footer": []
      }
    },
    {
      "id": "chart.replacement",
      "name": "Replacement and visibility intent",
      "surface": "replacement",
      "interaction": "pointer",
      "sourceCaseIds": [
        "chart.replace-not-merge",
        "chart.visibility-defaults"
      ],
      "sourceQualityCaseIds": [
        "chart.quality.runtime-switch"
      ],
      "content": {
        "blurb": "Complete updates remove stale data while legend and tooltip intent remain explicit.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {},
        "state": {},
        "body": [
          {
            "control": "button",
            "text": "Original definition"
          },
          {
            "control": "button",
            "text": "Replace definition"
          },
          {
            "control": "raw",
            "react": "<Chart definition={updated ? replacement : occupancy} />",
            "blazor": "<HarborlineChart Definition=\"@(replacementShown ? Replacement : Occupancy)\" AccessibleName=\"@(replacementShown ? \"Quarterly inspection completion\" : \"Monthly occupancy trend\")\" Title=\"@(replacementShown ? \"Inspection completion\" : \"Monthly occupancy\")\" ShowLegend=\"@(!replacementShown)\" ShowTooltip=\"@(!replacementShown)\" />",
            "rationale": "The buttons are expressible, but their stateful selection between complete chart definitions and the resulting chart rendering cannot be represented by the closed controls without silently approximating the lane behavior. The original chart shows Monthly occupancy trend, Monthly occupancy, January through June, North Pier, and South Pier; the replacement shows Quarterly inspection completion, Inspection completion, Q3, and Completed."
          }
        ],
        "footer": []
      }
    },
