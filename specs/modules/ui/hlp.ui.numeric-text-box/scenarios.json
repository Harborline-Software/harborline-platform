        "numeric-text-box.enter-commit",
        "numeric-text-box.empty-invalid-commit",
        "numeric-text-box.focus-blur-order"
      ],
      "content": {
        "blurb": "Focus reveals the raw value; Enter or blur strictly parses and commits once.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {},
        "state": {
          "requests": {
            "kind": "array",
            "initial": []
          }
        },
        "body": [
          {
            "control": "raw",
            "react": "<LabeledValue label=\"Replacement cost\" note=\"Focus to edit; press Enter or move focus to commit.\"><NumericTextBox aria-label=\"Replacement cost\" currency=\"USD\" format=\"c2\" min={0} onChange={requestValue} step={1} value={1234.5} /></LabeledValue>",
            "blazor": "<LabeledNumericValue Label=\"Replacement cost\" Note=\"Focus to edit; press Enter or move focus to commit.\"><HarborlineNumericTextBox AccessibleLabel=\"Replacement cost\" Currency=\"USD\" Format=\"c2\" Min=\"0\" Step=\"1\" Value=\"1234.5\" ValueChanged=\"RequestValue\" /></LabeledNumericValue>",
            "rationale": "The visible note is rendered by LabeledValue/LabeledNumericValue as a small element, which is not in the closed descriptor vocabulary."
          },
          {
            "control": "output",
            "live": "polite",
            "text": "Requests: none"
          }
        ],
        "footer": []
      }
    },
