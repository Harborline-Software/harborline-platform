    {
      "id": "numeric-text-box.editing-commit",
      "name": "Editing and commit order",
      "surface": "editing-commit",
      "interaction": "keyboard-pointer",
      "sourceCaseIds": [
        "numeric-text-box.focus-raw",
        "numeric-text-box.typing-buffer",
