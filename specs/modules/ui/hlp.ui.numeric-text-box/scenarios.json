      "content": {
        "blurb": "Caller state remains authoritative across requests and complete value replacement.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {},
        "state": {
          "requests": {
            "kind": "array",
            "initial": []
          },
          "value": {
            "kind": "counter",
            "initial": 1234.5
          }
        },
        "body": [
          {
            "control": "raw",
            "react": "<LabeledValue label=\"Caller-owned replacement cost\" note=\"Requests are logged without changing the controlled value.\"><NumericTextBox aria-label=\"Replacement cost\" currency=\"USD\" format=\"c2\" min={0} onChange={requestValue} step={1} value={value} /></LabeledValue>",
            "blazor": "<LabeledNumericValue Label=\"Caller-owned replacement cost\" Note=\"Requests are logged without changing the controlled value.\"><HarborlineNumericTextBox AccessibleLabel=\"Replacement cost\" Currency=\"USD\" Format=\"c2\" Min=\"0\" Step=\"1\" Value=\"@value\" ValueChanged=\"RequestValue\" /></LabeledNumericValue>",
            "rationale": "The visible note is rendered by LabeledValue/LabeledNumericValue as a small element, which is not in the closed descriptor vocabulary."
          },
          {
            "control": "output",
            "live": "polite",
            "text": "Requests: none"
          },
          {
            "control": "button",
            "text": "Replace caller value"
          }
        ],
        "footer": []
