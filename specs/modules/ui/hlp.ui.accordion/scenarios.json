            "react": "<Accordion items={[{value:'review',title:'Awaiting third-party structural certification review',children:'Review queue'},{value:'count',title:'1,284,905',children:'Record count'},{value:'grid',title:'Bay 4 <grid C-7> & 8',children:'Survey location'},{value:'name',title:'Ordnance Survey — Niño Ångström',children:'Survey provider'}]} type=\"multiple\" defaultValue={['review','count','grid','name']}/>",
            "blazor": "<HarborlineAccordion Items=\"@(new[] { new HarborlineAccordionItem(\"review\", b => b.AddContent(0, \"Awaiting third-party structural certification review\"), b => b.AddContent(0, \"Review queue\")), new HarborlineAccordionItem(\"count\", b => b.AddContent(0, \"1,284,905\"), b => b.AddContent(0, \"Record count\")), new HarborlineAccordionItem(\"grid\", b => b.AddContent(0, \"Bay 4 <grid C-7> & 8\"), b => b.AddContent(0, \"Survey location\")), new HarborlineAccordionItem(\"name\", b => b.AddContent(0, \"Ordnance Survey — Niño Ångström\"), b => b.AddContent(0, \"Survey provider\")) })\" Mode=\"AccordionMode.Multiple\" DefaultExpandedValues=\"@(new[] { \"review\", \"count\", \"grid\", \"name\" })\"/>",
