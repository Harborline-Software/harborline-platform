        "blurb": "Carries a long certification label, the grouped value 1,284,905, escaped Bay 4 <grid C-7> & 8 copy, and the name Ordnance Survey — Niño Ångström.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {},
        "state": {},
        "body": [
          {
            "control": "raw",
            "react": "<><FormField name=\"certification-date\" label={'Awaiting third-party structural certification review'} hint={'1,284,905'}><DateField name=\"certification-date\" value=\"2026-08-09\" onChange={()=>{}} /></FormField><FormField name=\"survey-date\" label={'Ordnance Survey — Niño Ångström'} error={'Bay 4 <grid C-7> & 8'}><DateField name=\"survey-date\" value=\"2026-09-09\" onChange={()=>{}} /></FormField></>",
            "blazor": "<HarborlineFormField Name=\"certification-date\" Label=\"@(\"Awaiting third-party structural certification review\")\" Hint=\"@(\"1,284,905\")\"><HarborlineDateField Name=\"certification-date\" Value=\"2026-08-09\" /></HarborlineFormField><HarborlineFormField Name=\"survey-date\" Label=\"@(\"Ordnance Survey — Niño Ångström\")\" Error=\"@(\"Bay 4 <grid C-7> & 8\")\"><HarborlineDateField Name=\"survey-date\" Value=\"2026-09-09\" /></HarborlineFormField>",
            "rationale": "The closed control vocabulary cannot express FormField-wrapped DateField controls with hostile-but-valid labels, hints, and errors."
          }
        ],
        "footer": []
