        "body": [
          {
            "control": "raw",
            "react": "const groups = [{items:[{id:'long',label:'Awaiting third-party structural certification review',onSelect(){}},{id:'number',label:'1,284,905',onSelect(){}},{id:'hostile',label:'Bay 4 <grid C-7> & 8',onSelect(){}},{id:'name',label:'Ordnance Survey — Niño Ångström',onSelect(){}}]}];\n<ContextMenu groups={groups} accessibleLabel=\"Content resilience actions\" locale=\"en-US\" direction=\"ltr\" className=\"hl-gallery-menu-trigger\"><div data-context-trigger tabIndex={0} className=\"hl-gallery-record\"><strong>{'Awaiting third-party structural certification review'}</strong><span>{'1,284,905'}</span><span>{'Bay 4 <grid C-7> & 8'}</span><span>{'Ordnance Survey — Niño Ångström'}</span></div></ContextMenu>",
            "blazor": "<HarborlineContextMenu Groups=\"ContentGroups\" AccessibleLabel=\"Content resilience actions\" Locale=\"en-US\" Direction=\"ltr\" Class=\"hl-gallery-menu-trigger\"><div data-context-trigger tabindex=\"0\" class=\"hl-gallery-record\"><strong>@(\"Awaiting third-party structural certification review\")</strong><span>@(\"1,284,905\")</span><span>@(\"Bay 4 <grid C-7> & 8\")</span><span>@(\"Ordnance Survey — Niño Ångström\")</span></div></HarborlineContextMenu>\n@code { private IReadOnlyList<ContextMenuGroup> ContentGroups => [new ContextMenuGroup([new ContextMenuItem(\"long\", \"Awaiting third-party structural certification review\"), new ContextMenuItem(\"number\", \"1,284,905\"), new ContextMenuItem(\"hostile\", \"Bay 4 <grid C-7> & 8\"), new ContextMenuItem(\"name\", \"Ordnance Survey — Niño Ångström\")])]; }",
