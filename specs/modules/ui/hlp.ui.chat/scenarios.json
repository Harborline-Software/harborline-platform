      "content": {
        "blurb": "Two hundred fifty-six ordered messages exercise the Tier-C structural boundary inside one scroll owner.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {
          "user": {
            "name": "Casey Morgan"
          },
          "showAvatar": false,
          "messageCount": 256,
          "hostAttributes": {
            "data-gallery-message-count": "256"
          }
        },
        "state": {},
        "body": [
          {
            "control": "raw",
            "react": "Array.from({ length: 256 }, (_, index) => ({ id: `load-message-${index + 1}`, author: index % 2 === 0 ? currentUser : assistant, role: index % 2 === 0 ? 'user' : 'assistant', text: `Inspection message ${index + 1}: structure grid ${String.fromCharCode(65 + (index % 8))}-${(index % 12) + 1}.`, status: 'complete' }))",
            "blazor": "Enumerable.Range(0, 256).Select(index => new ChatMessage($\"load-message-{index + 1}\", index % 2 == 0 ? CurrentUser : Assistant, index % 2 == 0 ? ChatMessageRole.User : ChatMessageRole.Assistant, $\"Inspection message {index + 1}: structure grid {(char)('A' + index % 8)}-{index % 12 + 1}.\", ChatMessageStatus.Complete)).ToArray()",
            "rationale": "The generated messages require modulo arithmetic, character generation, alternating participant objects, and alternating message roles; repeat descriptors can interpolate only n and cannot express those computations."
          }
        ],
        "footer": []
      }
