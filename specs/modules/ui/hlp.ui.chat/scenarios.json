      "content": {
        "blurb": "Ordered roles, bounded custom content, hidden avatars, and host-owned fill height match the Harborline Copilot surface.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {
          "messages": [
            {
              "id": "capture-request",
              "author": {
                "name": "Casey Morgan"
              },
              "role": "user",
              "text": "Place the west-wall capture on the Level 2 blueprint.",
              "status": "complete",
              "timestamp": "2026-01-02T15:02:00Z"
            },
            {
              "id": "capture-result",
              "author": {
                "name": "Harborline Copilot"
              },
              "role": "assistant",
              "text": "The pose aligns with grid C-7. I found one clearance conflict near the service chase.",
              "status": "complete",
              "timestamp": "2026-01-02T15:04:05Z"
            },
            {
              "id": "review-state",
              "author": {
                "name": "Inspection workflow"
              },
              "role": "system",
              "text": "Placement evidence is ready for review.",
              "status": "complete"
            }
          ],
          "user": {
            "name": "Casey Morgan"
          },
          "showAvatar": false,
          "hostAttributes": {
            "data-owner": "app"
          }
        },
        "state": {},
        "body": [
          {
            "control": "raw",
            "react": "<div><strong>{message.status === 'error' ? 'Needs attention' : 'Spatial evidence'}</strong><p style={{ margin: '0.25rem 0 0' }}>{message.text}</p></div>",
            "blazor": "builder.OpenElement(0, \"div\"); builder.OpenElement(1, \"strong\"); builder.AddContent(2, message.Status == ChatMessageStatus.Error ? \"Needs attention\" : \"Spatial evidence\"); builder.CloseElement(); builder.OpenElement(3, \"p\"); builder.AddContent(5, message.Text); builder.CloseElement(); builder.CloseElement();",
            "rationale": "The message-content slot requires a div and paragraph plus per-message conditional and message-text bindings; div and paragraph are outside the closed descriptor vocabulary and the bindings are not scenario state."
          }
        ],
        "footer": []
