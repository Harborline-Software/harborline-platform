      "content": {
        "blurb": "Ordered work, progress, and finish-to-start dependencies remain available without editing controls.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {
          "accessibleName": "Structure work schedule",
          "className": "engineering-schedule",
          "data-owner": "engineering-services",
          "rowHeight": 36,
          "showZoomPicker": false,
          "zoom": "month",
          "tasks": [
            {
              "id": "survey",
              "title": "Survey structure",
              "start": "2026-08-11",
              "end": "2026-08-12",
              "progress": 100,
              "color": "var(--hl-color-success)"
            },
            {
              "id": "capture",
              "title": "Capture photo with pose",
              "start": "2026-08-13",
              "end": "2026-08-15",
              "progress": 45,
              "color": "var(--hl-color-info)"
            },
            {
              "id": "place",
              "title": "Place capture in blueprint",
              "start": "2026-08-16",
              "end": "2026-08-19",
              "progress": 10,
              "color": "var(--hl-color-warning)"
            }
          ],
          "dependencies": [
            {
              "fromId": "survey",
              "toId": "capture"
            },
            {
              "fromId": "capture",
              "toId": "place"
            }
          ]
        },
        "state": {},
        "body": [
          {
            "control": "raw",
            "react": "<Gantt accessibleName={isArabic ? 'الجدول الزمني للعمل' : isPseudo ? pseudoCatalog['gantt.title'] : 'Structure work schedule'} className=\"engineering-schedule\" columns={columns} data-owner=\"engineering-services\" dependencies={dependencies} empty={isEmpty ? 'No scheduled structure work.' : undefined} onZoomChange={isZoom ? setRequestedZoom : undefined} rowHeight={isPseudo ? 44 : 36} showZoomPicker={isZoom || isPseudo} tasks={tasks} zoom={isZoom ? 'day' : scenarioId === 'gantt.locale-fr' ? 'week' : 'month'} />",
            "blazor": "<HarborlineGantt AccessibleLabel=\"@AccessibleLabel\" Class=\"engineering-schedule\" Columns=\"@Columns\" data-owner=\"engineering-services\" Dependencies=\"@Dependencies\" Empty=\"@Empty\" RowHeight=\"@RowHeight\" ShowZoomPicker=\"@ShowZoomPicker\" Tasks=\"@Tasks\" Zoom=\"@Zoom\" ZoomChanged=\"HandleZoomChanged\" />",
            "rationale": "The closed vocabulary has no Gantt control and cannot express the named task grid, timeline bars, progress semantics, dependency connectors, or read-only keyboard behavior."
          }
        ],
        "footer": []
      }
    },
