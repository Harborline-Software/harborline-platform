      "content": {
        "blurb": "The picker requests a scale while the supplied scale and keyboard-reachable task grid remain authoritative.",
        "environment": {
          "locale": "en-US",
          "direction": "ltr",
          "theme": "light",
          "catalog": {}
        },
        "props": {
          "accessibleName": "Structure work schedule",
          "className": "engineering-schedule",
          "data-owner": "engineering-services",
          "rowHeight": 36,
          "showZoomPicker": true,
          "zoom": "day",
          "tasks": [
            {
              "id": "survey",
              "title": "Survey structure",
              "start": "2026-08-11",
              "end": "2026-08-12",
              "progress": 100,
              "color": "var(--hl-color-success)"
            },
            {
              "id": "capture",
              "title": "Capture photo with pose",
              "start": "2026-08-13",
              "end": "2026-08-15",
              "progress": 45,
              "color": "var(--hl-color-info)"
            },
            {
              "id": "place",
              "title": "Place capture in blueprint",
              "start": "2026-08-16",
              "end": "2026-08-19",
              "progress": 10,
              "color": "var(--hl-color-warning)"
            }
          ],
          "dependencies": [
            {
              "fromId": "survey",
              "toId": "capture"
            },
            {
              "fromId": "capture",
              "toId": "place"
            }
          ]
        },
        "state": {
          "requestedZoom": {
            "kind": "string",
            "initial": ""
          }
        },
        "body": [
          {
            "control": "raw",
            "react": "<><Gantt ... onZoomChange={setRequestedZoom} showZoomPicker tasks={tasks} zoom=\"day\" /><output aria-live=\"polite\">{requestedZoom ? `Requested ${requestedZoom}; supplied zoom remains day.` : 'Choose a scale to request a controlled zoom change.'}</output></>",
            "blazor": "<><HarborlineGantt ... ShowZoomPicker=\"@ShowZoomPicker\" Tasks=\"@Tasks\" Zoom=\"@Zoom\" ZoomChanged=\"HandleZoomChanged\" /><output aria-live=\"polite\">@(requestedZoom is GanttZoom requested ? $\"Requested {requested.ToString().ToLowerInvariant()}; supplied zoom remains day.\" : \"Choose a scale to request a controlled zoom change.\")</output></>",
            "rationale": "The closed vocabulary cannot express the Gantt zoom picker, its controlled callback without changing the supplied day scale, the resulting conditional live output, or the grid's roving keyboard navigation."
          }
        ],
        "footer": []
