          "dependencies": []
        },
        "state": {},
        "body": [
          {
            "control": "raw",
            "react": "<><Gantt ... dependencies={[]} tasks={[{ id: 'revision-96', title: 'Latest replacement only', start: '2026-08-19', end: '2026-08-20', progress: 96 }]} zoom=\"month\" /><p role=\"status\">Revision 96 is current. Earlier rows and connectors have been removed.</p></>",
