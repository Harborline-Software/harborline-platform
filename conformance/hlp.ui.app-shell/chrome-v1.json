  "chordScope": {
    "$comment": "chrome-spec.md §6:180-186 — the affordance group is the SHELL's, and it lives in the header; the body is the design. The pop-out chord is therefore the header's route, not the panel root's, in both shells, and the browser default for it is suppressed in both (React event.preventDefault, Blazor dock-divider.js observePanelChord).",
    "panelId": "documents",
    "rows": [
