        "from": "header",
        "key": "Enter",
        "shiftKey": true,
        "expectedRequests": 1,
        "expectedDefaultPrevented": true
      },
      {
        "from": "body",
        "key": "Enter",
        "shiftKey": true,
        "expectedRequests": 0,
        "expectedDefaultPrevented": false
      }
    ]
  },
