{
  "schemaVersion": 1,
  "moduleId": "hlp.ui.detail-panel",
  "fixtureRevision": 1,
  "authority": {
    "facetsAreTabs": "drilldown-model.md:18 — Facets are tabs, not depth. Details, Attachments, History, Related are the same object seen differently, side by side with counts.",
    "countsFromTheQuery": "drilldown-model.md:44 — Counts come from the same query as the tab, or the tab lies.",
    "declaredPerObject": "drilldown-model.md:41 — Facet availability is declared per object type; a facet that isn't declared isn't shown, not shown empty.",
    "onePush": "drilldown-model.md:22 — Crossing to a different object pushes exactly once; a back row naming what you came from; that is the only stack level.",
    "depthThreePromotes": "drilldown-model.md:23 — From a pushed panel the only way further is Open as page, a real route with its own inspector.",
    "oneComponent": "drilldown-model.md:36 — Same header shape, same tab bar, same footer action row, whatever object it holds.",
    "addressing": "drilldown-model.md:27 — Selection is in the URL by identity, never by label or row index.",
    "subsectionsNotVerbs": "disclosure-model.md:14 — Subsections never go in the overflow menu; a subsection is a place, it must be linkable and show a count.",
    "absenceOverDisabled": "chrome-spec.md §9 — A capability that is not available is absent, not greyed; the surface states how to go onward at the point of work."
  },
