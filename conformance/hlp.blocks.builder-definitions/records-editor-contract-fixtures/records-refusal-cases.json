  "cases": [
    {
      "id": "R1-punctuation-name",
      "operation": "CreateDraftAsync",
      "requestId": "create",
      "createRequestFrom": "G1-asset-class",
      "replace": {
        "name": " -- "
      },
      "preconditions": [],
      "expected": {
        "outcome": "refused",
        "stage": "Author",
        "refusals": [
          {
            "code": "records.identity.name_required",
            "pointer": "/name"
          }
        ]
      },
      "aggregation": "Single. Mint throws before materialization or compile (RecordsCatalogueIdentity.cs:18-24; RecordTypeDefinitionStore.cs:117).",
      "postcondition": "ListKeysAsync(tenant-a, Records) is empty",
      "source": [
        "RecordTypeDefinitionStoreTests.cs:92-108 (InlineData line 97)",
        "platform/projections/dotnet/blocks/hlp.blocks.builder-definitions/RecordsCatalogueIdentity.cs:18-24,105"
      ],
      "stageSource": "Mint raises DefinitionAdmissionPhase.Author (RecordsCatalogueIdentity.cs:22). This test does not assert the stage."
    },
    {
      "id": "R2-zero-revision-collision",
      "operation": "CreateDraftAsync",
      "preconditions": [
        {
          "operation": "CreateDraftAsync",
          "requestId": "eam",
          "createRequestFrom": "G1-asset-class",
          "replace": {},
          "expectedRevision": 1
        }
      ],
      "requestId": "again-asset-class",
      "createRequestFrom": "G1-asset-class",
      "replace": {
        "name": "asset-class"
      },
      "alsoEquivalentNames": [
        "Asset Class",
        "  ASSET  class "
      ],
      "alsoEquivalentRequestIdPattern": "\"again-\" + name",
      "expected": {
        "outcome": "refused",
        "stage": "Author",
        "refusals": [
          {
            "code": "records.identity.record_type_id_collision",
            "pointer": "/record_type_id"
          }
        ]
      },
      "mechanism": "SaveDraftAsync at expected revision 0 returns definition.revision_conflict, which is mapped to the collision (RecordsCatalogueIdentity.cs:31-43)",
      "postcondition": "ListHistoryAsync(eam.asset-class) has exactly 1 revision. Replaying requestId \"eam\" with the original request returns revision 1 and is not a collision.",
      "source": [
        "RecordTypeDefinitionStoreTests.cs:64-90"
      ]
    },
