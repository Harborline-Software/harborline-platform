<?xml version="1.0" encoding="utf-8"?>
<!-- Portable by construction (ticket 262): no absolute path, no drive letter, no user profile.
     #51 (ticket 226) declared one developer's global packages folder BOTH as a package source and
     as a globalPackagesFolder pin, plus the Visual Studio offline feed by absolute path; all three
     made this file unusable on any other machine. tooling/tests/nuget-config-portability.test.mjs
     now fails on any of those shapes in any tracked NuGet.Config in this repository.

     nuget.org is the only source here, deliberately. Every project this file governs
     (projections/dotnet/**, projections/blazor/**, gallery/tests, tests/**) reaches first-party
     code by ProjectReference, never by PackageReference. The two places that DO restore
     Harborline.* packages bring their own source and are unaffected by this file:
       - gallery/projections/blazor/nuget.config declares the repo-relative packed feed
         artifacts/packages/nuget (with its own <clear/>);
       - the disposable package consumers under tests/package-consumers/** are restored by
         tooling/verify-package-fixtures.mjs with an explicit source argument at that same feed.
     Declaring that feed here as well was tried and rejected: on a fresh clone the directory does
     not exist and NuGet fails the restore outright with NU1301 ("The local source ... doesn't
     exist"), and it cannot be tracked into existence because verify-package-fixtures.mjs deletes
     and recreates artifacts/ on every run. `node tooling/fill-local-feed.mjs` fills that feed for
     the gallery without re-packing from source.

     <clear/> keeps machine-level and parent-directory sources out so the set stays exactly
     nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
