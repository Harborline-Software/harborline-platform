#!/bin/sh
# Vendored from the migration control plane's tooling/hooks/pre-commit (2026-08-20).
#
# The original dispatched on `git config --local harborline.writerRepository` because ONE hook
# directory in the migration control plane served two repositories. This copy lives inside the repository
# it gates, so there is nothing to dispatch on: the branch is collapsed to a single call.
#
# Why this moved at all: harborline-platform's core.hooksPath pointed into the migration control plane,
# which has no remote and is being deleted. Git SKIPS a missing hooksPath WITHOUT ERROR, so that
# deletion would have disabled this gate silently rather than loudly.
set -eu
hook_root=$(git rev-parse --show-toplevel)
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
node "$hook_dir/../tooling/gates/scan-prop-vocabulary.mjs" "$hook_root"
# T-674. docs/evidence/phase-4/gate.json must name a run every clone of main can produce. T-568
# committed one naming its own lane branch's HEAD; the squash merge discarded that commit and the
# gate's release-receipt step then refused the evidence weeks later, on whichever runner's reused
# clone no longer held the object. This is the same refusal at the commit that writes it. Note that
# git skips a hook directory core.hooksPath does not point at, WITHOUT ERROR (see above), so this
# call is the cheap first answer and not the enforcing one: verify.yml runs the same scanner on
# every pull request and merge group, where it cannot be skipped.
node "$hook_dir/../tooling/gates/scan-evidence-provenance.mjs" "$hook_root"
